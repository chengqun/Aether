<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             xmlns:ctl="using:Acme.Desktop.Shared.Shell.Controls"
             x:Class="Acme.Desktop.Shared.Shell.KnowledgeEditView"
             Classes="form-fields">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" IsVisible="{Binding HasError}"/>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="2" Margin="10,6">

        <!-- 名称（笔记标题）——核心字段，始终显示（不折叠） -->
        <StackPanel Spacing="2">
          <TextBlock Text="名称（笔记标题）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBox Text="{Binding Name}" PlaceholderText="如 ExternalIntelTable / 崇齐网络案"/>
        </StackPanel>

        <!-- 配置区（kind + links）折叠为单行「⚙ 配置 + 摘要」，点击展开细节——默认收起不占面积 -->
        <Expander IsExpanded="False" Margin="0,6,0,0">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="⚙ 配置" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding ConfigSummary}" FontSize="11" Margin="10,0,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="kind（分类）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Kind}" PlaceholderText="如 Entity / Rule / 情报案件"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="+ 新增引用" Command="{Binding AddLinkCommand}" Padding="12,4"/>
              <Button Click="OnViewGraphClick" Classes="tool" Padding="12,4">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Data="{x:Static shell:Codicons.Graph}" Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                  <TextBlock Text="查看图" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Links}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,2*,Auto,Auto" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Text="{Binding Role}" PlaceholderText="role（uses/then/applies-to/produces…）" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Margin="0,0,4,0" Click="OnPickTarget"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      <TextBlock Text="{Binding SelectedTarget.Title, FallbackValue=选择目标…}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button Grid.Column="2" Classes="tool" Padding="8,4" Margin="0,0,4,0"
                            Command="{Binding $parent[ItemsControl].DataContext.JumpToTargetCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="跳转到目标笔记">
                      <Path Data="{x:Static shell:Codicons.ArrowRight}" Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding $parent[ItemsControl].DataContext.RemoveLinkCommand}"
                            CommandParameter="{Binding}" Padding="8,4"><Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <ctl:SelectableMarkdownViewer Markdown="{Binding Body}"
                                      NoteNavigateCommand="{Binding NoteNavigateCommand}"
                                      MinHeight="200" Margin="0,2"/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
