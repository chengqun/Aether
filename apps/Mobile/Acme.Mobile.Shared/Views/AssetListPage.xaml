<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage Shell.TabBarIsVisible="False"
    x:Class="Acme.Mobile.Shared.Views.AssetListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:model="clr-namespace:Acme.Mobile.Mvvm.Models;assembly=Acme.Mobile.Mvvm"
    x:DataType="vm:AssetListViewModel"
    Title="{Binding Title, FallbackValue='资产'}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部：状态 + 新建按钮 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,12" ColumnSpacing="12">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding StatusMessage}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       IsVisible="{Binding StatusMessage}" />
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{DynamicResource Primary}" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{Binding NewLabel, FallbackValue='＋ 新建'}"
                    Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="13"
                    Command="{Binding NewCommand}" VerticalOptions="Center" />
        </Grid>

        <!-- 列表 -->
        <CollectionView Grid.Row="1" x:Name="AssetList"
                        ItemsSource="{Binding Items}"
                        Margin="16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                    <Label Text="📭" FontSize="36" HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}" FontSize="14" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:AssetListItem">
                    <Grid ColumnDefinitions="*,Auto" Padding="14,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold"
                                   LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="{Binding Subtitle}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1"
                                   IsVisible="{Binding Subtitle}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="20" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
