<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Mobile.Shared.Views.MarketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    xmlns:agentAi="clr-namespace:Acme.Agents.AI;assembly=Acme.Agents.AI"
    x:DataType="vm:MarketViewModel"
    Title="市场">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar: status + refresh -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,10" ColumnSpacing="12"
              BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}">
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}" VerticalOptions="Center" />
                <Label Text="{Binding Status}" FontSize="13" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
            </HorizontalStackLayout>
            <Button Grid.Column="1" Text="刷新" Style="{StaticResource GhostButton}"
                    Command="{Binding LoadCommand}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Agents}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="agentAi:MarketplaceAgentDto">
                    <Frame Style="{StaticResource CardFrame}" Margin="16,4">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">

                            <!-- Name + Kind badge -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding AgentName}" FontSize="16" FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,2">
                                    <Label Text="{Binding Kind}" TextColor="White" FontSize="11" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Description -->
                            <Label Grid.Row="1" Text="{Binding Description}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <!-- Category + Creator -->
                            <HorizontalStackLayout Grid.Row="2" Spacing="8">
                                <Label Text="{Binding Category}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding CreatorUserName}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </HorizontalStackLayout>

                            <!-- Summon button / summoned badge -->
                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <Button Grid.Column="1" Text="召唤" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SummonCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding IsSummoned, Converter={StaticResource InverseBool}}" />
                                <Label Grid.Column="1" Text="✓ 已召唤" FontSize="13" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       IsVisible="{Binding IsSummoned}" />
                            </Grid>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
