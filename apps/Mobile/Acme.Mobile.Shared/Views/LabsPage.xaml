<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage Shell.TabBarIsVisible="False"
    x:Class="Acme.Mobile.Shared.Views.LabsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:model="clr-namespace:Acme.Mobile.Mvvm.Models;assembly=Acme.Mobile.Mvvm"
    x:DataType="vm:LabsViewModel"
    Loaded="OnLoaded"
    Title="labs">

    <Grid RowDefinitions="Auto,*">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           Color="{DynamicResource Primary}" HorizontalOptions="Start" Margin="20,12,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Label Text="{Binding StatusMessage}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       IsVisible="{Binding StatusMessage}">
                </Label>

                <!-- 每个 labs 子目录一个分组 -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="model:LabsSection">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Label}" FontFamily="OpenSansSemibold" FontSize="15" />

                                <Frame Style="{StaticResource CardFrame}" Padding="0">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}" Spacing="0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="model:LabsFileItem">
                                                <Grid ColumnDefinitions="*,Auto" Padding="14,12">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFileCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Extension}" FontSize="11"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Frame>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
