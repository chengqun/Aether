<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.WorkflowsView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,12" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Data="{x:Static shell:Codicons.Link}" Stretch="Uniform" Width="15" Height="15" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="工作流" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="多 agent 转交编排" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <Button Grid.Column="2" Content="+ 创建工作流" Classes="primary" Click="OnAddClick" Padding="14,6" />
      </Grid>
    </Border>

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding !Workflows.Count}"
                HorizontalAlignment="Center" Padding="40">
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="还没有工作流" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="点击右上角「创建工作流」，编排多个专家协作" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Workflows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Width="300">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ParticipantSummary}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="召唤" Classes="primary tool" Click="OnToggleSummonClick" Tag="{Binding}"
                            IsVisible="{Binding !IsSummoned}" />
                    <Button Content="取消召唤" Classes="tool" Click="OnToggleSummonClick" Tag="{Binding}"
                            IsVisible="{Binding IsSummoned}" />
                    <Button Content="编辑" Classes="tool" Click="OnEditClick" Tag="{Binding}" />
                    <Button Content="删除" Classes="tool" Click="OnDeleteClick" Tag="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
