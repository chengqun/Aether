<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.LeftTreePanelView"
             Background="Transparent">

  <!-- shell 级左栏切换层：叠放文件树 + 笔记树，按当前 tab 切显隐（WorkspaceView.SetActiveTree 驱动）。
       DataContext = MainViewModelBase（经 ViewRegistry vmFactory）；子 view 各自绑 Documents/Notes 共享 VM 单例。 -->
  <Grid>
    <shell:FileTreeView x:Name="FileTreePanel" DataContext="{Binding Documents}" IsVisible="True"/>
    <shell:NotesTreeView x:Name="NotesTreePanel" DataContext="{Binding Notes}" IsVisible="False"/>
  </Grid>
</UserControl>
