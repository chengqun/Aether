<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 多目标：net10.0-windows 才引 StockTrading.Infrastructure（FlaUI/WPF，Windows-only）；
         net10.0 保留 macOS/Linux 跨平台构建（CTP/回测等其它上下文不受影响）。
         按 OS 条件化：Windows 上双目标（dev 用 -f net10.0-windows 带 FlaUI）；mac/linux 只声明
         net10.0——否则 restore 仍会评估 net10.0-windows TFM → 触及 Infrastructure（net10.0-windows +
         UseWPF）→ NETSDK1100。windows TFM 在非 Windows 上根本不声明，restore/build 都不碰它。 -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共享 shell + 公共组合；stockapp 租户专属上下文（不含 qifu）+ AI 工具 -->
    <ProjectReference Include="..\..\Desktop\Acme.Desktop.Shared\Acme.Desktop.Shared.csproj" />
    <ProjectReference Include="..\..\..\business\Ctp\Acme.Ctp.Application\Acme.Ctp.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Ctp\Acme.Ctp.Infrastructure\Acme.Ctp.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\Securities\Acme.Securities.Application\Acme.Securities.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Securities\Acme.Securities.Infrastructure\Acme.Securities.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\Quotes\Acme.Quotes.Application\Acme.Quotes.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Quotes\Acme.Quotes.Infrastructure\Acme.Quotes.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\Trading\Acme.Trading.Application\Acme.Trading.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Trading.Runtime\Acme.Trading.Runtime.Lean\Acme.Trading.Runtime.Lean.csproj" />
    <!-- 股票交易 Application（跨平台契约，所有 TFM 都引） -->
    <ProjectReference Include="..\..\..\business\StockTrading\Acme.StockTrading.Application\Acme.StockTrading.Application.csproj" />
    <ProjectReference Include="..\..\..\business\StockTrading\Acme.StockTrading.Infrastructure\Acme.StockTrading.Infrastructure.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\..\..\business\Trading.Runtime\Acme.Trading.Scripting\Acme.Trading.Scripting.csproj" />
    <ProjectReference Include="..\..\..\ai\Quotes\Acme.Quotes.AI\Acme.Quotes.AI.csproj" />
    <ProjectReference Include="..\..\..\ai\Ctp\Acme.Ctp.AI\Acme.Ctp.AI.csproj" />
    <ProjectReference Include="..\..\..\ai\Trading\Acme.Trading.AI\Acme.Trading.AI.csproj" />
    <ProjectReference Include="..\..\..\ai\StockTrading\Acme.StockTrading.AI\Acme.StockTrading.AI.csproj" />
    <!-- AppAutomation：固定过程 + MCP 桌面控制；StockTradingBridge 提供 IStockBrokerage 的 MCP 实现 -->
    <ProjectReference Include="..\..\..\business\AppAutomation\Acme.AppAutomation.Infrastructure\Acme.AppAutomation.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\AppAutomation\Acme.AppAutomation.StockTradingBridge\Acme.AppAutomation.StockTradingBridge.csproj" />
    <!-- AppAutomation.McpClient：RegistryMcpToolInvoker 复用 IMcpServerRegistry 已连的 desktop server 工具。 -->
    <ProjectReference Include="..\..\..\business\AppAutomation\Acme.AppAutomation.McpClient\Acme.AppAutomation.McpClient.csproj" />
  </ItemGroup>

</Project>
