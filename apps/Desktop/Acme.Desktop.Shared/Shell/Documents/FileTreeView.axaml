<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.FileTreeView"
             Background="{DynamicResource CardBgBrush}">

  <UserControl.Resources>
    <!-- 文件树节点模板（与原 DocumentsView 同；拆分后独立 view 自带）。
         Auto 列：文件夹图标不显时列宽自动收 0；Grid（非 StackPanel）保 * 列 TextTrimming 生效。 -->
    <TreeDataTemplate x:Key="FileNodeTemplate" ItemsSource="{Binding Children}">
      <Grid ColumnDefinitions="Auto,*" Background="Transparent">
        <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
              Margin="0,0,6,0" Fill="{Binding IconColor}" IsVisible="{Binding ShowFillIcon}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
              Margin="0,0,6,0" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
              Stroke="{Binding IconColor}" IsVisible="{Binding ShowStrokeIcon}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </TreeDataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 共享样式（ScrollViewer 横滚禁用 / TreeViewItem 选中反白 / IsExpanded 双绑）已上移 SharedTheme.axaml，
         匹配 TreeView.docs-tree class 选择器。此处仅留树特有的 chevron 箭头（IsFolder）+ 树头菜单栏样式。 -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="{Binding IsFolder}"/>
    </Style>

    <!-- 树头菜单栏：透明背景融入树头，去掉默认菜单边框 -->
    <Style Selector="Menu.docs-menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="MenuItem.docs-menu-item">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </UserControl.Styles>

  <!-- shell 级独立左栏：占满高度（由外层 LayoutSplit 控制宽度）。树头「文件 ▾」仅留树相关 3 项。 -->
  <Border Background="{DynamicResource CardBgBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*">
      <!-- 树头：「文件」下拉菜单（项目名不显——文件树根节点已是目录名，重复无意义，同原 DocumentsView 2026-08-15 决策） -->
      <Border Grid.Row="0" Padding="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Menu Classes="docs-menu">
          <MenuItem Header="文件" Classes="docs-menu-item">
            <MenuItem Header="打开项目目录" Click="OnOpenFolderClick">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Folder}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="关闭项目" Command="{Binding CloseProjectCommand}"
                      IsEnabled="{Binding HasProject}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="打开文件" Click="OnOpenFileClick">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.File}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
        </Menu>
      </Border>
      <TreeView Grid.Row="1" x:Name="FileTree" Classes="docs-tree" Margin="4,4"
                ItemsSource="{Binding Roots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                SelectionChanged="OnTreeSelectionChanged"
                ItemTemplate="{StaticResource FileNodeTemplate}">
        <!-- 文件树右键菜单（对标 VSCode 资源管理器常用文件操作）：新建文件/文件夹、打开文件、
             重命名、删除、复制路径、在文件管理器中显示。菜单 DataContext 继承 TreeView.ItemTemplate
             当前节点（TreeViewItem 的 DataContext=FileNode），故 CommandParameter 绑当前 FileNode。
             根节点/文件夹才有「新建」，文件才有「打开」；其余按文件/文件夹分显隐（IsFolder 绑。 -->
        <TreeView.ContextMenu>
          <!-- 绑定 VM.SelectedNode（右键时 TreeView 已选中该节点），菜单项 DataContext 继承自 TreeView=VM，
               不继承每个 TreeViewItem 的 FileNode——故 IsEnabled 绑 VM.SelectedNode + FileNodeIsFolderConverter 判 IsFolder。 -->
          <ContextMenu>
            <MenuItem Header="新建文件" Click="OnNewFileClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:FileNodeIsFolderConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.NewFile}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="新建文件夹" Click="OnNewFolderClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:FileNodeIsFolderConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.NewFolder}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="打开" Click="OnOpenNodeClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:FileNodeIsFolderConverter.Instance}, ConverterParameter='!'}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.File}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="重命名…" Click="OnRenameClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Edit}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="删除" Click="OnDeleteClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Trash}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="复制路径" Click="OnCopyPathClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Copy}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="复制相对路径" Click="OnCopyRelativePathClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.GoToFile}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="在文件管理器中显示" Click="OnRevealInFileManagerClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.FolderActive}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      <!-- 空态：未打开目录 -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding !HasProject}" Spacing="8">
        <Path Data="{x:Static shell:Codicons.Folder}" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5"/>
        <TextBlock Text="未打开项目目录" FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="「文件 ▾ 打开项目目录」" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
