<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             xmlns:conv="using:Acme.Desktop.Shared.Shell.Converters"
             x:Class="Acme.Desktop.Shared.Shell.ExpertsView"
             Background="{DynamicResource ContentBgBrush}">

  <DockPanel>
    <!-- 顶部标题栏 + tab（labs 知识对象页承接 agent/rule/workflow 创建+编辑后，专家页仅留 连接器/MCP/技能 三 tab） -->
    <Border DockPanel.Dock="Top" Classes="page-header">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="top-tab" Content="连接器" Command="{Binding ShowConnectorTabCommand}"
                  IsEnabled="{Binding !IsConnectorTab}" Padding="12,4" FontSize="13"
                  IsVisible="{Binding HasConnector}" />
          <Button Classes="top-tab" Content="MCP工具" Command="{Binding ShowMcpTabCommand}"
                  IsEnabled="{Binding !IsMcpTab}" Padding="12,4" FontSize="13" />
          <Button Classes="top-tab" Content="技能" Command="{Binding ShowSkillTabCommand}"
                  IsEnabled="{Binding !IsSkillTab}" Padding="12,4" FontSize="13" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== tab 内容（填充剩余空间；三面板叠加，IsVisible 切换） ===== -->
    <Grid>
    <!-- ===== 连接器面板（数据驱动：ItemsControl + WrapPanel，共享卡片模板） =====
         各租户只提供 IConnectorViewModel.Cards，加卡 = 加项，零 XAML 改动，自动换行。 -->
    <Panel IsVisible="{Binding IsConnectorTab}">
      <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Connector.Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="12" LineSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Width="300">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{Binding IconBackground}">
                        <TextBlock Text="{Binding Icon}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border CornerRadius="6" Padding="10,6" Background="{DynamicResource WarningBgBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="8" Height="8"
                                   Fill="{Binding IsConnected, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
                          <TextBlock Text="{Binding StatusText}" FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                      </Border>
                      <Button Content="同步" Command="{Binding SyncCommand}"
                              IsVisible="{Binding ShowSync}" Padding="10,6" FontSize="11" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Command="{Binding PrimaryCommand}" IsEnabled="{Binding IsPrimaryEnabled}"
                            Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalAlignment="Right">
                      <Path Data="{x:Static shell:Codicons.Add}" Stretch="Uniform" Width="16" Height="16"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <!-- ===== MCP 工具服务器面板 ===== -->
    <Panel IsVisible="{Binding IsMcpTab}">
      <shell:McpView DataContext="{Binding Mcp}" />
    </Panel>

    <!-- ===== 技能面板（只读展示已加载 skill：卡片列表 + 正文 Markdown 预览 + 打开 skills 目录） ===== -->
    <Panel IsVisible="{Binding IsSkillTab}">
      <shell:SkillView DataContext="{Binding Skills}" />
    </Panel>
    </Grid>
  </DockPanel>
</UserControl>
