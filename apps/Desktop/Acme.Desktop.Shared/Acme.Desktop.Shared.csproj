<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- 集成终端控件（SkiaSharp/HarfBuzz 渲染；own-transport + SendInput/WriteOutput + shell integration，供 B2 run_in_terminal 捕获）。要求 Avalonia >=12.1.1，故全 app 升 12.0.4→12.1.1。 -->
    <PackageReference Include="RoyalApps.RoyalTerminal.Avalonia" Version="0.5.1" />
    <!-- Playwright（浏览器网络面板 + browser_open/get_cookies 工具：headed Chromium 独立窗口，用户手动登录后取 cookie 给 agent curl）。与 Qifu.Infrastructure 同版本；浏览器二进制靠 playwright install 单独装。 -->
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- VSCode codicon 图标（矢量 geometry；Codicons.cs 经 PackIconDataFactory 取 path data 喂全 app <Path Fill>）。Workbench 经 ProjectReference 传递获得。 -->
    <PackageReference Include="IconPacks.Avalonia.Codicons" Version="2.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- Roslyn 语义分析（EditSymbolTool：符号级 C# 编辑）。宿主层独有——不复用 ai/SystemTools 的轻量工具集。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.13.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.13.0" />
    <!-- Lottie 动画（桌宠形象层）：Skia 官方 Skottie 模块的 managed 绑定。与主 SkiaSharp（3.119.4，
         经 RoyalTerminal/Avalonia 传递引入）版本同步；原生 libSkiaSharp.dylib 已内置 skottie 符号，零新增原生库。 -->
    <PackageReference Include="SkiaSharp.Skottie" Version="3.119.4" />
    <!-- Avalonia 的 Skia 渲染后端（显式引用以取 ISkiaSharpApiLeaseFeature——DrawingContext → SKCanvas 桥，
         桌宠 Lottie 自绘用）。桌面默认即 Skia 后端，本就是传递依赖，此处仅为编译期类型访问。 -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置主题 JSON（light/dark/dream/dream-dark）—— ThemeLoader 经 avares://Acme.Desktop.Shared/Assets/{name}.json 加载。
         .axaml（SharedTheme/WorkbenchTheme/dream.styles）走 Avalonia SDK 默认 glob 自动纳入 AvaloniaResource，无需显式声明。 -->
    <AvaloniaResource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI 平台 + 公共业务上下文（两租户共用）+ 公共 ai/ 适配器。租户专属上下文由各租户入口项目引用。 -->
    <ProjectReference Include="..\..\Shared\Acme.Shared.HostGlue\Acme.Shared.HostGlue.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Hosting\Aether.AI.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Harness.Scripting\Aether.AI.Harness.Scripting.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Memory.Sqlite\Aether.AI.Memory.Sqlite.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Mcp\Aether.AI.Mcp.csproj" />
    <ProjectReference Include="..\..\..\business\AppAuth\Acme.AppAuth.Application\Acme.AppAuth.Application.csproj" />
    <ProjectReference Include="..\..\..\business\AppAuth\Acme.AppAuth.Infrastructure\Acme.AppAuth.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\Llm\Acme.Llm.Application\Acme.Llm.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Llm\Acme.Llm.Infrastructure\Acme.Llm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\Notes\Acme.Notes.Domain\Acme.Notes.Domain.csproj" />
    <ProjectReference Include="..\..\..\business\Notes\Acme.Notes.Infrastructure\Acme.Notes.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\Automation\Acme.Automation.Application\Acme.Automation.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Automation\Acme.Automation.Infrastructure\Acme.Automation.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\ChatSocial\Acme.ChatSocial.Application\Acme.ChatSocial.Application.csproj" />
    <ProjectReference Include="..\..\..\business\ChatSocial\Acme.ChatSocial.Infrastructure\Acme.ChatSocial.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\DeviceConnect\Acme.DeviceConnect.Application\Acme.DeviceConnect.Application.csproj" />
    <ProjectReference Include="..\..\..\business\DeviceConnect\Acme.DeviceConnect.Infrastructure\Acme.DeviceConnect.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\business\DeviceManagement\Acme.DeviceManagement.Application\Acme.DeviceManagement.Application.csproj" />
    <ProjectReference Include="..\..\..\business\DeviceManagement\Acme.DeviceManagement.Infrastructure\Acme.DeviceManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\ai\SystemTools\Acme.SystemTools.AI\Acme.SystemTools.AI.csproj" />
    <ProjectReference Include="..\..\..\ai\ApkParser\Acme.ApkParser.AI\Acme.ApkParser.AI.csproj" />
    <ProjectReference Include="..\..\..\ai\Agents\Acme.Agents.AI\Acme.Agents.AI.csproj" />
    <!-- UI 无关 shell VM 库（聊天/专家/笔记 VM，Avalonia/MAUI/WPF 共用） -->
    <ProjectReference Include="..\Acme.Desktop.Mvvm\Acme.Desktop.Mvvm.csproj" />
  </ItemGroup>

</Project>
