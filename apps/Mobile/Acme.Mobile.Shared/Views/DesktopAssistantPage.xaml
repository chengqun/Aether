<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage Shell.TabBarIsVisible="False"
    x:Class="Acme.Mobile.Shared.Views.DesktopAssistantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:md="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
    xmlns:domain="clr-namespace:Acme.ChatSocial.Domain;assembly=Acme.ChatSocial.Domain"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters;assembly=Acme.Mobile.Shared"
    xmlns:views="clr-namespace:Acme.Mobile.Shared.Views;assembly=Acme.Mobile.Shared"
    Title="桌面助手">

    <ContentPage.Resources>
        <conv:MarkdownTableFillConverter x:Key="MarkdownTableFill" />

        <!-- 我的消息：右侧绿色气泡 -->
        <DataTemplate x:Key="MineTemplate" x:DataType="domain:ChatMessage">
            <HorizontalStackLayout Margin="12,4" HorizontalOptions="End">
                <Border BackgroundColor="{StaticResource BubbleMine}"
                        StrokeShape="RoundRectangle 14" StrokeThickness="0"
                        Padding="12,8" MaximumWidthRequest="280">
                    <Label Text="{Binding Content}" TextColor="{StaticResource TextPrimary}" FontSize="15" LineBreakMode="WordWrap" />
                </Border>
            </HorizontalStackLayout>
        </DataTemplate>

        <!-- 桌面消息：**镜像桌面端 AI agent 回复布局**（ChatMessagesView MsgTemplate 的 IsAgentMarkdownText 分支）——
             全宽无框 + Markdown，不用气泡背景。桌面端是 StackPanel(HorizontalAlignment=Stretch) + SelectableMarkdownViewer(Stretch)，
             无 Border/无圆角/无底色，markdown 直接占满整行、文字按页面底色显示。手机端等价实现：
             Grid(Fill) + MarkdownView(Fill)——Grid（非 VSL）在 measure 期把自身全宽分配给子元素，不按子内容宽自测，
             根治 Indiko MarkdownView 单次渲染（POCO 摘要一次性到达、无流式收敛）按内容宽自测致长行右缘被裁「被挡住」。
             用户消息仍是右侧绿色窄气泡（对齐桌面端 bubble-user 右气泡）。 -->
        <DataTemplate x:Key="DesktopTemplate" x:DataType="domain:ChatMessage">
            <Grid Margin="12,4" HorizontalOptions="Fill">
                <md:MarkdownView MarkdownText="{Binding Content, Converter={StaticResource MarkdownTableFill}}"
                                 Theme="{StaticResource AppMarkdownTheme}" UseAppTheme="True"
                                 HorizontalOptions="Fill" />
            </Grid>
        </DataTemplate>

        <views:DesktopAssistantTemplateSelector x:Key="ChatMessageSelector"
            MineTemplate="{StaticResource MineTemplate}"
            DesktopTemplate="{StaticResource DesktopTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <!-- 消息列表（复用通用聊天页的消息渲染：进度心跳已被 VM 过滤，历史不残留） -->
        <!-- ItemSizingStrategy=MeasureAllItems（关键）：iOS CollectionView 默认 MeasureFirstItem——
             测第一个 item 的高度后复用给所有 item。本页第一条通常是用户的短气泡（MaximumWidthRequest=280，
             行高小）→ 后续桌面端全宽 Markdown 回复被裁到该短高度「被挡住/裁切」，尤其从历史记录批量载入时必现
             （流式逐条追加时 CollectionView 会重测故不明显）。MeasureAllItems 逐 item 自测高度，根治纵向裁切。 -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        ItemTemplate="{StaticResource ChatMessageSelector}"
                        ItemSizingStrategy="MeasureAllItems"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- 底部组合栏：设备下拉（选择电脑）上沿 + 输入栏，对齐 AI 页 agent/LLM 选择条的位置 -->
        <VerticalStackLayout Grid.Row="1" Spacing="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}">
            <!-- 选择电脑下拉（多台 desktop 设备各自独立会话） -->
            <Grid ColumnDefinitions="Auto,*" Padding="12,6,12,2" ColumnSpacing="8">
                <Label Grid.Column="0" Text="💻" FontSize="16" VerticalOptions="Center" />
                <Picker Grid.Column="1" Title="选择电脑"
                        ItemsSource="{Binding Devices}"
                        SelectedIndex="{Binding SelectedDeviceIndex}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
            </Grid>
            <!-- 桌面只读状态：在线/离线 + 当前选中专家名（服务端内存态，桌面上报，手机不可改） -->
            <Label Padding="12,0,12,4" FontSize="12" Opacity="0.75"
                   Text="{Binding DesktopStatusText}"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
            <!-- 输入栏（轻控制：直接发指令给当前选中的桌面电脑） -->
            <Border Padding="8" StrokeThickness="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" x:Name="MessageEntry"
                           Text="{Binding MessageInput}"
                           Placeholder="发送指令给这台电脑…"
                           ReturnType="Send"
                           ReturnCommand="{Binding SendMessageCommand}" />
                    <Button Grid.Column="1" Text="发送" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding HasMessageInput}"
                            Padding="16,8" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
