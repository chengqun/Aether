<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Desktop.Shared.Shell.SettingsWindow"
        Title="设置"
        Width="900" Height="550"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <local:MaskApiKeyConverter x:Key="MaskApiKeyConverter"/>
  </Window.Resources>

  <Grid ColumnDefinitions="180,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="8">
        <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Margin="10,12,0,20"/>
        
        <Button Classes="settings-nav" Content="⚙️ LLM 配置"
                Command="{Binding SwitchTabCommand}" CommandParameter="llm"
                IsEnabled="{Binding IsNotLlmTab}"/>
        <Button Classes="settings-nav" Content="🔗 设备连接"
                Command="{Binding SwitchTabCommand}" CommandParameter="device"
                IsEnabled="{Binding IsNotDeviceTab}"/>
        <Button Classes="settings-nav" Content="🎨 外观"
                Command="{Binding SwitchTabCommand}" CommandParameter="appearance"
                IsEnabled="{Binding IsNotAppearanceTab}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="20" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid x:Name="LlmSection" IsVisible="{Binding IsLlmTabActive}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <TextBlock Text="LLM 配置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="+ 新增配置" Classes="primary" Margin="16,0,0,0"
                      Command="{Binding ShowAddLlmModalCommand}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding LlmConfigs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="16,14"
                          HorizontalAlignment="Stretch" Margin="0,0,0,12">
                    <StackPanel Spacing="10">
                      <!-- 名称 + 徽章 -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource AccentTintBgBrush}"
                                VerticalAlignment="Center" IsVisible="{Binding IsSystem}">
                          <TextBlock Text="系统" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SuccessBgBrush}"
                                VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                          <TextBlock Text="默认" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                      </StackPanel>

                      <!-- 模型 -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="模型" FontSize="12" Width="64"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ModelName}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>

                      <!-- Endpoint -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Endpoint" FontSize="12" Width="64"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Endpoint}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Endpoint}"/>
                      </StackPanel>

                      <!-- API Key -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="API Key" FontSize="12" Width="64"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ApiKey, Converter={StaticResource MaskApiKeyConverter}}"
                                   FontSize="13" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </StackPanel>

                      <!-- 温度 -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="温度" FontSize="12" Width="64"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Temperature}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </StackPanel>

                      <!-- 操作 -->
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="设为默认" Padding="10,4" FontSize="12"
                                IsVisible="{Binding !IsDefault}"
                                Command="{Binding DataContext.SetDefaultLlmConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="编辑" Padding="10,4" FontSize="12"
                                Command="{Binding DataContext.EditLlmConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="删除" Padding="10,4" FontSize="12"
                                IsEnabled="{Binding !IsSystem}"
                                Command="{Binding DataContext.DeleteLlmConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,20,0,20" Orientation="Vertical" VerticalAlignment="Center"
                        IsVisible="{Binding HasNoLlmConfigs}">
              <TextBlock Text="暂无 LLM 配置" FontSize="14"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock Text="点击上方「新增配置」按钮添加" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding LlmError}" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" Margin="0,8,0,0"
                       IsVisible="{Binding HasLlmError}"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="DeviceSection" IsVisible="{Binding IsDeviceTabActive}">
          <StackPanel>
            <TextBlock Text="设备连接" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                    HorizontalAlignment="Stretch" Margin="0,0,0,8">
              <StackPanel Spacing="10">
                <!-- 卡片头：设备名 + 连接状态徽章 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                          Background="{Binding ConnectionStatusColor}">
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="9" Foreground="White"/>
                  </Border>
                </StackPanel>

                <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址" FontSize="13"
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceServerUrl}"
                           Margin="8,0,0,10" PlaceholderText="如 https://api.example.com"
                           Classes="input"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="设备认证码" FontSize="13"
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceAuthorizationCode}"
                           Margin="8,0,0,10" PlaceholderText="输入设备认证码"
                           Classes="input"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="设备名称" FontSize="13"
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeviceName}"
                           Margin="8,0,0,10" PlaceholderText="如 桌面助手"
                           Classes="input"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="设备类型" FontSize="13"
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeviceType}"
                           Margin="8,0,0,10" IsReadOnly="True"
                           Classes="input"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="当前租户" FontSize="13"
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DeviceTenant}"
                           Margin="8,0,0,10" IsReadOnly="True"
                           Classes="input"/>
                </Grid>

                <!-- 自动连接 -->
                <Border Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding AutoConnect}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical">
                      <TextBlock Text="自动连接" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Text="启动时自动使用保存的配置连接到服务器" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding DeviceError}" FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding HasDeviceError}" Margin="0,0,0,4"/>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="连接" Classes="primary"
                          IsEnabled="{Binding CanConnect}"
                          Command="{Binding ConnectDeviceCommand}"/>
                  <Button Content="断开"
                          IsEnabled="{Binding IsDeviceConnected}"
                          Command="{Binding DisconnectDeviceCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- 外观：主题选择（内置 light/dark + 用户 themes/*.json） -->
        <Grid x:Name="AppearanceSection" IsVisible="{Binding IsAppearanceTabActive}">
          <StackPanel>
            <TextBlock Text="外观" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding Themes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="8" Padding="14,10"
                          HorizontalAlignment="Stretch" Margin="0,0,0,8">
                    <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="0"
                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Name}"
                            IsEnabled="{Binding !IsCurrent}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✓" FontWeight="Bold" Width="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   IsVisible="{Binding IsCurrent}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="把主题 JSON 文件放到 themes/ 目录即可在列表新增（重启后生效）。schema 见内置 theme.json：colors/fonts/radius/spacing/background 五段，key 须匹配 token 名（AccentBrush/SidebarBgBrush/ContentBgBrush…）。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>