<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             xmlns:nav="using:Acme.Shell"
             x:Class="Acme.Desktop.Shared.Shell.NotesView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Border.note-card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="Button.notes-tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.notes-tool:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="#F5F5F5"/>
    </Style>
    <Style Selector="Button.notes-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" Background="White"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Path Data="{x:Static nav:NavIcons.Notes}" Stretch="Uniform" Width="18" Height="18"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="笔记" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="右键菜单操作" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="200,4,*">

      <Border Grid.Column="0" Background="White" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <TreeView x:Name="NotesTree" Margin="4,4"
                  ItemsSource="{Binding Roots}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="新建节点（同级）" Click="OnCreateSiblingClick" />
              <MenuItem Header="新建子节点" Click="OnCreateChildClick"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              <Separator />
              <MenuItem Header="修改节点属性" Click="OnEditPropertiesClick"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              <MenuItem Header="删除" Command="{Binding DeleteNoteCommand}"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <Grid HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource AccentBrush}" Opacity="0.22"
                        CornerRadius="4" IsVisible="{Binding IsDropTarget}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding IconColor}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="Padding" Value="2,1"/>
            </Style>
            <!-- 箭头三角大小不变，只压缩容器空白让其紧贴节点 -->
            <Style Selector="TreeViewItem /template/ ToggleButton">
              <Setter Property="Width" Value="12"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
            </Style>
            <!-- 选中后背景变深，文字转白保证可读 -->
            <Style Selector="TreeViewItem:selected">
              <Setter Property="Foreground" Value="White"/>
            </Style>
          </TreeView.Styles>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}" Cursor="SizeWestEast" />

      <Border Grid.Column="2" Background="White">
        <Grid>
          <Border IsVisible="{Binding !SelectedNode}">
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{x:Static nav:NavIcons.Notes}" Stretch="Uniform" Width="48" Height="48"
                    StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="#C8C8CE" HorizontalAlignment="Center"/>
              <TextBlock Text="选择左侧一条笔记，或右键「新建节点」开始" FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <DockPanel IsVisible="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
            <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Data="{Binding SelectedNode.Icon}" Stretch="Uniform" Width="15" Height="15"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding SelectedNode.IconColor}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedNode.Title}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="notes-tool" Command="{Binding TogglePreviewCommand}"
                        ToolTip.Tip="{Binding IsPreviewMode, Converter={x:Static shell:BoolToTextConverter.EditPreview}}">
                  <Path Data="{Binding IsPreviewMode, Converter={x:Static shell:PreviewIconConverter.Instance}}"
                        Stretch="Uniform" Width="15" Height="15" StrokeThickness="1.6"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding $parent.Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Grid.Column="2" Classes="notes-tool" Click="OnEditAgentClick"
                        IsVisible="{Binding IsAgentNode}" ToolTip.Tip="用 Agent 表单弹窗编辑">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Data="{x:Static nav:NavIcons.Pencil}" Stretch="Uniform" Width="14" Height="14"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{Binding $parent.Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="表单编辑" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="notes-primary" Command="{Binding SaveNoteCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Data="{x:Static nav:NavIcons.Save}" Stretch="Uniform" Width="14" Height="14"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="White"/>
                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Grid>
              <TextBox IsVisible="{Binding !IsPreviewMode}"
                       Text="{Binding SelectedNode.Content, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="13"
                       Padding="8,6" />
              <TextBox IsVisible="{Binding IsPreviewMode}"
                       Text="{Binding SelectedNode.Content}"
                       IsReadOnly="True" BorderThickness="0"
                       TextWrapping="Wrap" FontSize="13"
                       Padding="8,6" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>