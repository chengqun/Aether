<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Desktop.Shared.Shell.WorkflowEditWindow"
        Title="工作流配置"
        Width="560" Height="700" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Command="{Binding CancelCommand}" Padding="20,8"/>
        <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Classes="primary" Padding="20,8"/>
      </StackPanel>
    </Border>
    <shell:WorkflowEditView/>
  </DockPanel>
</Window>
