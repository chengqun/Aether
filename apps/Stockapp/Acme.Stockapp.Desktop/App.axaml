<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Acme.Desktop.Workbench"
             xmlns:wsw="using:Acme.Desktop.Workbench.Workspace"
             x:Class="Acme.Stockapp.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <!-- ProDataGrid 主题（Avalonia.Controls.DataGrid 同名程序集，drop-in 替代官方 DataGrid） -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.v2.xaml"/>
        <StyleInclude Source="avares://Acme.Desktop.Shared/Themes/SharedTheme.axaml"/>
    </Application.Styles>

    <Application.DataTemplates>
        <!-- Workspace 决定布局：ActiveWorkspace(WorkspaceViewModel) → WorkspaceView 遍历 LayoutNode 建视觉树。
             租户页（期货/回测/股票）视图改由 StockappViewContributor 经 IViewRegistry 注册，不再用 DataTemplate 映射。 -->
        <DataTemplate DataType="wsw:WorkspaceViewModel">
            <wb:WorkspaceView />
        </DataTemplate>
    </Application.DataTemplates>

</Application>
