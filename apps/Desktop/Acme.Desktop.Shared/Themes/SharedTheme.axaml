<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia">

  <!-- 设计 Token：配色（浅色科技风），从 AlphaAgent App.axaml 搬运 -->
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="AccentColor">#5B5FC7</Color>
      <Color x:Key="AccentHoverColor">#4A4EAE</Color>
      <Color x:Key="AccentLightColor">#7B7FEB</Color>
      <Color x:Key="DangerColor">#EF4444</Color>
      <Color x:Key="SidebarBg">#F7F7F8</Color>
      <Color x:Key="SidebarHoverBg">#EDEDEF</Color>
      <Color x:Key="SidebarActiveBg">#5B5FC7</Color>
      <Color x:Key="SidebarIconColor">#6B6B70</Color>
      <Color x:Key="SidebarText">#2D2D32</Color>
      <Color x:Key="ContentBg">#FFFFFF</Color>
      <Color x:Key="CardBg">#FFFFFF</Color>
      <Color x:Key="BorderColor">#E8E8EC</Color>
      <Color x:Key="TextPrimary">#1A1A1F</Color>
      <Color x:Key="TextSecondary">#6B6B70</Color>
      <Color x:Key="UserBubbleBg">#5B5FC7</Color>
      <Color x:Key="UserBubbleFgColor">#FFFFFF</Color>
      <Color x:Key="AgentBubbleBg">#F7F7F8</Color>
      <Color x:Key="ToolCallColor">#EEF0FB</Color>
      <Color x:Key="ToolCallBorderColor">#D1D5F0</Color>
      <Color x:Key="ToolCallTextColor">#3D40B5</Color>
      <Color x:Key="ToolResultColor">#ECF8F0</Color>
      <Color x:Key="ToolResultBorderColor">#C2E8CF</Color>
      <Color x:Key="ToolResultTextColor">#1F8A4C</Color>

      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
      <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
      <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverBg}"/>
      <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveBg}"/>
      <SolidColorBrush x:Key="SidebarIconBrush" Color="{StaticResource SidebarIconColor}"/>
      <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarText}"/>
      <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBg}"/>
      <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
      <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource UserBubbleBg}"/>
      <SolidColorBrush x:Key="UserBubbleFgBrush" Color="{StaticResource UserBubbleFgColor}"/>
      <SolidColorBrush x:Key="AgentBubbleBrush" Color="{StaticResource AgentBubbleBg}"/>
      <SolidColorBrush x:Key="ToolCallBrush" Color="{StaticResource ToolCallColor}"/>
      <SolidColorBrush x:Key="ToolCallBorderBrush" Color="{StaticResource ToolCallBorderColor}"/>
      <SolidColorBrush x:Key="ToolCallTextBrush" Color="{StaticResource ToolCallTextColor}"/>
      <SolidColorBrush x:Key="ToolResultBrush" Color="{StaticResource ToolResultColor}"/>
      <SolidColorBrush x:Key="ToolResultBorderBrush" Color="{StaticResource ToolResultBorderColor}"/>
      <SolidColorBrush x:Key="ToolResultTextBrush" Color="{StaticResource ToolResultTextColor}"/>
      <!-- 分隔条 fallback 画刷（主题 JSON 的 SplitterBrush 会覆盖此值；缺失时用中性浅灰保证分界线仍可见） -->
      <SolidColorBrush x:Key="SplitterBrush" Color="#D8D8DC"/>

      <!-- 语义/表面 token（dark 主题覆盖这些键即换肤）。
           Surface=次级表面（chip/代码块底，比 CardBg 略深/略浅以区分）；
           Success/Danger/Warning/AccentTint=状态徽章 bg(浅 tint 底)+fg(深字色) 成对，
           dark 主题覆盖为深 tint 底+浅字色。DangerBrush 已存在（按钮用），此处 Danger 指徽章 fg 复用它。 -->
      <Color x:Key="SurfaceColor">#F3F4F6</Color>
      <Color x:Key="SurfaceHoverColor">#E5E7EB</Color>
      <Color x:Key="SuccessColor">#2E7D32</Color>
      <Color x:Key="SuccessBgColor">#E8F5E9</Color>
      <Color x:Key="DangerBgColor">#FFEBEE</Color>
      <Color x:Key="WarningColor">#B45309</Color>
      <Color x:Key="WarningBgColor">#FFF3E0</Color>
      <Color x:Key="AccentTintBgColor">#EEF0FB</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="OnDangerColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
      <!-- TreeView 选中行文字色：浅主题白字（深色 accent 选中底上可读）；深主题主文字色（浅选中底上可读）。
           三处 TreeView（NotesTree/FileTree/KoTree）共用，由主题 JSON 的 TreeSelectedFgColor 键控制。 -->
      <Color x:Key="TreeSelectedFgColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="TreeSelectedFgBrush" Color="{StaticResource TreeSelectedFgColor}"/>
      <!-- 终端面板底色：始终深色（VSCode 经典深底），刻意不参与换肤——终端对比度要求稳定。 -->
      <Color x:Key="TerminalBgColor">#1E1E1E</Color>
      <SolidColorBrush x:Key="TerminalBgBrush" Color="{StaticResource TerminalBgColor}"/>
      <!-- 文本选区高亮（MarkdownViewer/ReportWindow 共用；原硬编码 #3300A2ED 两处去重） -->
      <Color x:Key="SelectionColor">#00A2ED</Color>
      <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
      <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
      <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
      <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
      <SolidColorBrush x:Key="AccentTintBgBrush" Color="{StaticResource AccentTintBgColor}"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
      <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}"/>

      <!-- 圆角 token（换肤可覆盖）：Sm=按钮/输入框/消息卡，Md=侧边栏项/卡片，Lg=气泡/输入卡。
           统一三档 8/12/16（4 的倍数），换肤 JSON 的 "radius" 段覆盖同名键。chip/bubble-user 不对称圆角
           是刻意形状，不走这三档。 -->
      <CornerRadius x:Key="CornerRadiusXs">4</CornerRadius>
      <CornerRadius x:Key="CornerRadiusSm">8</CornerRadius>
      <CornerRadius x:Key="CornerRadiusMd">12</CornerRadius>
      <CornerRadius x:Key="CornerRadiusLg">16</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 全局字体：文本用 Inter/系统字体，emoji 回退到 Apple Color Emoji / Segoe UI Emoji（避免 emoji 被裁切/ tofu） -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter,Segoe UI,system-ui,-apple-system,Helvetica,Arial,Apple Color Emoji,Segoe UI Emoji,Noto Color Emoji"/>
  </Style>

  <!-- 主按钮 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}"/>
    <Setter Property="Padding" Value="20,8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>

  <!-- 危险按钮 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}"/>
    <Setter Property="Padding" Value="20,8"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- 普通输入框 -->
  <Style Selector="TextBox.input">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
  </Style>

  <!-- ═══ 侧边栏样式（展开/收起各一套自包含样式，不靠 class 覆盖，避免层叠混乱）═══ -->

  <!-- 展开态：导航项 / 收起按钮（图标+文字，左对齐） -->
  <Style Selector="Button.settings-nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
    <Setter Property="Padding" Value="14,11"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="10,2,10,0"/>
  </Style>
  <Style Selector="Button.settings-nav:disabled">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- 同 nav-rail:disabled：Background **和 Foreground** 须 template 层成对补——Fluent 的 :disabled 同时设
       ContentPresenter 的 Background/BorderBrush/Foreground，内容文字若靠继承（非显式绑 Button.Foreground）
       会拿到 Fluent 灰（ButtonForegroundDisabled）落在 accent 深底上读不出（设置对话框选中项踩过） -->
  <Style Selector="Button.settings-nav:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>

  <!-- rail 导航项（紧凑竖排：图标上/常显标签下居中——QWork/飞书式，标签常显免猜图标） -->
  <Style Selector="Button.nav-rail">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
    <Setter Property="Padding" Value="0,7"/>
    <Setter Property="MinHeight" Value="56"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="6,2"/>
  </Style>
  <!-- 选中态（当前页）：accent 胶囊——按钮 IsEnabled=!IsCurrent（disabled 不响应 hover，指针样式即语义）。
       Background/Foreground 须在 /template/ ContentPresenter 层设：Fluent 主题的 :disabled/:pointerover 样式直接设
       ContentPresenter 的 Background+BorderBrush+Foreground、绕过 TemplateBinding，Button 级 setter 压不过
       （本仓 term-tab/scm-row-btn/account-rail 同款处理）。rail 内容显式绑 Button.Foreground 故此前未踩坑，防御性成对补。 -->
  <Style Selector="Button.nav-rail:disabled">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.nav-rail:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>
  <!-- 悬停底色（NavHoverBrush）——48px icon-only 改版时曾随旧样式丢失，随标签化恢复；同须 template 层 -->
  <Style Selector="Button.nav-rail:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
  </Style>
  <!-- 分组首项：上方加间距分隔（Group 变化 → Classes.gap ← NavItem.StartsGroup） -->
  <Style Selector="Button.nav-rail.gap">
    <Setter Property="Margin" Value="6,14,6,2"/>
  </Style>

  <!-- 账户按钮（仅头像，居中，hover 背景）——侧栏底部账号入口。横向 margin 6 与 nav-rail 对齐（hover 胶囊同宽）。 -->
  <Style Selector="Button.account-rail">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="6,0,6,8"/>
  </Style>
  <Style Selector="Button.account-rail:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
  </Style>

  <!-- 侧边栏 rail：恒定 72px 竖排图标+标签（QWork/飞书式——无展开/收起，标签常显；矮窗口 rail 内滚）。
       宽度按「最长标签 4 汉字 × 12px = 48px + 项 margin 12px + 两侧余量」收——标签一律 ≤4 汉字（租户 Workspace.cs Title）。
       descendant 选择器从 Border.sidebar-rail 触达内部按钮（nav 项 + 账号）。
       演进：48px 图标-only（2026-09-22，删展开/收起双态）→ 88px 图标+常显标签（2026-09-23）→ 72px 收窄（同日，用户反馈偏宽）。 -->
  <Style Selector="Border.sidebar-rail">
    <Setter Property="Width" Value="72"/>
  </Style>

  <!-- 一级 Tab 按钮 -->
  <Style Selector="Button.top-tab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.top-tab:disabled">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- 消息气泡 -->
  <Style Selector="Border.bubble-user">
    <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
    <Setter Property="CornerRadius" Value="18,18,4,18"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="MaxWidth" Value="640"/>
  </Style>
  <Style Selector="Border.bubble-agent">
    <Setter Property="Background" Value="{DynamicResource AgentBubbleBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLg}"/>
    <Setter Property="Padding" Value="16,12"/>
  </Style>

  <!-- ChatGPT 风格输入框卡片 -->
  <Style Selector="Border.chat-input-card">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLg}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BoxShadow" Value="0 4 12 0 #14000000"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- 输入框文本区 -->
  <Style Selector="TextBox.chat-text">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="14,12,52,12"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Height" Value="88"/>
    <Setter Property="MaxHeight" Value="88"/>
  </Style>

  <!-- 工具条芯片容器 -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Height" Value="26"/>
  </Style>
  <Style Selector="Border.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <!-- 发送按钮 -->
  <Style Selector="Button.send-btn">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLg}"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style Selector="Button.send-btn:disabled">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- 紧凑 ComboBox -->
  <Style Selector="ComboBox.compact">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- 工具卡片 -->
  <Style Selector="Border.tool-card">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- 通用卡片外框：专家/专家团/市场/MCP/连接器 各 tab 共用，容器用 ItemsControl+WrapPanel 换行。 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <!-- 消息卡（思考/工具/计划/审批 统一底）：淡 tint + 圆角 + 描边 -->
  <Style Selector="Border.msg-card">
    <Setter Property="Background" Value="{DynamicResource ToolCallBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToolCallBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <!-- Markdown.Avalonia 主题覆盖已移至控件级 MarkdownThemeStyles（SelectableMarkdownViewer 加载）。
       原因：GithubLike 主题由 MarkdownScrollViewer ctor Styles.Insert(0,…) 挂进【控件自身】Styles 集合，
       控件级优先级 > app 级 → 此处（app 级）的 markdown 覆盖不生效。见 MarkdownThemeStyles.axaml。 -->

  <!-- 表单字段布局：4 个 EditView（Expert/Rule/Workflow/Knowledge）共用，
       根 UserControl 标 Classes="form-fields" 即生效，免去各文件重复 UserControl.Styles。 -->
  <Style Selector="UserControl.form-fields Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
  </Style>
  <Style Selector="UserControl.form-fields TextBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="UserControl.form-fields ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="UserControl.form-fields NumericUpDown">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <!-- ═══ 共享去重样式（原散落在各 View 的 UserControl.Styles，上移至此一次定义）═══ -->

  <!-- 幽灵按钮：透明底 + 描边（Skill/Mcp/McpServerEdit 三处曾逐字重复） -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}"/>
  </Style>

  <!-- 工具条按钮（Workflows/Automation 两处曾重复） -->
  <Style Selector="Button.tool">
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- SCM 动作按钮（SourceControlView/SourceControlPanelView 两处曾逐字重复） -->
  <Style Selector="Button.scm-act">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.scm-act:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <!-- 同 nav-rail:pointerover：Background 须 template 层才能压过 Fluent 主题的 :pointerover ContentPresenter setter -->
  <Style Selector="Button.scm-act:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
  </Style>

  <!-- TreeView 共享块：三棵文件/笔记/知识树各自带 class（notes-tree/docs-tree/ko-tree）——
        ScrollViewer 横滚禁用 + TreeViewItem 选中白字 + IsExpanded 双向绑定均一致，上移去重。
        chevron 箭头 IsVisible 绑定因树而异（NotesTree 用 Children.Count，File/Ko 用 IsFolder），留各树。 -->
  <Style Selector="TreeView.notes-tree /template/ ScrollViewer, TreeView.docs-tree /template/ ScrollViewer, TreeView.ko-tree /template/ ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
  </Style>
  <Style Selector="TreeView.notes-tree TreeViewItem:selected, TreeView.docs-tree TreeViewItem:selected, TreeView.ko-tree TreeViewItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TreeSelectedFgBrush}"/>
  </Style>

  <!-- 页头栏：内容面板顶部标题栏（卡片底 + 底部 1px 描边）。18 处手写 Border DockPanel.Dock=Top 的共用形态。 -->
  <Style Selector="Border.page-header">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="20,0"/>
  </Style>

  <!-- 三栏标题条统一高度（2026-09-24，48→40 收紧）：左树头（KoTree 切换器/FileTree 菜单）/ 中间页头
      （page-header）/ 右聊天头（ChatView）的底部分割线落在同一水平线。固定 40 高 + 垂直 padding 归零 +
      内容垂直居中（高度不随内容涨；常态内容上限=ChatView 32px 按钮，超 39 会裁——加高先改此处与
      page-header 同步）。 -->
  <Style Selector="Border.pane-head">
    <Setter Property="Height" Value="40"/>
  </Style>

  <!-- 预览切换眼睛（文档页 markdown「仅看解析/上下双栏」+ 资料库「仅看上栏/上下双栏」共用，
       2026-09-24 从 DocumentsEditorView 上移）。 -->
  <Style Selector="ToggleButton.preview-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="ToggleButton.preview-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.preview-toggle:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
  </Style>

  <!-- 列表空态外壳：卡片描边 + 圆角 + 居中（Automation/Rules/Mcp/Workflows/Experts/Skill/Trace/Chat 共 8 处曾逐行重复）。
       内层图标+标题+副标题因域而异留各 View——只抽重复的外壳/内层 StackPanel 布局。 -->
  <Style Selector="Border.empty-state">
    <Setter Property="Padding" Value="40"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.empty-state StackPanel">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Spacing" Value="8"/>
  </Style>

  <!-- ═══ mac 交通灯（自绘标题栏 macOS 专用：左上红黄绿三圆点，hover 显 ×/－/⤢）════
       圆点色是 macOS 固定语义色（不受主题影响）：红 #FF5F57 关闭、黄 #FEBC2E 最小化、绿 #28C840 最大化。
       符号 hover 才显——Selector: Button.mac-tl Path 默认隐藏，:pointerover 显。符号色用各圆点的深色变体，
       明暗主题都清晰（亮圆点 + 深符号）。 -->
  <Style Selector="Button.mac-tl">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>   <!-- 半径=6 → 12px 直径正圆 -->
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.mac-tl-close">
    <Setter Property="Background" Value="#FF5F57"/>
  </Style>
  <Style Selector="Button.mac-tl-min">
    <Setter Property="Background" Value="#FEBC2E"/>
  </Style>
  <Style Selector="Button.mac-tl-max">
    <Setter Property="Background" Value="#28C840"/>
  </Style>
  <!-- 圆点内符号：默认隐藏，hover 显 -->
  <Style Selector="Button.mac-tl Path">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button.mac-tl:pointerover Path">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <!-- 圆点背景 hover/pressed 保持纯 mac 圆点色（覆盖 Fluent Button 默认 hover/pressed 改背景） -->
  <Style Selector="Button.mac-tl-close:pointerover">
    <Setter Property="Background" Value="#FF5F57"/>
  </Style>
  <Style Selector="Button.mac-tl-close:pressed">
    <Setter Property="Background" Value="#FF5F57"/>
  </Style>
  <Style Selector="Button.mac-tl-min:pointerover">
    <Setter Property="Background" Value="#FEBC2E"/>
  </Style>
  <Style Selector="Button.mac-tl-min:pressed">
    <Setter Property="Background" Value="#FEBC2E"/>
  </Style>
  <Style Selector="Button.mac-tl-max:pointerover">
    <Setter Property="Background" Value="#28C840"/>
  </Style>
  <Style Selector="Button.mac-tl-max:pressed">
    <Setter Property="Background" Value="#28C840"/>
  </Style>
  <!-- 符号色：各圆点深色变体（亮圆点 + 深符号，明暗主题都清晰） -->
  <Style Selector="Button.mac-tl-close Path">
    <Setter Property="Fill" Value="#990000"/>
  </Style>
  <Style Selector="Button.mac-tl-min Path">
    <Setter Property="Fill" Value="#995700"/>
  </Style>
  <Style Selector="Button.mac-tl-max Path">
    <Setter Property="Fill" Value="#006500"/>
  </Style>

  <!-- ═══ 标题栏面板 toggle（VSCode 式功能按钮：终端/AI 右栏，交通灯旁）════
       透明底 + hover 浅灰圆角底（SurfaceHoverBrush），图标色由 XAML accented/灰双 Path 按状态切。 -->
  <Style Selector="Button.titlebar-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusXs}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.titlebar-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <!-- ═══ 分隔条分界线（区域拖动条）═══
       基础样式（静止透明 + hover 显 SplitterBrush）留给编辑器页等 XAML 声明的 GridSplitter；
       工作台区域分界走 **常显 hairline**（split-v / split-h，由 WorkspaceView.BuildSplit 按 Orientation 打 class）：
       静止 1px SplitterBrush 细线——既是区域边界（light 下 chat/终端/内容区同为纯白、纯靠背景对比完全看不到边界，
       2026-09-23 用户反馈后改 VSCode 式常显）也是拖拽把手的可视提示；hover 加粗 3px 转 AccentBrush；
       6px 全宽命中区不变（模板根 Panel 透明底）。自定义模板纯视觉——GridSplitter 拖拽逻辑在控件级，不受影响。 -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource SplitterBrush}"/>
  </Style>
  <!-- 列分隔（左右区域之间）→ 竖线 -->
  <Style Selector="GridSplitter.split-v">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                     Fill="{DynamicResource SplitterBrush}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.split-v:pointerover /template/ Rectangle#Line">
    <Setter Property="Width" Value="3"/>
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <!-- 行分隔（上下区域之间）→ 横线 -->
  <Style Selector="GridSplitter.split-h">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                     Fill="{DynamicResource SplitterBrush}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.split-h:pointerover /template/ Rectangle#Line">
    <Setter Property="Height" Value="3"/>
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
  </Style>

</Styles>
