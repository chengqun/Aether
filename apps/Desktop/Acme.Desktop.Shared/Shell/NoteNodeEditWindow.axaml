<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Shell"
        x:Class="Acme.Desktop.Shared.Shell.NoteNodeEditWindow"
        Title="节点属性"
        Width="460" Height="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Background="{DynamicResource ContentBgBrush}">

    <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <TextBlock x:Name="HeaderTitle" Text="📝 节点属性" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>

    <StackPanel Grid.Row="1" Spacing="4" Margin="20,16,20,8">
      <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBox Classes="input" Text="{Binding Name}" Watermark="节点名称" />
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="4" Margin="20,0,20,12">
      <TextBlock Text="类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox Classes="input"
                ItemsSource="{Binding TypeOptions}"
                SelectedItem="{Binding SelectedTypeOption}"
                IsEnabled="{Binding IsTypeEnabled}"
                ToolTip.Tip="类型创建后固定，如需更换请删除节点重建">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="*,12,*" Margin="20,0,20,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="语法(sql/python…)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Classes="input" Text="{Binding Syntax}" FontFamily="Cascadia Code,Consolas,monospace" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="标签(逗号分隔)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Classes="input" Text="{Binding Tags}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="5" Padding="20,12" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            VerticalAlignment="Bottom">
      <Grid ColumnDefinitions="*,8,Auto,8,Auto">
        <TextBlock Grid.Column="0" Text="名称必填；类型创建后不可改" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="取消" Click="OnCancelClick" Padding="20,8" />
        <Button Grid.Column="4" Content="保存" Classes="primary" Click="OnSaveClick" Padding="20,8" />
      </Grid>
    </Border>

  </Grid>
</Window>