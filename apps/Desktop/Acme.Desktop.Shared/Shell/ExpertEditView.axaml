<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acme.Shell"
             x:Class="Acme.Desktop.Shared.Shell.ExpertEditView">

  <UserControl.Styles>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Button Content="保存配置" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
              Classes="primary" HorizontalAlignment="Right" Padding="20,8"/>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="AccordionPanel" Spacing="2" Margin="10,6">

        <Expander x:Name="ExpBasic" Header="基本信息" IsExpanded="True">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Name}" PlaceholderText="专家名称"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="类别" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Category}" PlaceholderText="如 代码/分析"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="描述" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Description}"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpPrompt" Header="系统提示词" IsExpanded="False">
          <TextBox Text="{Binding SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="400" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"/>
        </Expander>

        <Expander x:Name="ExpModel" Header="模型与记忆" IsExpanded="False">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="记忆模式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox ItemsSource="{Binding MemoryModeOptions}" SelectedItem="{Binding SelectedMemoryModeOption}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="模型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModelOption}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding IsWindowVisible}">
              <TextBlock Text="窗口大小" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding MaxHistory}" Minimum="1" Maximum="200" FormatString="0"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpSample" Header="采样与输出" IsExpanded="False">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="Top P" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="最大输出 tokens" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1" Maximum="128000" FormatString="0"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="响应格式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox ItemsSource="{Binding ResponseFormatOptions}" SelectedItem="{Binding SelectedResponseFormatOption}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="扩展能力" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <WrapPanel>
                <CheckBox Content="Web搜索" IsChecked="{Binding EnableWebSearch}" Margin="0,0,12,2"/>
                <CheckBox Content="文件记忆" IsChecked="{Binding EnableFileMemory}" Margin="0,0,12,2"/>
                <CheckBox Content="待办" IsChecked="{Binding EnableTodoProvider}" Margin="0,0,12,2"/>
                <CheckBox Content="工具审批" IsChecked="{Binding RequireToolApproval}" Margin="0,0,12,2"/>
                <CheckBox Content="技能" IsChecked="{Binding EnableAgentSkills}" Margin="0,0,12,2"/>
                <CheckBox Content="Agent模式" IsChecked="{Binding EnableAgentModeProvider}" Margin="0,0,12,2"/>
                <CheckBox Content="遥测" IsChecked="{Binding EnableOpenTelemetry}" Margin="0,0,12,2"/>
                <CheckBox Content="长期记忆" IsChecked="{Binding EnableLongTermMemory}" Margin="0,0,12,2"/>
                <CheckBox Content="MCP工具" IsChecked="{Binding EnableMcpTools}" Margin="0,0,12,2"/>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpSkills" Header="技能" IsExpanded="False">
          <ItemsControl ItemsSource="{Binding Skills}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <StackPanel Spacing="4" Margin="0,4,0,0">
          <TextBlock Text="工具" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <ItemsControl ItemsSource="{Binding ToolCategories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander Margin="0,2" IsExpanded="False">
                  <Expander.Header>
                    <CheckBox IsChecked="{Binding IsAllSelected}">
                      <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"/>
                    </CheckBox>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Tools}" Margin="20,2,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontSize="11"/>
                            <ComboBox ItemsSource="{x:Static vm:ToolOption.ApprovalLevelOptions}"
                                      SelectedValue="{Binding ApprovalLevel}"
                                      SelectedValueBinding="{Binding Value}"
                                      FontSize="9" MinWidth="54" Padding="4,1">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" FontSize="10" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                              <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" FontSize="10" />
                                </DataTemplate>
                              </ComboBox.SelectionBoxItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11" IsVisible="{Binding HasError}"/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
