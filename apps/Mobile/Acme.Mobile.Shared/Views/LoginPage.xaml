<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Mobile.Shared.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="登录">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

            <VerticalStackLayout Spacing="4" Margin="0,0,0,16">
                <Label Text="Aether" FontSize="30" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                <Label Text="登录到你的工作台" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="服务器地址" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Entry x:Name="ServerEntry" Placeholder="https://your-server.com"
                               Keyboard="Url" ReturnType="Next" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="用户名" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Entry Text="{Binding Username}" Placeholder="用户名" ReturnType="Next" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="密码" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Entry Text="{Binding Password}" Placeholder="密码" IsPassword="True" ReturnType="Go"
                               ReturnCommand="{Binding LoginCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                   FontSize="13" HorizontalOptions="Center" />

            <Button Text="登录" Style="{StaticResource PrimaryButton}"
                    Clicked="OnLoginClicked"
                    IsEnabled="{Binding IsLoginEnabled}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
