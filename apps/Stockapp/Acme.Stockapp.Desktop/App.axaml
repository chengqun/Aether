<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acme.Stockapp.Desktop.ViewModels"
             xmlns:views="using:Acme.Stockapp.Desktop.Views"
             x:Class="Acme.Stockapp.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <StyleInclude Source="avares://Acme.Desktop.Shared/Themes/SharedTheme.axaml"/>
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:CtpViewModel">
            <views:FuturesView />
        </DataTemplate>
        <DataTemplate DataType="vm:TradingViewModel">
            <views:TradingView />
        </DataTemplate>
        <DataTemplate DataType="vm:StockTradingViewModel">
            <views:StockTradingView />
        </DataTemplate>
    </Application.DataTemplates>

</Application>
