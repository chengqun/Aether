<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Acme.Desktop.Workbench"
             xmlns:wsw="using:Acme.Desktop.Workbench.Workspace"
             x:Class="Acme.Stockapp.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <!-- ColorPicker 控件主题（ColorView 光谱/HSV/RGB/hex 模板）。不引则 ColorView 无 ControlTheme → 不渲染光谱。同 AvaloniaEdit 模式。 -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
        <StyleInclude Source="avares://Acme.Desktop.Shared/Themes/SharedTheme.axaml"/>
    </Application.Styles>

    <Application.DataTemplates>
        <!-- Workspace 决定布局：ActiveWorkspace(WorkspaceViewModel) → WorkspaceView 遍历 LayoutNode 建视觉树。
             租户页（期货/回测/股票）视图改由 StockappViewContributor 经 IViewRegistry 注册，不再用 DataTemplate 映射。 -->
        <DataTemplate DataType="wsw:WorkspaceViewModel">
            <wb:WorkspaceView />
        </DataTemplate>
    </Application.DataTemplates>

</Application>
