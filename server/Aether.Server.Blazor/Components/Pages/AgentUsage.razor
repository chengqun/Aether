@page "/agent-usage"
@inherits AbpComponentBase
@using Aether.Server.Application.Contracts.DTOs.AgentUsage
@using Aether.Server.Application.Contracts.Services.AgentUsage
@inject IAgentUsageAppService AgentUsageAppService

<PageTitle>Agent 使用统计</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h3 class="mb-3"><i class="fas fa-chart-bar me-2"></i>Agent 使用统计</h3>

            <!-- 筛选栏 -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-end gap-3">
                        <div class="form-group mb-0">
                            <label class="form-label">Agent 名称</label>
                            <select class="form-control" @bind="filterAgentName">
                                <option value="">全部</option>
                                @foreach (var name in agentNames)
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">开始时间</label>
                            <input type="date" class="form-control" @bind="filterStartDate" />
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">结束时间</label>
                            <input type="date" class="form-control" @bind="filterEndDate" />
                        </div>
                        <button type="button" class="btn btn-primary" @onclick="LoadData">
                            <i class="fas fa-search"></i> 查询
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetFilters">
                            <i class="fas fa-undo"></i> 重置
                        </button>
                    </div>
                </div>
            </div>

            <!-- 汇总表 -->
            @if (summaryData.Any())
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">使用汇总</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Agent 名称</th>
                                        <th>类型</th>
                                        <th>调用次数</th>
                                        <th>输入 Tokens</th>
                                        <th>输出 Tokens</th>
                                        <th>总 Tokens</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in summaryData)
                                    {
                                        <tr>
                                            <td>@item.AgentName</td>
                                            <td><span class="badge badge-info">@GetAgentKindName(item.AgentKind)</span></td>
                                            <td>@item.CallCount</td>
                                            <td>@item.TotalInputTokens.ToString("N0")</td>
                                            <td>@item.TotalOutputTokens.ToString("N0")</td>
                                            <td><strong>@item.TotalTokens.ToString("N0")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-active">
                                        <td><strong>合计</strong></td>
                                        <td></td>
                                        <td><strong>@summaryData.Sum(s => s.CallCount)</strong></td>
                                        <td><strong>@summaryData.Sum(s => s.TotalInputTokens).ToString("N0")</strong></td>
                                        <td><strong>@summaryData.Sum(s => s.TotalOutputTokens).ToString("N0")</strong></td>
                                        <td><strong>@summaryData.Sum(s => s.TotalTokens).ToString("N0")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- 明细表 -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">使用明细</h5>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-3"><div class="spinner-border" role="status"></div></div>
                    }
                    else if (detailData.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm">
                                <thead>
                                    <tr>
                                        <th>用户</th>
                                        <th>Agent</th>
                                        <th>类型</th>
                                        <th>会话ID</th>
                                        <th>输入 Tokens</th>
                                        <th>输出 Tokens</th>
                                        <th>总 Tokens</th>
                                        <th>时间</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in detailData)
                                    {
                                        <tr>
                                            <td>@item.UserName</td>
                                            <td>@item.AgentName</td>
                                            <td><span class="badge badge-info">@GetAgentKindName(item.AgentKind)</span></td>
                                            <td><code>@item.SessionId.ToString()[..8]...</code></td>
                                            <td>@item.InputTokens.ToString("N0")</td>
                                            <td>@item.OutputTokens.ToString("N0")</td>
                                            <td>@item.TotalTokens.ToString("N0")</td>
                                            <td>@item.CreationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-chart-bar" style="font-size: 32px;"></i>
                            <p class="mt-2">暂无使用记录</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>