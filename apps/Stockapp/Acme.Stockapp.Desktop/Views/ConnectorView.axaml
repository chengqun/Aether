<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Acme.Desktop.Shared.Shell.Converters"
             x:Class="Acme.Stockapp.Desktop.Views.ConnectorView"
             Background="Transparent">

  <StackPanel Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Top">

    <!-- CTP 期货交易 卡片 -->
    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="16" Padding="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="10" DataContext="{Binding Ctp}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="44" Height="44" CornerRadius="22" Background="#E8F5E9">
              <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="CTP 期货交易" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="连接期货柜台，供交易/行情工具调用" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>

          <Border CornerRadius="6" Padding="10,6" Background="#FFF3E0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8"
                       Fill="{Binding IsConnected, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
              <TextBlock Text="{Binding StatusText}" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <Button Click="OnCtpSettingsClick"
                  Width="32" Height="32" CornerRadius="16"
                  Background="{DynamicResource AccentBrush}" Foreground="White"
                  BorderThickness="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  HorizontalAlignment="Right">
            <TextBlock Text="+" Foreground="White" FontSize="20" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 同花顺股票交易 卡片 -->
    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="16" Padding="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="10" DataContext="{Binding Ths}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="44" Height="44" CornerRadius="22" Background="#E3F2FD">
              <TextBlock Text="💹" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="同花顺股票交易" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="连接同花顺下单客户端，供股票下单/撤单/持仓工具调用" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>

          <Border CornerRadius="6" Padding="10,6" Background="#FFF3E0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8"
                       Fill="{Binding IsConnected, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
              <TextBlock Text="{Binding StatusText}" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <Button Click="OnThsSettingsClick"
                  Width="32" Height="32" CornerRadius="16"
                  Background="{DynamicResource AccentBrush}" Foreground="White"
                  BorderThickness="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  HorizontalAlignment="Right">
            <TextBlock Text="+" Foreground="White" FontSize="20" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
