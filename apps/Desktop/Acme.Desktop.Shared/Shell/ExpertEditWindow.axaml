<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Acme.Desktop.Shared.Shell.ExpertEditWindow"
        Title="专家配置"
        Width="520" Height="820"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

    <!-- 标题 -->
    <Border Grid.Row="0" Padding="20,14">
      <TextBlock Text="{Binding WindowTitle}" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>

    <!-- 名称 + 类别 + 描述 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,12,*,12,*" Margin="20,8,20,8">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Name}" PlaceholderText="输入专家名称" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="类别" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Category}" PlaceholderText="如 普通对话/股票分析/代码" />
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="4">
        <TextBlock Text="描述" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Description}" />
      </StackPanel>
    </Grid>

    <!-- 系统提示词 -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="20,0,20,12">
      <TextBlock Text="系统提示词" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBox Text="{Binding SystemPrompt}"
               AcceptsReturn="True" TextWrapping="Wrap" Height="120" />
    </StackPanel>

    <!-- 记忆模式 + 模型 + 窗口大小 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,12,*,12,Auto" Margin="20,0,20,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="记忆模式" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding MemoryModeOptions}"
                  SelectedItem="{Binding SelectedMemoryModeOption}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Display}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="模型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding AvailableModels}"
                  SelectedItem="{Binding SelectedModelOption}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="4" Width="120"
                  IsVisible="{Binding IsWindowVisible}">
        <TextBlock Text="窗口大小" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <NumericUpDown Value="{Binding MaxHistory}"
                       Minimum="1" Maximum="200" FormatString="0" />
      </StackPanel>
    </Grid>

    <!-- 采样 / 输出 + 扩展能力 -->
    <StackPanel Grid.Row="4" Margin="20,0,20,12" Spacing="10">
      <Grid ColumnDefinitions="*,12,*,12,2*">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Top P" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <NumericUpDown Value="{Binding TopP}" Minimum="0" Maximum="1"
                         Increment="0.1" FormatString="0.0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="最大输出 tokens" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1" Maximum="128000"
                         FormatString="0" />
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="4">
          <TextBlock Text="响应格式" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <ComboBox ItemsSource="{Binding ResponseFormatOptions}"
                    SelectedItem="{Binding SelectedResponseFormatOption}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="4">
        <TextBlock Text="扩展能力（高级，默认关闭）" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <WrapPanel>
          <CheckBox Content="Web 搜索" IsChecked="{Binding EnableWebSearch}" Margin="0,0,16,4" />
          <CheckBox Content="文件记忆" IsChecked="{Binding EnableFileMemory}" Margin="0,0,16,4" />
          <CheckBox Content="待办" IsChecked="{Binding EnableTodoProvider}" Margin="0,0,16,4" />
          <CheckBox Content="技能" IsChecked="{Binding EnableAgentSkills}" Margin="0,0,16,4" />
          <CheckBox Content="Agent 模式" IsChecked="{Binding EnableAgentModeProvider}" Margin="0,0,16,4" />
          <CheckBox Content="遥测(OTel)" IsChecked="{Binding EnableOpenTelemetry}" Margin="0,0,16,4" />
        </WrapPanel>
      </StackPanel>
    </StackPanel>

    <!-- 工具区（占满剩余空间） -->
    <Grid Grid.Row="5" Margin="20,0,20,12" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Text="工具（按类别勾选启用）" FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="10,6">
        <ScrollViewer Padding="0">
          <ItemsControl ItemsSource="{Binding ToolCategories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander Margin="0,4" IsExpanded="False">
                  <Expander.Header>
                    <CheckBox IsChecked="{Binding IsAllSelected}">
                      <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </CheckBox>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Tools}" Margin="24,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 底部按钮 -->
    <Border Grid.Row="6" Padding="20,12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="取消" Command="{Binding CancelCommand}" Padding="20,8"/>
        <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                Padding="20,8"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
