<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MAUI class library (shared by Qifu.Mobile + Stockapp.Mobile tenant hosts).
         Tenant hosts are the Exe projects; this lib holds Views/Services/Converters/Resources + AddMobileCommon. -->
    <!-- TFM 平台条件化（2026-09-03 二修 NETSDK1178）：restore 会评估项目图全量 TargetFrameworks，
         Linux（CI 的 Build Android job）上 ios TFM 无 workload pack → NETSDK1178；且旧写法反向条件
         （ios 无条件、android 被 !linux 排除）让本库在 Linux 上只剩 ios，租户 Exe 的 -f net10.0-android
         无从构建。现 android 无条件、ios 仅非 Linux 声明。与 Stockapp.Mobile/Qifu.Mobile 同修。 -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Acme.Mobile.Shared</RootNamespace>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" />
    <PackageReference Include="Indiko.Maui.Controls.Markdown" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images / Fonts / Raw assets live in the shared lib; MAUI picks them up from referenced libs. -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\chat.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\contact.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\discovery.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\me.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\ai.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\microphone.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\keyboard.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\camera.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\right_arrow.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\addfriend.svg" BaseSize="24,24" />
    <MauiImage Update="Resources\Images\addfriend_dark.svg" BaseSize="24,24" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

