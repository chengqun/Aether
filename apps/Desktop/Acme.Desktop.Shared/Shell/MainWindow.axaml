<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Acme.Desktop.Shared.Shell.MainWindow"
        Title="Aether 桌面"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="Auto,*">

    <!-- ═══ 展开态侧边栏（220px，图标+文字） ═══ -->
    <Border Grid.Column="0" Width="220" IsVisible="{Binding IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
          <Button Command="{Binding ToggleSidebarCommand}" Classes="settings-nav" ToolTip.Tip="收起侧边栏">
            <TextBlock Text="☰" FontSize="15"/>
          </Button>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="settings-nav" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        IsEnabled="{Binding !IsCurrent}" ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Icon}" FontSize="16"/>
                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="最近会话（待实现）" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,14,0,0"/>

        <Button Grid.Row="2" Classes="account-chip" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="{Binding UserName}" IsEnabled="False"/>
              <MenuItem Header="设置" IsEnabled="False" ToolTip.Tip="（待实现）"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding UserName}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 收起态侧边栏（48px，纯图标 rail） ═══ -->
    <Border Grid.Column="0" Width="48" IsVisible="{Binding !IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
          <Button Command="{Binding ToggleSidebarCommand}" Classes="nav-rail" ToolTip.Tip="展开侧边栏">
            <TextBlock Text="☰" FontSize="15"/>
          </Button>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="nav-rail" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        IsEnabled="{Binding !IsCurrent}" ToolTip.Tip="{Binding Title}">
                  <TextBlock Text="{Binding Icon}" FontSize="16"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Button Grid.Row="2" Classes="account-rail" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="{Binding UserName}" IsEnabled="False"/>
              <MenuItem Header="设置" IsEnabled="False" ToolTip.Tip="（待实现）"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 内容区（骨架占位；功能 phase 注入真实 View） ═══ -->
    <Grid Grid.Column="1" Background="{DynamicResource ContentBgBrush}">
      <TextBlock Text="{Binding CurrentPageLabel}"
                 FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

  </Grid>
</Window>
