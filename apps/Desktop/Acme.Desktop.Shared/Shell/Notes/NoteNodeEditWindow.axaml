<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Desktop.Mvvm"
        x:Class="Acme.Desktop.Shared.Shell.NoteNodeEditWindow"
        Title="节点属性"
        Width="460" Height="560" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="RadioButton.icon-pick">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    </Style>
    <Style Selector="RadioButton.icon-pick:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="RadioButton.icon-pick:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Background="{DynamicResource ContentBgBrush}">

    <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <TextBlock x:Name="HeaderTitle" Text="节点属性" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>

    <StackPanel Grid.Row="1" Spacing="4" Margin="20,16,20,8">
      <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBox Classes="input" Text="{Binding Name}" PlaceholderText="节点名称" />
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="4" Margin="20,0,20,12">
      <TextBlock Text="类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox Classes="input"
                ItemsSource="{Binding TypeOptions}"
                SelectedItem="{Binding SelectedTypeOption}"
                IsEnabled="{Binding IsTypeEnabled}"
                ToolTip.Tip="类型创建后固定，如需更换请删除节点重建">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="*,12,*" Margin="20,0,20,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="语法" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox Classes="input"
                  ItemsSource="{Binding SyntaxOptions}"
                  SelectedItem="{Binding SelectedSyntaxOption}"
                  ToolTip.Tip="markdown=渲染预览；sql=代码高亮；text=纯文本">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{Binding PathData}" Stretch="Uniform" Width="16" Height="16"
                      Fill="{Binding Color}" IsVisible="{Binding IsFill}" VerticalAlignment="Center"/>
                <Path Data="{Binding PathData}" Stretch="Uniform" Width="16" Height="16"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding Color}" IsVisible="{Binding !IsFill}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="标签(逗号分隔)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Classes="input" Text="{Binding Tags}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="20,0,20,12">
      <TextBlock Grid.Row="0" Text="图标" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding IconOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Classes="icon-pick" GroupName="Icon"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           ToolTip.Tip="{Binding Display}">
                <StackPanel Spacing="2" HorizontalAlignment="Center" Width="34">
                  <Path Data="{Binding PathData}" Stretch="Uniform" Width="16" Height="16"
                        Fill="{Binding Color}" IsVisible="{Binding IsFill}" HorizontalAlignment="Center"/>
                  <Path Data="{Binding PathData}" Stretch="Uniform" Width="16" Height="16"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding Color}" IsVisible="{Binding !IsFill}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding Display}" FontSize="9"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="5" Padding="20,12" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            VerticalAlignment="Bottom">
      <Grid ColumnDefinitions="*,8,Auto,8,Auto">
        <TextBlock Grid.Column="0" Text="名称必填；类型创建后不可改" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="取消" Click="OnCancelClick" Padding="20,8" />
        <Button Grid.Column="4" Content="保存" Classes="primary" Click="OnSaveClick" Padding="20,8" />
      </Grid>
    </Border>

  </Grid>
</Window>