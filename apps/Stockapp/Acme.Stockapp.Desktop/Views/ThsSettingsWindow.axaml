<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Acme.Desktop.Shared.Shell.Converters"
        x:Class="Acme.Stockapp.Desktop.Views.ThsSettingsWindow"
        Title="同花顺连接设置" Width="520" Height="460"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBgBrush}"
        SystemDecorations="Full" ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">

    <!-- 状态条 -->
    <Border Grid.Row="0" CornerRadius="6" Padding="12,8" Background="#FFF3E0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                 Fill="{Binding IsConnected, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
        <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="xiadan.exe 路径" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding ClientExecutablePath}" Watermark="C:\同花顺\xiadan.exe" />
        <TextBlock Text="留空则只能连接已运行的客户端（手动打开同花顺并登录后点连接）"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="窗口标题" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding ClientWindowTitle}" Watermark="网上股票交易系统5.0" />
        <TextBlock Text="同花顺下单客户端主窗口标题（FindWindow ByName 用），通常无需改"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <!-- 操作按钮 + 关闭 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="启动客户端" Command="{Binding LaunchCommand}"
              IsEnabled="{Binding !IsBusy}" Padding="14,6" />
      <Button Content="连接" Command="{Binding ConnectCommand}"
              IsEnabled="{Binding !IsBusy}" Padding="14,6" />
      <Button Content="断开" Command="{Binding DisconnectCommand}"
              IsEnabled="{Binding !IsBusy}" Padding="14,6" />
      <Button Content="关闭" Click="OnCloseClick" Padding="18,6" Margin="12,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
