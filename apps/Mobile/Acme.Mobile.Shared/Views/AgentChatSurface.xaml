<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Acme.Mobile.Shared.Views.AgentChatSurface"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:md="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
    xmlns:model="clr-namespace:Acme.Mobile.Mvvm.Models;assembly=Acme.Mobile.Mvvm"
    xmlns:views="clr-namespace:Acme.Mobile.Shared.Views"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters">

    <ContentView.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:MarkdownTableFillConverter x:Key="MarkdownTableFill" />
        <!-- 用户消息：右侧绿色气泡。根=Grid(占满整行 cell 宽)+内层 Border(End) 右对齐——
             同 DesktopAssistantPage.MineTemplate 修法（镜像桌面端 ChatMessagesView IsUserText 分支）。
             旧版根=HorizontalStackLayout(End) 按内容宽收缩，iOS CollectionView cell 只分配内容宽、
             End 无多余空间可推 → 短消息贴左「跑前面」、长消息测量不一致「被挡住」。Grid 拿 cell 全宽，可靠右对齐。 -->
        <DataTemplate x:Key="UserTextTemplate" x:DataType="model:ChatMessageItem">
            <Grid Margin="12,4" HorizontalOptions="Fill">
                <Border HorizontalOptions="End" BackgroundColor="{StaticResource BubbleMine}" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12,8" MaximumWidthRequest="280">
                    <Label Text="{Binding Content}" TextColor="{StaticResource TextPrimary}" FontSize="15" LineBreakMode="WordWrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 助手消息：占满宽度的气泡 + Markdown（手机端尽量多显示内容）。
             流式时（IsStreaming）在气泡尾部追加「生成中」指示点（ActivityIndicator），生成结束折叠。 -->
        <DataTemplate x:Key="AssistantTextTemplate" x:DataType="model:ChatMessageItem">
            <Border Margin="12,4" HorizontalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BubbleOther}, Dark={StaticResource BubbleOtherDark}}"
                    StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12,8">
                <VerticalStackLayout Spacing="6">
                    <md:MarkdownView MarkdownText="{Binding Content, Converter={StaticResource MarkdownTableFill}}" Theme="{StaticResource AppMarkdownTheme}" UseAppTheme="True" />
                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsStreaming}">
                        <ActivityIndicator IsRunning="True" WidthRequest="14" HeightRequest="14"
                                           Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource StatusSuccessDark}}"
                                           HorizontalOptions="Start" VerticalOptions="Center" />
                        <Label Text="正在生成…" FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- 工具步：单卡（call+result 合并），对齐桌面紧凑摘要 + 点按展开 + 类型化结果渲染。
             折叠态一行：VerbIcon + ToolName + MainArg(截断) + ✓ + ▸；完成且非展开时显 → 结果预览。
             展开态：输入(JSON) + 结果按 ResultKind 分支（text/code/error/table/json）。点卡片切 IsExpanded。 -->
        <DataTemplate x:Key="ToolTemplate" x:DataType="model:ChatMessageItem">
            <Border Margin="12,2" HorizontalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BubbleTool}, Dark={StaticResource BubbleToolDark}}"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <!-- 折叠态一行摘要 -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="{Binding VerbIcon}" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ToolName}" FontSize="13" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding MainArg}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="✓" FontSize="12" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource StatusSuccess}, Dark={StaticResource StatusSuccessDark}}"
                                   IsVisible="{Binding IsToolCompleted}" />
                            <Label Grid.Column="4" Text="▸" FontSize="10" VerticalOptions="Center" IsVisible="{Binding !IsExpanded}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Grid.Column="4" Text="▾" FontSize="10" VerticalOptions="Center" IsVisible="{Binding IsExpanded}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <!-- 折叠态结果预览（完成 + 有预览 + 未展开） -->
                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasResultPreview}">
                            <Label Text="→" FontSize="11" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding ResultPreview}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </HorizontalStackLayout>
                        <!-- 展开态：输入 + 类型化结果 -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsExpanded}">
                            <VerticalStackLayout Spacing="2" IsVisible="{Binding HasInputDetail}">
                                <Label Text="输入" FontSize="10"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding InputDetail}" FontSize="11" LineBreakMode="CharacterWrap"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" IsVisible="{Binding IsToolCompleted}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="结果" FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label FontSize="10" IsVisible="{Binding IsResultLong}"
                                           Text="{Binding ResultLineCount, StringFormat='· {0} 行'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>
                                <!-- text -->
                                <Label Text="{Binding ResultText}" FontSize="12" LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       IsVisible="{Binding IsResultText}" />
                                <!-- code（等宽/限高） -->
                                <Label Text="{Binding ResultText}" FontSize="11" LineBreakMode="CharacterWrap" MaxLines="14"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       IsVisible="{Binding IsResultCode}" />
                                <!-- error（红） -->
                                <Label Text="{Binding ResultText}" FontSize="12" LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                       IsVisible="{Binding IsResultError}" />
                                <!-- table / json（mono JSON 兜底） -->
                                <Label Text="{Binding OutputDetail}" FontSize="11" LineBreakMode="CharacterWrap" MaxLines="14"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       IsVisible="{Binding IsResultTable}" />
                                <Label Text="{Binding OutputDetail}" FontSize="11" LineBreakMode="CharacterWrap" MaxLines="14"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       IsVisible="{Binding IsResultJson}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- 思考段：ItemType=text + IsReasoning（TextReasoningContent）。对齐桌面可折叠 pill：
             流式"思考中…"默认展开(切 IsStreamingExpanded)；完成"思考 · Xs"默认折叠(切 IsExpanded)。
             点卡片切换；body 展开时显 Content 全文。 -->
        <DataTemplate x:Key="ReasoningTemplate" x:DataType="model:ChatMessageItem">
            <Border Margin="12,2" HorizontalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BubbleThinking}, Dark={StaticResource BubbleThinkingDark}}"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleReasoningCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <!-- pill 头 -->
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="思考中…" FontSize="12" FontAttributes="Italic" IsVisible="{Binding IsStreaming}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="思考" FontSize="12" IsVisible="{Binding !IsStreaming}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding ElapsedText, StringFormat='· {0}'}" FontSize="11" IsVisible="{Binding !IsStreaming}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="▸" FontSize="10" IsVisible="{Binding !IsReasoningExpanded}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="▾" FontSize="10" IsVisible="{Binding IsReasoningExpanded}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </HorizontalStackLayout>
                        <!-- body：思考全文，展开时可见 -->
                        <Label Text="{Binding Content}" FontSize="12" FontAttributes="Italic" LineBreakMode="WordWrap" MaxLines="18"
                               IsVisible="{Binding IsReasoningExpanded}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- 审批卡：ItemType=approval，runtime-only 不持久化。Content 带状态图标+工具名（⏳等待/✅批准/❌拒绝）。
             修病灶 4：审批卡此前无模板落到 default 不渲染，现独立模板可见。 -->
        <DataTemplate x:Key="ApprovalTemplate" x:DataType="model:ChatMessageItem">
            <Border Margin="12,2" HorizontalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BubbleThinking}, Dark={StaticResource BubbleThinkingDark}}"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                <Label Text="{Binding Content}" FontSize="13" FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Border>
        </DataTemplate>

        <views:ChatMessageTemplateSelector x:Key="ChatMessageSelector"
            UserTextTemplate="{StaticResource UserTextTemplate}"
            AssistantTextTemplate="{StaticResource AssistantTextTemplate}"
            ToolTemplate="{StaticResource ToolTemplate}"
            ReasoningTemplate="{StaticResource ReasoningTemplate}"
            ApprovalTemplate="{StaticResource ApprovalTemplate}" />
    </ContentView.Resources>

    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="MessagesList"
                        Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        ItemTemplate="{StaticResource ChatMessageSelector}"
                        ItemSizingStrategy="MeasureAllItems"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- 输入栏（AI tab 设 ShowInputBar=False 隐藏，由页面自带选择条+输入栏） -->
        <Border x:Name="InputBar" Grid.Row="1" Padding="8" BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="MessageEntry"
                       Text="{Binding MessageText}"
                       Placeholder="输入消息…"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendMessageCommand}" />
                <Button Grid.Column="1" Text="发送" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding CanSendMessage}" Padding="16,8" />
            </Grid>
        </Border>
    </Grid>

</ContentView>
