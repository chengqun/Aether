<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Mobile.Shared.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,Auto" Padding="32" VerticalOptions="Center">
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" HorizontalOptions="Center" Spacing="16">
            <Border WidthRequest="96" HeightRequest="96"
                    BackgroundColor="{DynamicResource Primary}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    HorizontalOptions="Center">
                <Label Text="Æ" TextColor="White" FontSize="52" FontFamily="OpenSansSemibold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Aether" FontSize="26" FontFamily="OpenSansSemibold"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding ShowProgress}"
                           IsVisible="{Binding ShowProgress}" Color="{DynamicResource Primary}"
                           HorizontalOptions="Center" Margin="0,24,0,8" />
        <Label Grid.Row="2" Text="{Binding StatusMessage}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
               FontSize="13" HorizontalOptions="Center" />
    </Grid>

</ContentPage>
