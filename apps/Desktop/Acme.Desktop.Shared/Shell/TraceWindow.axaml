<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Desktop.Shared.Shell.TraceWindow"
        Title="运行 Trace"
        Width="720" Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="Border.trace-card">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusXs}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="Border.trace-card.error">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
    </Style>
    <Style Selector="ToggleButton.compact">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusXs}"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- 顶部工具栏 -->
    <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBox Text="{Binding FilterText}" PlaceholderText="筛选（agent / 事件关键词）"
                   Padding="8,4" FontSize="12" MinWidth="180"/>
          <ToggleButton Content="仅错误" IsChecked="{Binding ShowErrorsOnly}" Classes="compact" Margin="4,0,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding VisibleTraces.Count, StringFormat={}{0} 条}"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0"/>
        <Button Grid.Column="2" Command="{Binding RefreshCommand}" Classes="compact" Margin="6,0,0,0" ToolTip.Tip="刷新"><Path Data="{x:Static shell:Codicons.Refresh}" Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></Button>
        <Button Grid.Column="3" Content="导出" Click="OnExportClick" Classes="compact" Margin="6,0,0,0" ToolTip.Tip="导出 JSON"/>
        <Button Grid.Column="4" Content="清空" Command="{Binding ClearCommand}" Classes="compact" Margin="6,0,0,0"/>
      </Grid>
    </Border>

    <ScrollViewer Padding="16,8">
      <Panel>
        <!-- 空状态 -->
        <Border Classes="empty-state" IsVisible="{Binding !VisibleTraces.Count}"
                VerticalAlignment="Top" Margin="0,40,0,0">
          <StackPanel Spacing="6">
            <Path Data="{x:Static shell:Codicons.Inbox}" Stretch="Uniform" Width="28" Height="28" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="暂无运行 Trace" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="专家编辑器 → 遥测 → 开启 OpenTelemetry 后，每轮 agent 运行会在这里显示。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- trace 列表 -->
        <ItemsControl ItemsSource="{Binding VisibleTraces}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="trace-card error" Classes.error="{Binding IsError}">
                <Expander IsExpanded="{Binding IsError}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontSize="14"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                        <TextBlock Text="{Binding AgentId}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Mode, StringFormat={}[{0}]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsVisible="{Binding Mode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                          <Path Data="{x:Static shell:Codicons.Tools}" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding ToolCallCount}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                      <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </Grid>
                  </Expander.Header>
                  <StackPanel Spacing="2" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="{Binding ConversationId, StringFormat={}conv: {0:N}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Events}" Margin="0,4,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</Window>
