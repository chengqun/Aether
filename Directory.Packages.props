<Project>

  <!-- 中央包版本管理（CPM）：所有非 externals 项目的 NuGet 版本唯一权威来源。
       各 .csproj 的 <PackageReference> 不再带 Version 属性（NU1008）。
       externals/（Lean / MAF / FlaUI-MCP / Ctp.Net.Core）经 externals/Directory.Build.props 守卫隔离，不适用 CPM。
       版本策略：Microsoft.Extensions.Logging.Abstractions / DependencyInjection(.Abstractions) pin 10.0.12、
       Microsoft.Extensions.AI.Abstractions pin 10.10.1（MAF 1.24 传递链要求——10.10.1 修 MEAI.OpenAI 带工具 Responses
       调用的 TypeLoadException，仅 Abstractions/MEAI.OpenAI 发了 10.10.1，MEAI 本体仍 10.10.0）；
       Microsoft.CodeAnalysis.CSharp 4.13.0（对齐 Desktop.Shared 的 Workspaces 4.13.0，替代旧 4.8.0）。 -->
  <ItemGroup>
    <PackageVersion Include="AlphaOmega.ApkReader" Version="2.0.10" />
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
