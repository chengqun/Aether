<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Acme.AppAutomation.McpClientHost</RootNamespace>
    <!-- MCP 集成是 alpha 预发布；与 Aether.AI.Mcp 同源隔离在本项目（opt-in，宿主按需引）。 -->
    <NoWarn>$(NoWarn);NU5104;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本与 Aether.AI.Mcp → Microsoft.Agents.AI.Mcp 的传递依赖一致（nuspec 确认 1.2.0），避免版本冲突。 -->
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <!-- AIFunction / AIFunctionArguments（复用 McpServerRegistry 的工具调用）；Abstractions 稳定包。 -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只需 IMcpToolInvoker 端口（Domain 纯净，无 MCP 依赖）。 -->
    <ProjectReference Include="..\Acme.AppAutomation.Domain\Acme.AppAutomation.Domain.csproj" />
    <!-- MCP 稳定契约（McpServerConfig + IMcpServerRegistry + McpServerEntry 等，定义在 Abstractions）——
         复用 stdio/http 解析 + 注入已连 registry，与 McpServerRegistry 同构。零 alpha 依赖，是 business/ 引 Aether.AI.* 的唯一合法出口。 -->
    <ProjectReference Include="..\..\..\src\Aether.AI.Abstractions\Aether.AI.Abstractions.csproj" />
  </ItemGroup>

</Project>
