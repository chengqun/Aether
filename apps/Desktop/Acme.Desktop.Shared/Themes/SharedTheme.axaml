<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia">

  <!-- 设计 Token：配色（浅色科技风），从 AlphaAgent App.axaml 搬运 -->
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="AccentColor">#5B5FC7</Color>
      <Color x:Key="AccentHoverColor">#4A4EAE</Color>
      <Color x:Key="AccentLightColor">#7B7FEB</Color>
      <Color x:Key="DangerColor">#EF4444</Color>
      <Color x:Key="SidebarBg">#F7F7F8</Color>
      <Color x:Key="SidebarHoverBg">#EDEDEF</Color>
      <Color x:Key="SidebarActiveBg">#5B5FC7</Color>
      <Color x:Key="SidebarIconColor">#6B6B70</Color>
      <Color x:Key="SidebarText">#2D2D32</Color>
      <Color x:Key="ContentBg">#FFFFFF</Color>
      <Color x:Key="CardBg">#FFFFFF</Color>
      <Color x:Key="BorderColor">#E8E8EC</Color>
      <Color x:Key="TextPrimary">#1A1A1F</Color>
      <Color x:Key="TextSecondary">#6B6B70</Color>
      <Color x:Key="UserBubbleBg">#5B5FC7</Color>
      <Color x:Key="AgentBubbleBg">#F7F7F8</Color>
      <Color x:Key="ToolCallColor">#EEF0FB</Color>
      <Color x:Key="ToolCallBorderColor">#D1D5F0</Color>
      <Color x:Key="ToolCallTextColor">#3D40B5</Color>
      <Color x:Key="ToolResultColor">#ECF8F0</Color>
      <Color x:Key="ToolResultBorderColor">#C2E8CF</Color>
      <Color x:Key="ToolResultTextColor">#1F8A4C</Color>

      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
      <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
      <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverBg}"/>
      <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveBg}"/>
      <SolidColorBrush x:Key="SidebarIconBrush" Color="{StaticResource SidebarIconColor}"/>
      <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarText}"/>
      <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBg}"/>
      <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
      <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource UserBubbleBg}"/>
      <SolidColorBrush x:Key="AgentBubbleBrush" Color="{StaticResource AgentBubbleBg}"/>
      <SolidColorBrush x:Key="ToolCallBrush" Color="{StaticResource ToolCallColor}"/>
      <SolidColorBrush x:Key="ToolCallBorderBrush" Color="{StaticResource ToolCallBorderColor}"/>
      <SolidColorBrush x:Key="ToolCallTextBrush" Color="{StaticResource ToolCallTextColor}"/>
      <SolidColorBrush x:Key="ToolResultBrush" Color="{StaticResource ToolResultColor}"/>
      <SolidColorBrush x:Key="ToolResultBorderBrush" Color="{StaticResource ToolResultBorderColor}"/>
      <SolidColorBrush x:Key="ToolResultTextBrush" Color="{StaticResource ToolResultTextColor}"/>

      <!-- 语义/表面 token（dark 主题覆盖这些键即换肤）。
           Surface=次级表面（chip/代码块底，比 CardBg 略深/略浅以区分）；
           Success/Danger/Warning/AccentTint=状态徽章 bg(浅 tint 底)+fg(深字色) 成对，
           dark 主题覆盖为深 tint 底+浅字色。DangerBrush 已存在（按钮用），此处 Danger 指徽章 fg 复用它。 -->
      <Color x:Key="SurfaceColor">#F3F4F6</Color>
      <Color x:Key="SurfaceHoverColor">#E5E7EB</Color>
      <Color x:Key="SuccessColor">#2E7D32</Color>
      <Color x:Key="SuccessBgColor">#E8F5E9</Color>
      <Color x:Key="DangerBgColor">#FFEBEE</Color>
      <Color x:Key="WarningColor">#B45309</Color>
      <Color x:Key="WarningBgColor">#FFF3E0</Color>
      <Color x:Key="AccentTintBgColor">#EEF0FB</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="OnDangerColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
      <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
      <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
      <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
      <SolidColorBrush x:Key="AccentTintBgBrush" Color="{StaticResource AccentTintBgColor}"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
      <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}"/>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 全局字体：文本用 Inter/系统字体，emoji 回退到 Apple Color Emoji / Segoe UI Emoji（避免 emoji 被裁切/ tofu） -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter,Segoe UI,system-ui,-apple-system,Helvetica,Arial,Apple Color Emoji,Segoe UI Emoji,Noto Color Emoji"/>
  </Style>

  <!-- 主按钮 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>

  <!-- 危险按钮 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,8"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- 普通输入框 -->
  <Style Selector="TextBox.input">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
  </Style>

  <!-- ═══ 侧边栏样式（展开/收起各一套自包含样式，不靠 class 覆盖，避免层叠混乱）═══ -->

  <!-- 展开态：导航项 / 收起按钮（图标+文字，左对齐） -->
  <Style Selector="Button.settings-nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,11"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="10,2,10,0"/>
  </Style>
  <Style Selector="Button.settings-nav:disabled">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- 收起态 rail：导航项 / 收起按钮（仅图标，居中） -->
  <Style Selector="Button.nav-rail">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="0,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="6,2"/>
  </Style>
  <Style Selector="Button.nav-rail:disabled">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- 展开态账户芯片（头像+用户名，左对齐，hover 背景） -->
  <Style Selector="Button.account-chip">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="8,2,8,8"/>
  </Style>
  <Style Selector="Button.account-chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
  </Style>

  <!-- 收起态账户芯片（仅头像，居中，hover 背景） -->
  <Style Selector="Button.account-rail">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Button.account-rail:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
  </Style>

  <!-- 一级 Tab 按钮 -->
  <Style Selector="Button.top-tab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.top-tab:disabled">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- 消息气泡 -->
  <Style Selector="Border.bubble-user">
    <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
    <Setter Property="CornerRadius" Value="18,18,4,18"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="MaxWidth" Value="640"/>
  </Style>
  <Style Selector="Border.bubble-agent">
    <Setter Property="Background" Value="{DynamicResource AgentBubbleBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16,12"/>
  </Style>

  <!-- ChatGPT 风格输入框卡片 -->
  <Style Selector="Border.chat-input-card">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BoxShadow" Value="0 4 12 0 #14000000"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- 输入框文本区 -->
  <Style Selector="TextBox.chat-text">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="14,12,52,12"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Height" Value="88"/>
    <Setter Property="MaxHeight" Value="88"/>
  </Style>

  <!-- 工具条芯片容器 -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Height" Value="26"/>
  </Style>
  <Style Selector="Border.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <!-- 发送按钮 -->
  <Style Selector="Button.send-btn">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style Selector="Button.send-btn:disabled">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- 紧凑 ComboBox -->
  <Style Selector="ComboBox.compact">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- 工具卡片 -->
  <Style Selector="Border.tool-card">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- 通用卡片外框：专家/专家团/市场/MCP/连接器 各 tab 共用，容器用 ItemsControl+WrapPanel 换行。 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <!-- 消息卡（思考/工具/计划/审批 统一底）：淡 tint + 圆角 + 描边 -->
  <Style Selector="Border.msg-card">
    <Setter Property="Background" Value="{DynamicResource ToolCallBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToolCallBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <!-- Markdown.Avalonia 代码块跨平台等宽字体（避免 macOS 无 Consolas 崩溃） -->
  <Style Selector="TextBlock.CodeBlock">
    <Setter Property="FontFamily" Value="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"/>
  </Style>
  <!-- Markdown.Avalonia 行内代码（ColorTextBlock.CCode）等宽字体。
       CCode.MonospaceFontFamily 默认取 TryGetMonospace()，在装了 Office 的 macOS 上会命中
       Consolas（系统枚举得到但 Avalonia 无法加载其字形文件），无 fallback 时 Measure 阶段抛
       “Could not create glyphTypeface”导致整页崩溃，故显式覆盖为带 fallback 的等宽字体列表。 -->
  <Style Selector="cb|CCode">
    <Setter Property="MonospaceFontFamily" Value="ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,Courier New,monospace"/>
  </Style>

  <!-- Markdown.Avalonia (GithubLike 主题) 视觉增强：统一品牌色（经 AccentBrush token，dark 主题自动跟随）。
       代码块圆角 + 品牌色左竖条，引用块品牌色竖线 + 表面底，链接/行内代码品牌色。
       selector 取自 MarkdownStyleGithubLike 主题（Border.CodeBlock/Border.Blockquote/cb|CCode/cb|CHyperlink 等），
       应用级样式覆盖控件级主题（同 TextBlock.CodeBlock 字体 fallback 机制）。 -->
  <Style Selector="Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="4,0,0,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,10"/>
  </Style>
  <Style Selector="TextBlock.CodeBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="cb|CCode">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>
  <Style Selector="Border.Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="4,0,0,0"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="0,6,6,0"/>
  </Style>
  <Style Selector="cb|CHyperlink">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- Markdown.Avalonia 表格主题化（修 dark 主题表格白块 bug）。
       GithubLike 主题对表格元素硬编码浅色（Border.Table 边框 #DFE2E5、单元格边框 #DFE2E5、
       表头 #FFFFFF、奇行 White、偶行 #F6F8FA）→ 非 light 主题下表格仍是白底浅框，与深色气泡冲突。
       此处用 token 覆盖（同 Border.CodeBlock/Blockquote 机制），表格跟随主题——
       不让 GithubLike 自行决定颜色。selector 与 GithubLike 一一对应（bare selector 应用级覆盖控件级主题）：
       Border.Table / Grid.Table>Border / Border.TableHeader cb|CTextBlock / Border.OddTableRow / Border.EvenTableRow。 -->
  <Style Selector="Border.Table">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Margin" Value="5"/>
  </Style>
  <Style Selector="Grid.Table > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,1,0,0"/>
    <Setter Property="Padding" Value="13,6"/>
  </Style>
  <Style Selector="Border.TableHeader cb|CTextBlock">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Border.OddTableRow">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
  </Style>
  <Style Selector="Border.EvenTableRow">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>

</Styles>
