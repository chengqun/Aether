<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.DiffView"
             Background="{DynamicResource ContentBgBrush}">

  <Panel>
  <!-- 二进制文件占位 -->
  <Border IsVisible="{Binding IsBinary}" Background="{DynamicResource CardBgBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Opacity="0.6">
      <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center"/>
      <TextBlock Text="二进制文件，无法显示差异" FontSize="14"
                 Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
  </Border>

  <!-- 左右并排 diff：左=HEAD 旧 / 分隔条 / 右=工作区新 -->
  <Grid ColumnDefinitions="*,4,*" IsVisible="{Binding !IsBinary}">
    <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="HEAD（旧）" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>
        <edit:TextEditor x:Name="LeftEditor" ShowLineNumbers="True" WordWrap="False"
                         FontFamily="Menlo,Monaco,Consolas,monospace" FontSize="13"
                         IsReadOnly="True" Background="Transparent" Margin="2,0"/>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" Cursor="SizeWestEast"/>

    <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="工作区（新）" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>
        <edit:TextEditor x:Name="RightEditor" ShowLineNumbers="True" WordWrap="False"
                         FontFamily="Menlo,Monaco,Consolas,monospace" FontSize="13"
                         IsReadOnly="True" Background="Transparent" Margin="2,0"/>
      </DockPanel>
    </Border>
  </Grid>
  </Panel>
</UserControl>
