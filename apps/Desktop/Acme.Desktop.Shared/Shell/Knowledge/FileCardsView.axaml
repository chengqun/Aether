<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.FileCardsView"
             Background="{DynamicResource ContentBgBrush}">

  <DockPanel>
    <!-- 顶部操作栏（标题 + 数量；「新建」在树右键菜单已有，此处只读列表） -->
    <Border DockPanel.Dock="Top" Classes="page-header">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Items.Count, StringFormat={}{0} 个}" Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="20,12" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <!-- 空态 -->
        <Border Classes="empty-state" IsVisible="{Binding !Items.Count}" VerticalAlignment="Top" Margin="0,30,0,0">
          <StackPanel Spacing="6">
            <Path Data="{x:Static shell:Codicons.File}" Stretch="Uniform" Width="40" Height="40"
                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="暂无内容" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="在左树该目录上右键「新建」，或直接向对应子目录拖入文件。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- 文件卡片列表（点卡片 → 打开文件编辑） -->
        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding Items.Count}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Width="260">
                <StackPanel Spacing="6">
                  <!-- name + category 徽标（对齐 SkillView 卡片） -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource AccentTintBgBrush}" CornerRadius="4"
                            Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding HasCategory}">
                      <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                  </Grid>
                  <!-- 描述（有则显） -->
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap" MaxLines="3" IsVisible="{Binding HasDescription}"/>
                  <!-- 打开按钮 -->
                  <Button Classes="ghost" Click="OnOpenClick" Tag="{Binding}" Padding="10,3" FontSize="11"
                          HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Path Data="{x:Static shell:Codicons.GoToFile}" Stretch="Uniform" Width="12" Height="12"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                      <TextBlock Text="打开编辑" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
