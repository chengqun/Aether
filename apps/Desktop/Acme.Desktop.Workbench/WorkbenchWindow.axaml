<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wb="using:Acme.Desktop.Workbench"
        xmlns:shell="using:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Desktop.Workbench.WorkbenchWindow"
        Title="Aether"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WorkspaceBackground}"
        FontFamily="{DynamicResource UiFont}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 设计 token 基线层（字体/圆角/间距/背景）。内置 light/dark 均为 JSON overlay 经 ThemeLoader 叠加覆盖颜色 token。 -->
        <ResourceInclude Source="avares://Acme.Desktop.Shared/Themes/WorkbenchTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <!-- Layer 0: 动画梦幻背景层（皮肤 animated=true 时显，aurora 漂移光斑；半透明面板让 aurora 透出） -->
    <Grid x:Name="DreamLayer" IsHitTestVisible="False" IsVisible="{Binding IsDreamLayerVisible}" ClipToBounds="True"/>

    <!-- Layer 1: shell（nav rail + 工作台）—— DreamLayer 在其下层 -->
    <DockPanel>

    <!-- ═══ 自绘标题栏（仅 borderless 皮肤显：dream 类。透明底让 aurora/渐变透出 → 沉浸无边框） ═══ -->
    <Border x:Name="CustomTitleBar" DockPanel.Dock="Top"
            Height="{Binding TitleBarHeight}" IsVisible="{Binding IsBorderless}"
            Background="Transparent"
            PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
        <!-- 标题（轻量、不抢戏；IsHitTestVisible=False 让拖拽穿透到 Border） -->
        <TextBlock Grid.Column="0" Text="Aether" Margin="14,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"
                   FontFamily="{DynamicResource UiFont}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <!-- 窗口控制按钮（右对齐，Windows 式三键；dream.styles 给 win-btn 皮肤） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="win-btn" Click="OnMinimize" ToolTip.Tip="最小化">
            <Path Data="{x:Static shell:Codicons.ChromeMinimize}" Stretch="Uniform" Width="12" Height="12"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="MaxBtn" Classes="win-btn" Click="OnMaximizeRestore" ToolTip.Tip="最大化/还原">
            <!-- 最大化/还原图标按 WindowState 切（ChromeMaximize / ChromeRestore）；两者叠放、IsVisible 互斥 -->
            <Panel>
              <Path x:Name="MaxIcon" Data="{x:Static shell:Codicons.ChromeMaximize}" Stretch="Uniform" Width="12" Height="12"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Path x:Name="RestoreIcon" Data="{x:Static shell:Codicons.ChromeRestore}" Stretch="Uniform" Width="12" Height="12"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
            </Panel>
          </Button>
          <Button Classes="win-btn win-close" Click="OnClose" ToolTip.Tip="关闭">
            <Path Data="{x:Static shell:Codicons.ChromeClose}" Stretch="Uniform" Width="12" Height="12"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ 侧边栏（收起=48px 仅图标 / 展开=200px 图标+文字；Classes.expanded 绑 IsSidebarExpanded） ═══ -->
    <Border DockPanel.Dock="Left" Classes="sidebar-rail" Classes.expanded="{Binding IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <!-- 侧栏展开/收起 toggle（顶部 chevron：收起▸=点击展开 / 展开◂=点击收起） -->
        <Button Grid.Row="0" Classes="nav-rail" Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="展开/收起侧栏" Margin="6,10,6,2">
          <Grid>
            <Path Data="{x:Static shell:Codicons.ChevronRight}" Stretch="Uniform" Width="16" Height="16"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  IsVisible="{Binding !IsSidebarExpanded}"/>
            <Path Data="{x:Static shell:Codicons.ChevronLeft}" Stretch="Uniform" Width="16" Height="16"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  IsVisible="{Binding IsSidebarExpanded}"/>
          </Grid>
        </Button>

        <StackPanel Grid.Row="1" Margin="0,2,0,0">
          <ItemsControl ItemsSource="{Binding WorkbenchNavItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="nav-rail" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 终端面板 toggle（侧栏底部）：可见时图标 accent 高亮，隐藏时灰色。PTY 不中断仅折叠 region。 -->
        <Button Grid.Row="3" Classes="nav-rail" Command="{Binding ToggleTerminalCommand}" ToolTip.Tip="终端" Margin="6,2,6,0">
          <Grid>
            <Path Data="{x:Static shell:Codicons.Terminal}" Stretch="Uniform" Width="16" Height="16"
                  Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsTerminalVisible}"/>
            <Path Data="{x:Static shell:Codicons.Terminal}" Stretch="Uniform" Width="16" Height="16"
                  Fill="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsTerminalVisible}"/>
          </Grid>
        </Button>

        <!-- AI 聊天右栏 toggle（VSCode 式可折叠右栏，对齐 ChatGPT 桌面端）：聊天也作 nav 全屏入口（上方 nav），此按钮仅控右栏显隐。
             tab-coupled：切到 chat nav 时右栏自动收起（单可见），按钮态反映 toggle 状态（accent 开/灰关）而非当前右栏可见性。 -->
        <Button Grid.Row="4" Classes="nav-rail" Command="{Binding ToggleChatCommand}" ToolTip.Tip="AI 聊天右栏" Margin="6,0,6,2">
          <Grid>
            <Path Data="{x:Static shell:Codicons.CommentDiscussion}" Stretch="Uniform" Width="16" Height="16"
                  Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsChatVisible}"/>
            <Path Data="{x:Static shell:Codicons.CommentDiscussion}" Stretch="Uniform" Width="16" Height="16"
                  Fill="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsChatVisible}"/>
          </Grid>
        </Button>

        <Button Grid.Row="5" Classes="account-rail" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="设置" Command="{Binding ShowSettingsCommand}">
                <MenuItem.Icon><Path Data="{x:Static shell:Codicons.SettingsGear}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="运行 Trace" Click="OnOpenTrace">
                <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Search}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="重置布局" Command="{Binding ResetLayoutCommand}">
                <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Refresh}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="主题" ItemsSource="{Binding Themes}" Click="OnSelectTheme">
                <MenuItem.Icon><Path Data="{x:Static shell:Codicons.ColorMode}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
                <MenuItem.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="{x:Static shell:Codicons.Check}" Stretch="Uniform" Width="12" Height="12"
                            Fill="{DynamicResource AccentBrush}"
                            IsVisible="{Binding IsCurrent}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </MenuItem.ItemTemplate>
              </MenuItem>
              <MenuItem Header="━" IsEnabled="False"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}">
                <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Key}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}">
                <MenuItem.Icon><Path Data="{x:Static shell:Codicons.SignOut}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <Border Width="28" Height="28" CornerRadius="{DynamicResource CornerRadiusLg}" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="{Binding UserInitial}" Foreground="{DynamicResource OnAccentBrush}" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 工作台主区（Workspace 决定布局，非 Window） ═══ -->
    <!-- 加载占位：窗口首帧 Show 到 ActivateAsync 之间有短暂空窗，占位避免裸露空白（HasActiveWorkspace=false 时显） -->
    <Panel>
      <ContentControl Content="{Binding ActiveWorkspace}"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      Background="{DynamicResource ContentBgBrush}"
                      IsVisible="{Binding HasActiveWorkspace}"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                  IsVisible="{Binding !HasActiveWorkspace}">
        <TextBlock Text="加载中…" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Panel>
    </DockPanel>
  </Grid>
</Window>
