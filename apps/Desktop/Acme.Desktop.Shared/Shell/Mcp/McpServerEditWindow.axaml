<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Acme.Desktop.Shared.Shell.McpServerEditWindow"
        Title="MCP 服务器配置"
        Width="560" Height="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel LastChildFill="True">
    <!-- 顶部说明 -->
    <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="粘贴一个 MCP server 的 JSON 配置（stdio 用 command/args/env，http 用 url/headers）。"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
    </Border>

    <!-- 底部按钮 -->
    <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="取消" Classes="ghost" Command="{Binding CancelCommand}" Padding="16,6"/>
        <Button Content="保存" Classes="primary" Command="{Binding SaveCommand}" Padding="20,6"/>
      </StackPanel>
    </Border>

    <Grid Margin="16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBox Grid.Row="0" Text="{Binding Json}" AcceptsReturn="True"
               FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12"
               IsReadOnly="False" Watermark="在此粘贴 JSON…" />

      <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                 Margin="0,8,0,0" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>
  </DockPanel>
</Window>
