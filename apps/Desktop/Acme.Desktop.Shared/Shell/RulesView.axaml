<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Acme.Desktop.Shared.Shell.RulesView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FF5252"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- 顶部标题栏 + 添加按钮 -->
    <Border DockPanel.Dock="Top" Padding="20,12" Background="White"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="规则 Agent" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="+ 添加规则" Classes="primary" Click="OnAddRuleClick"
                Padding="14,6" />
      </Grid>
    </Border>

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- 空状态 -->
        <Border IsVisible="{Binding !Rules.Count}" Padding="40" CornerRadius="12"
                Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" Margin="0,40">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="⚙️" FontSize="40" HorizontalAlignment="Center" />
            <TextBlock Text="还没有规则 Agent" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="点击右上角「+ 添加规则」创建确定性规则大脑" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 规则卡片网格 -->
        <ItemsControl ItemsSource="{Binding Rules}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,0,12,12" Width="300">
                <StackPanel Spacing="6">
                  <!-- 标题行 -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DisplayIcon}" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!-- 描述 -->
                  <TextBlock Text="{Binding Description}" FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                  <!-- 类别 + 工具数 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Border CornerRadius="4" Padding="6,1" Background="#FFF3E0">
                      <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#B45309" />
                    </Border>
                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Tools.Count, StringFormat='工具 {0}'}" />
                  </StackPanel>
                  <!-- 操作按钮 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="召唤" Classes="primary" Click="OnToggleSummonClick" Tag="{Binding}"
                            Padding="12,4" FontSize="12"
                            IsVisible="{Binding !IsSummoned}" />
                    <Button Content="取消召唤" Click="OnToggleSummonClick" Tag="{Binding}"
                            Padding="12,4" FontSize="12"
                            IsVisible="{Binding IsSummoned}" />
                    <Button Content="编辑" Click="OnEditClick" Tag="{Binding}"
                            Padding="12,4" FontSize="12"
                            IsVisible="{Binding !IsCodeRule}" />
                    <Button Content="删除" Classes="danger" Click="OnDeleteClick" Tag="{Binding}"
                            Padding="12,4" FontSize="12" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
