<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acme.Desktop.Mvvm"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.ExpertEditView"
             Classes="form-fields">

  <DockPanel>
    <!--  底栏：左=自动保存状态/评测进度提示，右=评测按钮（跑 labs evals/*.eval.yaml → 报告弹窗；
          HasEval=评测服务+弹窗已注入且在编辑已保存 agent，新建 agent 无落盘 id 不显示）  -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="▶ 评测" FontSize="12"
                Command="{Binding RunEvalCommand}" IsVisible="{Binding HasEval}"
                VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="评测运行中…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0"
                   IsVisible="{Binding IsRunningEval}"/>
        <TextBlock Text="{Binding AutoSaveStatus}" FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding AutoSaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </DockPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="AccordionPanel" Spacing="2" Margin="10,6">

        <Expander x:Name="ExpBasic" Header="基本信息" IsExpanded="True">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Name}" PlaceholderText="专家名称"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="类别" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Category}" PlaceholderText="如 代码/分析"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="描述" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Description}"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpPrompt" Header="系统提示词" IsExpanded="True">
          <StackPanel Spacing="4">
            <TextBox Text="{Binding SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="400" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"/>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpModel" Header="记忆" IsExpanded="False">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="记忆模式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox ItemsSource="{Binding MemoryModeOptions}" SelectedItem="{Binding SelectedMemoryModeOption}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding IsWindowVisible}">
              <TextBlock Text="{Binding MaxHistoryLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding MaxHistory}" Minimum="1" Maximum="200" FormatString="0"/>
            </StackPanel>
            <CheckBox Content="长期记忆（跨会话召回+沉淀）" IsChecked="{Binding EnableLongTermMemory}" Margin="0,2"/>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpSample" Header="采样与输出" IsExpanded="False">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="Top P" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="最大输出 tokens" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1" Maximum="128000" FormatString="0"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="响应格式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox ItemsSource="{Binding ResponseFormatOptions}" SelectedItem="{Binding SelectedResponseFormatOption}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander Header="工具审批" IsExpanded="False">
          <StackPanel Spacing="4">
            <CheckBox Content="启用工具调用前审批（Dangerous 工具弹审批框）" IsChecked="{Binding RequireToolApproval}" Margin="0,4"/>
            <TextBlock Text="开启后，在下方工具列表勾「自动放行」可让指定工具免弹框（常驻规则按名放行）；Safe 工具本就自动跑。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Expander>

        <Expander Header="Web 搜索" IsExpanded="False">
          <CheckBox Content="启用 Web 搜索" IsChecked="{Binding EnableWebSearch}" Margin="0,4"/>
        </Expander>

        <Expander Header="文件记忆" IsExpanded="False">
          <CheckBox Content="启用文件记忆 provider" IsChecked="{Binding EnableFileMemory}" Margin="0,4"/>
        </Expander>

        <Expander Header="待办" IsExpanded="False">
          <CheckBox Content="启用 TodoProvider（计划 UI）" IsChecked="{Binding EnableTodoProvider}" Margin="0,4"/>
        </Expander>

        <Expander Header="Agent 模式" IsExpanded="False">
          <CheckBox Content="启用 plan/execute 模式切换" IsChecked="{Binding EnableAgentModeProvider}" Margin="0,4"/>
        </Expander>

        <Expander Header="遥测" IsExpanded="False">
          <CheckBox Content="启用 OpenTelemetry（Trace 查看）" IsChecked="{Binding EnableOpenTelemetry}" Margin="0,4"/>
        </Expander>

        <Expander Header="后台 Agent" IsExpanded="False" IsVisible="{Binding HasBackgroundAgentCandidates}">
          <StackPanel Margin="0,4">
            <TextBlock Text="勾选后，本专家可动态把子任务分派给这些 agent 并发执行、再收结果汇总（orchestrator 模式）。仅普通 LLM agent 可作后台子 agent。"
                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding BackgroundAgents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Expander x:Name="ExpTools" Header="内置工具" IsExpanded="False">
          <ItemsControl ItemsSource="{Binding ToolCategories}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <!-- 分类小标题 + 全选 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                    <CheckBox IsChecked="{Binding IsAllSelected}" Padding="0"/>
                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>
                  <!-- 该类工具平铺 -->
                  <ItemsControl ItemsSource="{Binding Tools}" Margin="20,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1" IsEnabled="{Binding IsAvailable}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                            <ComboBox ItemsSource="{x:Static vm:ToolOption.ApprovalLevelOptions}"
                                      SelectedValue="{Binding ApprovalLevel, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}"
                                      FontSize="9" MinWidth="54" Padding="4,1" IsEnabled="{Binding IsAvailable}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" FontSize="10" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                              <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" FontSize="10" />
                                </DataTemplate>
                              </ComboBox.SelectionBoxItemTemplate>
                            </ComboBox>
                            <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="3" Padding="4,0" IsVisible="{Binding IsDangerous}">
                              <TextBlock Text="危险" FontSize="9" Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                            <CheckBox Content="自动放行" IsChecked="{Binding AutoApprove}" IsVisible="{Binding CanAutoApprove}" Margin="6,0,0,0" FontSize="9" Padding="2,0"/>
                            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" Padding="4,0" IsVisible="{Binding IsUnavailable}">
                              <TextBlock Text="{Binding AvailabilityHint}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <!-- MCP 工具区：按 server 分组，勾选实际要用的 MCP 工具 -->
        <Expander x:Name="ExpMcp" Header="MCP 工具" IsExpanded="False" IsVisible="{Binding HasMcpServers}">
          <StackPanel Spacing="6" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding McpServerGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2">
                    <StackPanel Spacing="4">
                      <!-- server 头：名称 + 状态 -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="10"
                                 TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <!-- 工具列表 -->
                      <ItemsControl ItemsSource="{Binding Tools}" Margin="16,2,0,0" IsVisible="{Binding HasTools}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{x:Static shell:Codicons.Tools}" Stretch="Uniform" Width="11" Height="11" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <ComboBox ItemsSource="{x:Static vm:ToolOption.ApprovalLevelOptions}"
                                          SelectedValue="{Binding ApprovalLevel, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Value}"
                                          FontSize="9" MinWidth="54" Padding="4,1">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Label}" FontSize="10" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                  <ComboBox.SelectionBoxItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Label}" FontSize="10" />
                                    </DataTemplate>
                                  </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                                <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="3" Padding="4,0" IsVisible="{Binding IsDangerous}">
                                  <TextBlock Text="危险" FontSize="9" Foreground="{DynamicResource DangerBrush}"/>
                                </Border>
                                <CheckBox Content="自动放行" IsChecked="{Binding AutoApprove}" IsVisible="{Binding CanAutoApprove}" Margin="6,0,0,0" FontSize="9" Padding="2,0"/>
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="（未连接或无工具）" FontSize="10" Margin="16,2,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !HasTools}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11" IsVisible="{Binding HasError}"/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
