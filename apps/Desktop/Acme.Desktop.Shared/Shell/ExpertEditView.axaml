<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Acme.Desktop.Shared.Shell.ExpertEditView">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="12,8">

      <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="15" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

      <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="0,0,0,8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBox Text="{Binding Name}" PlaceholderText="专家名称" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="2">
          <TextBlock Text="类别" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBox Text="{Binding Category}" PlaceholderText="如 代码/分析" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,8">
        <TextBlock Text="描述" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Description}" />
      </StackPanel>

      <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,8">
        <TextBlock Text="系统提示词" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" />
      </StackPanel>

      <Grid Grid.Row="4" ColumnDefinitions="*,8,*,8,Auto" Margin="0,0,0,8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="记忆模式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <ComboBox ItemsSource="{Binding MemoryModeOptions}" SelectedItem="{Binding SelectedMemoryModeOption}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="2">
          <TextBlock Text="模型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModelOption}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="2" Width="80" IsVisible="{Binding IsWindowVisible}">
          <TextBlock Text="窗口" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <NumericUpDown Value="{Binding MaxHistory}" Minimum="1" Maximum="200" FormatString="0" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="5" Spacing="6" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,8,*">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Top P" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="最大输出" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1" Maximum="128000" FormatString="0" />
          </StackPanel>
        </Grid>
        <TextBlock Text="扩展能力" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
        <WrapPanel>
          <CheckBox Content="Web搜索" IsChecked="{Binding EnableWebSearch}" Margin="0,0,12,2" />
          <CheckBox Content="文件记忆" IsChecked="{Binding EnableFileMemory}" Margin="0,0,12,2" />
          <CheckBox Content="待办" IsChecked="{Binding EnableTodoProvider}" Margin="0,0,12,2" />
          <CheckBox Content="技能" IsChecked="{Binding EnableAgentSkills}" Margin="0,0,12,2" />
          <CheckBox Content="Agent模式" IsChecked="{Binding EnableAgentModeProvider}" Margin="0,0,12,2" />
          <CheckBox Content="遥测" IsChecked="{Binding EnableOpenTelemetry}" Margin="0,0,12,2" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Grid.Row="6" Spacing="2" Margin="0,0,0,8">
        <TextBlock Text="技能" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ItemsControl ItemsSource="{Binding Skills}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="11" />
                  <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Row="7" Spacing="2">
        <TextBlock Text="工具" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
          <ScrollViewer MaxHeight="200" Padding="0">
            <ItemsControl ItemsSource="{Binding ToolCategories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Margin="0,2" IsExpanded="False">
                    <Expander.Header>
                      <CheckBox IsChecked="{Binding IsAllSelected}">
                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" />
                      </CheckBox>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Tools}" Margin="20,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding Name}" FontSize="11" />
                              <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

    </Grid>
  </ScrollViewer>
</UserControl>
