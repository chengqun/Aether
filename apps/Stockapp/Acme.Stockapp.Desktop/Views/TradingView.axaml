<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Acme.Stockapp.Desktop.Views.TradingView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </UserControl.Styles>

  <TabControl Margin="8">

    <!-- 配置 -->
    <TabItem Header="⚙ 配置">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="10" MaxWidth="520">

          <!-- 模式切换 -->
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton Content="回测" IsChecked="{Binding !IsLiveMode}" FontSize="13" />
            <RadioButton Content="实盘" IsChecked="{Binding IsLiveMode}" FontSize="13" />
          </StackPanel>

          <!-- ── 回测配置 ── -->
          <StackPanel Spacing="10" IsVisible="{Binding !IsLiveMode}">
            <TextBlock Text="📊 策略回测" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <StackPanel Spacing="4">
              <TextBlock Text="合约代码" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding Symbol}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="开始日期" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <CalendarDatePicker SelectedDate="{Binding StartDate}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="结束日期" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <CalendarDatePicker SelectedDate="{Binding EndDate}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="初始资金" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding InitialCash}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="分辨率" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding Resolution}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
            <Button Content="开始回测" Classes="primary" Command="{Binding RunCommand}" Padding="0,8" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- ── 实盘配置 ── -->
          <StackPanel Spacing="10" IsVisible="{Binding IsLiveMode}">
            <TextBlock Text="📡 实盘策略引擎（Lean 实时 · P1 仅信号不下单）" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="先在「期货」页登录 CTP，再填合约点「启动」。P1 不下单，仅验证行情/信号链路。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="启动" Command="{Binding StartLiveCommand}" Padding="14,6" />
                <Button Content="停止" Command="{Binding StopLiveCommand}" Padding="14,6" />
              </StackPanel>
              <TextBlock Text="{Binding LiveStatusText}" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="合约(逗号分隔)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding LiveInstruments}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="分辨率" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding LiveResolutionOptions}" SelectedItem="{Binding LiveResolution}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" />
            </Grid>
            <CheckBox Content="详细日志" IsChecked="{Binding VerboseLog}" FontSize="12" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 策略参数 -->
    <TabItem Header="🎯 策略">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="10" MaxWidth="480">
          <TextBlock Text="策略选择与参数" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- 引擎切换（仅回测；实盘只支持 IStrategy 壳）-->
          <StackPanel Spacing="4" IsVisible="{Binding IsEngineSelectorVisible}">
            <TextBlock Text="引擎" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding EngineOptions}" SelectedItem="{Binding Engine}" HorizontalAlignment="Stretch" />
            <TextBlock Text="IStrategy = Lean 中立壳（CodeStrategy/YAML 策略）；Lean算法 = 直写 QCAlgorithm，复用 Lean 全部能力"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- ── IStrategy 路径（实盘，或回测 IStrategy 引擎）── -->
          <StackPanel Spacing="10" IsVisible="{Binding IsIStrategySectionVisible}">
            <StackPanel Spacing="4">
              <TextBlock Text="策略" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox ItemsSource="{Binding StrategyOptions}" SelectedItem="{Binding StrategyName}" HorizontalAlignment="Stretch"
                        IsVisible="{Binding !IsLiveMode}" />
              <ComboBox ItemsSource="{Binding StrategyOptions}" SelectedItem="{Binding LiveStrategy}" HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsLiveMode}" />
            </StackPanel>

            <TextBlock Text="{Binding CurrentStrategyDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />

            <ItemsControl ItemsSource="{Binding StrategyParameterRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Margin="0,4">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Value}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="该策略无参数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding !StrategyParameterRows.Count}" Margin="0,8" />
          </StackPanel>

          <!-- ── Lean 算法路径（仅回测 + Lean 引擎）── -->
          <StackPanel Spacing="10" IsVisible="{Binding IsLeanAlgorithmSectionVisible}">
            <StackPanel Spacing="4">
              <TextBlock Text="Lean 算法" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox ItemsSource="{Binding LeanAlgorithmOptions}" SelectedItem="{Binding LeanAlgorithmName}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <TextBlock Text="Lean 算法笔记（NoteNodeType.LeanAlgorithm）经 Roslyn 编译成 QCAlgorithm 子类，绕过 IStrategy 壳直跑 Lean。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <!-- 编译错误（"下拉为空"时在此排查）-->
            <Border Background="{DynamicResource DangerBrush}" Opacity="0.12" CornerRadius="6" Padding="10,8"
                    IsVisible="{Binding HasLeanLoadErrors}">
              <StackPanel Spacing="4">
                <TextBlock Text="⚠ Lean 算法编译错误" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                <SelectableTextBlock Text="{Binding LeanLoadErrors}" FontSize="11" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <!-- 无算法 + 无错误提示 -->
            <TextBlock Text="尚未加载 Lean 算法——在笔记页新建「Lean 算法」节点并保存（自动编译注册）。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding ShowLeanEmptyHint}" />

            <ItemsControl ItemsSource="{Binding LeanAlgorithmParameterRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Margin="0,4">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Value}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="该算法无参数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding !LeanAlgorithmParameterRows.Count}" Margin="0,8" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 统计（回测） -->
    <TabItem Header="📈 统计">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="12">
          <Border Classes="card" IsVisible="{Binding HasError}">
            <StackPanel Spacing="6">
              <TextBlock Text="❌ 回测失败" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasResult}">
            <StackPanel Spacing="8">
              <TextBlock Text="📈 统计指标" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="总收益" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Statistics.TotalReturn}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="年化" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,2,0,2" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Statistics.Cagr}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="夏普" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.SharpeRatio}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="最大回撤" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,2,0,2" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Statistics.MaxDrawdown}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="胜率" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.WinRate}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="交易次数" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,2,0,2" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Statistics.TotalTrades}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="净利" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.NetProfit}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="权益点数" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,2,0,2" />
                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding EquityPointCount}" FontSize="11" Margin="8,2" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding !HasResult}" HorizontalAlignment="Center" Margin="0,40">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="📈" FontSize="40" HorizontalAlignment="Center" />
              <TextBlock Text="回测后显示统计指标" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 曲线（回测） -->
    <TabItem Header="📊 曲线">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="12">
          <Border Classes="card" IsVisible="{Binding HasResult}">
            <StackPanel Spacing="8">
              <TextBlock Text="权益曲线" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <Viewbox Stretch="Fill" Width="800" Height="240">
                <Canvas Width="1000" Height="300">
                  <Polyline Points="{Binding EquityPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                </Canvas>
              </Viewbox>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding !HasResult}" HorizontalAlignment="Center" Margin="0,40">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" />
              <TextBlock Text="回测后显示权益曲线" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 日志（回测+实盘共用，按模式切换） -->
    <TabItem Header="📋 日志">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="12">

          <!-- 回测日志 -->
          <Border Classes="card" IsVisible="{Binding !IsLiveMode}">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearLogCommand}" Padding="10,2" FontSize="11" />
                <TextBlock Text="回测运行日志" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              </DockPanel>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <ScrollViewer Height="400">
                  <SelectableTextBlock Text="{Binding LogText}" FontSize="11" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" TextWrapping="Wrap" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>

          <!-- 实盘日志 -->
          <Border Classes="card" IsVisible="{Binding IsLiveMode}">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearLiveLogCommand}" Padding="10,2" FontSize="11" />
                <TextBlock Text="实盘运行日志" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox x:Name="LiveLogBox" Text="{Binding LiveLog}" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="400"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</UserControl>
