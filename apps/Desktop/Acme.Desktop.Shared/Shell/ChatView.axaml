<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acme.Desktop.Mvvm"
             xmlns:conv="using:Acme.Desktop.Shared.Shell.Converters"
             xmlns:ctl="using:Acme.Desktop.Shared.Shell.Controls"
             x:Class="Acme.Desktop.Shared.Shell.ChatView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Resources>
    <conv:DictToStringConverter x:Key="DictToString" />

    <DataTemplate x:Key="MsgTemplate" DataType="vm:ChatMessageItem">
      <Grid Margin="0,4">
        <!-- 用户文本：右气泡 -->
        <Border Classes="bubble-user" HorizontalAlignment="Right" IsVisible="{Binding IsUserText}">
          <StackPanel Spacing="3" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource OnAccentBrush}"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Right" Opacity="0.9">
              <Run Text="{Binding Sender}" /><Run Text=" · " /><Run Text="{Binding Time}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- 流式答案（TextContent）：全宽 markdown，无气泡 -->
        <StackPanel HorizontalAlignment="Stretch" IsVisible="{Binding IsAgentStreamingAnswer}" Spacing="4">
          <TextBlock Text="回答中…" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ctl:SelectableMarkdownViewer Markdown="{Binding MarkdownContent}"
                                        SelectionEnabled="True" SelectionBrush="#3300A2ED" />
        </StackPanel>

        <!-- agent markdown 回答（完成）：全宽无框 + 元信息/复制 -->
        <StackPanel HorizontalAlignment="Stretch" IsVisible="{Binding IsAgentMarkdownText}" Spacing="4">
          <ctl:SelectableMarkdownViewer Markdown="{Binding Content}"
                                        SelectionEnabled="True" SelectionBrush="#3300A2ED" />
          <DockPanel>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.9" VerticalAlignment="Center">
              <Run Text="{Binding Sender}" /><Run Text=" · " /><Run Text="{Binding Time}" />
            </TextBlock>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnCopyMessage"
                    Background="Transparent" BorderThickness="0" Padding="6,2" ToolTip.Tip="复制"
                    VerticalAlignment="Center">
              <TextBlock Text="复制" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
            </Button>
          </DockPanel>
        </StackPanel>

        <!-- 流式思考：折叠 pill -->
        <Border Classes="msg-card" HorizontalAlignment="Stretch"
                IsVisible="{Binding IsAgentStreamingReasoning}" PointerPressed="OnStreamingCardTapped">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="思考中…" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsStreamingExpanded}" />
              <TextBlock Text="▸" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsStreamingExpanded}" />
            </StackPanel>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding IsStreamingExpanded}" Margin="0,2,0,0">
              <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                            ScrollChanged="OnStreamingScrollChanged">
                <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap"
                           FontFamily="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <!-- 已完成思考：折叠 pill，显示耗时 -->
        <Border Classes="msg-card" HorizontalAlignment="Stretch"
                IsVisible="{Binding IsAgentThinkingCard}" PointerPressed="OnToolCardTapped">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="思考" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" VerticalAlignment="Center"
                         IsVisible="{Binding ElapsedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Run Text="· " /><Run Text="{Binding ElapsedText}" />
              </TextBlock>
              <TextBlock Text="▸" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
              <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}" />
            </StackPanel>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding IsExpanded}" Margin="0,2,0,0">
              <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap"
                           FontFamily="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.9" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <!-- 工具步骤：一行摘要（● 工具名(参数) → 结果 ✓），点展开详情 -->
        <Border Classes="msg-card" HorizontalAlignment="Stretch"
                IsVisible="{Binding IsToolStep}" PointerPressed="OnToolCardTapped">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ToolName}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding MainArg}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
              <TextBlock Text="✓" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                         IsVisible="{Binding IsToolCompleted}" />
              <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6" VerticalAlignment="Center"
                         IsVisible="{Binding !IsToolCompleted}" />
              <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                         IsVisible="{Binding HasResultPreview}" />
              <TextBlock Text="{Binding ResultPreview}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                         IsVisible="{Binding HasResultPreview}" />
              <TextBlock Text="▸" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
              <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}" />
            </StackPanel>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding IsExpanded}" Margin="0,2,0,0">
              <StackPanel Spacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="输入" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Input, Converter={StaticResource DictToString}}" FontSize="11" TextWrapping="Wrap"
                             FontFamily="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="2" IsVisible="{Binding IsToolCompleted}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="结果" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"
                               IsVisible="{Binding IsResultLong}">
                      <Run Text="· " /><Run Text="{Binding ResultLineCount}" /><Run Text=" 行" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Text="{Binding ResultText}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             IsVisible="{Binding IsResultText}" />
                  <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="8,6"
                          IsVisible="{Binding IsResultCode}">
                    <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <TextBlock Text="{Binding ResultText}" FontSize="11" TextWrapping="Wrap"
                                 FontFamily="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </ScrollViewer>
                  </Border>
                  <TextBlock Text="{Binding ResultText}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsResultError}" />
                  <TextBlock Text="{Binding Output, Converter={StaticResource DictToString}}" FontSize="11" TextWrapping="Wrap"
                             FontFamily="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             IsVisible="{Binding IsResultTable}" />
                  <TextBlock Text="{Binding Output, Converter={StaticResource DictToString}}" FontSize="11" TextWrapping="Wrap"
                             FontFamily="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             IsVisible="{Binding IsResultJson}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 计划卡：checklist -->
        <Border Classes="msg-card" HorizontalAlignment="Stretch" IsVisible="{Binding IsPlanCard}">
          <StackPanel Spacing="4">
            <TextBlock Text="计划" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ItemsControl ItemsSource="{Binding Todos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                    <TextBlock Text="○" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsComplete}" />
                    <TextBlock Text="✓" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding IsComplete}" />
                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsComplete}" />
                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               TextDecorations="Strikethrough"
                               IsVisible="{Binding IsComplete}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 审批卡 -->
        <Border Classes="msg-card" HorizontalAlignment="Stretch" IsVisible="{Binding IsApprovalCard}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="⏳" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsApprovalPending}" />
            <TextBlock Text="✅" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsApprovalApproved}" />
            <TextBlock Text="❌" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsApprovalRejected}" />
            <TextBlock Text="{Binding ToolName}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="等待审批…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" IsVisible="{Binding IsApprovalPending}" />
            <TextBlock Text="已批准" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" IsVisible="{Binding IsApprovalApproved}" />
            <TextBlock Text="已拒绝" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                       VerticalAlignment="Center" IsVisible="{Binding IsApprovalRejected}" />
            <TextBlock Text="{Binding ArgSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- 一轮对话：Children（MsgTemplate）+ 状态脚注。无粗边框，靠间距分隔 -->
    <DataTemplate x:Key="TurnTemplate" DataType="vm:ChatTurnItem">
      <StackPanel Margin="0,8,0,0" Spacing="2">
        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource MsgTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsWorking}">
          <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="运行中…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsDone}">
          <TextBlock Text="✓" FontSize="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
          <TextBlock Text="完成" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" VerticalAlignment="Center"
                     IsVisible="{Binding ElapsedText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Run Text="· " /><Run Text="{Binding ElapsedText}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsError}">
          <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          <TextBlock Text="出错" FontSize="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsAwaitingApproval}">
          <TextBlock Text="⏳" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="等待审批…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{Binding IsConnected, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
          <TextBlock Text="{Binding ConnectionLabel}" FontSize="13" FontWeight="Medium"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Click="OnDeviceConfigClick"
                Background="Transparent" BorderThickness="0" Padding="0"
                Width="32" Height="32"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Margin="6,0,0,0" ToolTip.Tip="设备连接配置">
          <Path Data="{x:Static vm:NavIcons.Settings}" Stretch="Uniform" Width="15" Height="15"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <TextBlock Grid.Column="2" Text="{Binding TokenInfo}" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- 历史会话（Flyout 下拉） -->
          <Button x:Name="HistoryFlyoutButton" Classes="ghost" Padding="8,4" FontSize="12" ToolTip.Tip="历史会话">
            <TextBlock Text="≡" FontSize="14"/>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Border Width="280" MaxHeight="400">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="历史会话" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Conversations}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Classes="settings-nav" HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding ResumeCommand}"
                                    CommandParameter="{Binding}"
                                    Click="OnConversationClicked">
                              <Button.ContextFlyout>
                                <MenuFlyout>
                                  <MenuItem Header="删除"
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{Binding}"/>
                                </MenuFlyout>
                              </Button.ContextFlyout>
                              <StackPanel Spacing="2" HorizontalAlignment="Left">
                                <DockPanel>
                                  <TextBlock Text="{Binding DisplayTime}" DockPanel.Dock="Right"
                                             FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center" Margin="6,0,0,0"/>
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Preview}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- 新聊天 -->
          <Button Command="{Binding NewChatCommand}" Classes="ghost" Padding="8,4" FontSize="12" ToolTip.Tip="新聊天">
            <TextBlock Text="✚" FontSize="14"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="16,10,16,8" Background="{DynamicResource ContentBgBrush}">
      <StackPanel Spacing="6">
        <!-- plan-accept 条：plan 模式下计划就绪后提示接受→执行 -->
        <Border Classes="chat-input-card" Padding="12,8" IsVisible="{Binding ShowPlanAccept}" CornerRadius="12">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="计划已就绪" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button Classes="primary" Content="✅ 接受，开始执行" Command="{Binding AcceptPlanCommand}" Padding="14,6" FontSize="12"/>
          </StackPanel>
        </Border>
        <!-- 活动计划面板 + 输入卡：Spacing=0 紧贴，计划贴在输入框上沿 -->
        <StackPanel Spacing="0">
          <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="0" MaxHeight="240" IsVisible="{Binding HasActivePlan}">
            <Grid RowDefinitions="Auto,*">
              <!-- 头部：左侧点击展开/收起，右侧「确认执行完毕」收起面板（execute 跑完后显示） -->
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Command="{Binding TogglePlanExpandedCommand}" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,8" CornerRadius="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding PlanSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding IsPlanExpanded}"/>
                    <TextBlock Text="▸" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsPlanExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding DismissPlanCommand}" IsVisible="{Binding ShowPlanDismiss}"
                        Content="确认执行完毕" Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Grid>
              <!-- 计划列表（展开时显示） -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding IsPlanExpanded}" Padding="14,0,14,8">
                <ItemsControl ItemsSource="{Binding ActiveTodos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                        <TextBlock Text="○" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsComplete}"/>
                        <TextBlock Text="✓" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding IsComplete}"/>
                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsComplete}"/>
                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   TextDecorations="Strikethrough"
                                   IsVisible="{Binding IsComplete}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Classes="chat-input-card">
          <Grid RowDefinitions="Auto,*">
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,8" HorizontalAlignment="Stretch">
              <Border Classes="chip">
                <ComboBox Classes="compact" ItemsSource="{Binding ChatTargetItems}" SelectedItem="{Binding SelectedChatTarget}" PlaceholderText="选择对话目标">
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayIcon}" FontSize="11" /><TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding DisplayIcon}" FontSize="13" VerticalAlignment="Center" />
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="13" />
                          <TextBlock Text="{Binding Description}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Border>
              <Border Classes="chip">
                <ComboBox Classes="compact" ItemsSource="{Binding LlmSelectItems}" SelectedItem="{Binding SelectedLlmItem}" PlaceholderText="选择 LLM">
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="11" /><TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Name}" FontSize="13" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Border>
              <!-- plan/execute 切换：ToggleButton（比 ComboBox 更直观） -->
              <ToggleButton IsChecked="{Binding IsPlanMode}" IsVisible="{Binding HasModeSupport}"
                            Classes="compact" Padding="8,4" FontSize="11" ToolTip.Tip="规划：先计划再执行 / 执行：直接自主执行">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPlanMode}">
                    <TextBlock Text="📋" FontSize="11"/><TextBlock Text="规划" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsPlanMode}">
                    <TextBlock Text="▶️" FontSize="11"/><TextBlock Text="执行" FontSize="11"/>
                  </StackPanel>
                </Panel>
              </ToggleButton>
            </WrapPanel>
            <Grid Grid.Row="1">
              <TextBox Classes="chat-text" Text="{Binding InputText}" PlaceholderText="输入消息与助手对话…"
                       IsEnabled="{Binding !IsAgentRunning}" CaretBrush="{DynamicResource TextPrimaryBrush}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SendInputCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <!-- 运行中显示停止按钮，否则显示发送按钮 -->
              <Button Classes="send-btn" Command="{Binding SendInputCommand}" IsEnabled="{Binding CanSendInput}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                      IsVisible="{Binding !IsAgentRunning}">
                <PathIcon Width="16" Height="16"><PathIcon.Data><Geometry>M2 21l21-9L2 3v7l15 2-15 2v7z</Geometry></PathIcon.Data></PathIcon>
              </Button>
              <Button Classes="send-btn" Command="{Binding StopGenerationCommand}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                      IsVisible="{Binding IsAgentRunning}" Background="{DynamicResource DangerBrush}" BorderThickness="0">
                <Rectangle Width="11" Height="11" Fill="{DynamicResource OnDangerBrush}"/>
              </Button>
            </Grid>
          </Grid>
        </Border>
        </StackPanel>
        <TextBlock Text="内容由 AI 生成，请核实重要信息" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 消息区 + 浮动按钮（Panel 叠加，ScrollViewer 填满剩余空间） -->
    <Panel>
      <!--
        ScrollViewer 自身 Padding=0：Avalonia 12.0.4 的 ScrollContentPresenter.MeasureOverride
        不会把 Padding 从可用宽度中扣减（仅在 Arrange 时缩排），导致内部 TextWrapping/Markdown
        按完整 viewport 宽度计算换行，视觉上文字会超出右边界 ~Padding 个像素。
        改用内层 Border.Padding 走常规布局（Measure 时正确扣减）来限制内容宽度。
        AllowAutoHide=true（默认）时垂直滚动条为覆盖式（16px），需在内容右侧预留空间避让。
      -->
      <ScrollViewer x:Name="MessagesScrollViewer" Padding="0" Background="{DynamicResource CardBgBrush}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    ScrollChanged="OnMessagesScrollChanged">
        <Border Padding="20,12">
          <Panel>
          <!-- 空态引导 -->
          <Border IsVisible="{Binding !Messages.Count}" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="380">
              <TextBlock Text="👋" FontSize="36" HorizontalAlignment="Center"/>
              <TextBlock Text="开始对话" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="选择一个专家，输入你的问题。支持工具调用、MCP、技能、长期记忆等能力。"
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource TurnTemplate}" Margin="0,0,16,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Panel>
        </Border>
      </ScrollViewer>

      <!-- 滚到底部浮动按钮（叠加在 ScrollViewer 上） -->
      <Button x:Name="ScrollToBottomButton" Click="OnScrollToBottomClick"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,80"
              Width="36" Height="36" CornerRadius="18" Padding="0"
              Background="{DynamicResource AccentBrush}" BorderThickness="0"
              IsVisible="False" ToolTip.Tip="滚到底部">
        <TextBlock Text="↓" FontSize="16" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
    </Panel>
  </DockPanel>
</UserControl>
