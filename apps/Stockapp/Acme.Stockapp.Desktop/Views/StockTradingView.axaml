<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acme.Stockapp.Desktop.ViewModels"
             x:Class="Acme.Stockapp.Desktop.Views.StockTradingView"
             Background="{DynamicResource ContentBgBrush}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinWidth" Value="120" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="14">

      <!-- 连接 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="sectionTitle" Text="同花顺下单客户端" />
          <DockPanel>
            <TextBlock Text="连接状态：" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="启动客户端" Command="{Binding LaunchCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="连接" Command="{Binding ConnectCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="断开" Command="{Binding DisconnectCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="提示：先点「启动客户端」打开同花顺 xiadan.exe，手动登录后点「连接」。"
                     FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 下单 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="sectionTitle" Text="下单" />
          <Grid ColumnDefinitions="Auto,160,Auto,160" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0"
                HorizontalAlignment="Left">
            <TextBlock Text="股票代码" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Classes="field" Grid.Row="0" Grid.Column="1" Margin="0,0,16,8"
                     Text="{Binding Symbol}" />
            <TextBlock Text="名称(可选)" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Classes="field" Grid.Row="0" Grid.Column="3" Margin="0,0,16,8"
                     Text="{Binding Name}" />

            <TextBlock Text="方向" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,16,8" SelectedIndex="{Binding DirectionIndex}">
              <ComboBoxItem Content="买入" />
              <ComboBoxItem Content="卖出" />
            </ComboBox>
            <TextBlock Text="数量(股)" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Classes="field" Grid.Row="1" Grid.Column="3" Margin="0,0,16,8"
                     Text="{Binding Quantity}" />

            <TextBlock Text="限价" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Classes="field" Grid.Row="2" Grid.Column="1" Margin="0,0,16,8"
                     Text="{Binding LimitPrice}" />
          </Grid>
          <Button Content="下单" Command="{Binding PlaceOrderCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- 撤单 / 持仓 -->
      <Grid ColumnDefinitions="*,*" Margin="0">
        <Border Classes="card" Grid.Column="0" Margin="0,0,7,0">
          <StackPanel Spacing="10">
            <TextBlock Classes="sectionTitle" Text="撤单" />
            <DockPanel>
              <TextBlock Text="单号" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Classes="field" Text="{Binding CancelOrderNo}" />
            </DockPanel>
            <Button Content="撤单" Command="{Binding CancelCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Column="1" Margin="7,0,0,0">
          <StackPanel Spacing="10">
            <DockPanel>
              <TextBlock Classes="sectionTitle" Text="持仓" VerticalAlignment="Center" />
              <Button Content="刷新" Command="{Binding QueryPositionsCommand}" HorizontalAlignment="Right" />
            </DockPanel>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer MaxHeight="240">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="Margin" Value="6,3" />
                      <Setter Property="FontSize" Value="11" />
                    </Style>
                  </Grid.Styles>
                  <!-- 表头 -->
                  <TextBlock Grid.Column="0" Text="代码" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="名称" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="余额" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="3" Text="可用" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="4" Text="盈亏%" FontWeight="SemiBold" />
                  <!-- 行（简化：首条详情见日志/后续可扩展） -->
                  <ItemsControl ItemsSource="{Binding Positions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,*,*,*,*">
                          <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" />
                          <TextBlock Grid.Column="2" Text="{Binding Quantity}" />
                          <TextBlock Grid.Column="3" Text="{Binding AvailableQuantity}" />
                          <TextBlock Grid.Column="4" Text="{Binding ProfitLossRatio}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 日志 -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="日志" />
          <ItemsControl ItemsSource="{Binding Logs}" MinHeight="60" MaxHeight="200">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="11"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
