<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- android 无条件声明（2026-09-03）：GitHub CI 的 build-android job 在 ubuntu runner 上
		     -f net10.0-android 打 APK——旧条件 !IsOSPlatform('linux') 在 linux 上不声明 android TFM，
		     CI 的 -f 必挂（android job 从未可能成功）。本地 macOS 行为不变（原本就含 android）；
		     本地不带 -f 的全目标 build 在 linux 上本就不可行（ios TFM）。与 Qifu.Mobile 同修。 -->
		<TargetFrameworks>net10.0-ios;net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Acme.Stockapp.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- 品牌（Aether 体系，非旧 alphaagent.*） -->
		<ApplicationTitle>Aether · 行情</ApplicationTitle>
		<ApplicationId>com.aether.stockapp</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- iOS 自动签名（钥匙串仅保留一个 Apple Development 证书时自动选取） -->
		<CodesignProvision>Automatic</CodesignProvision>
		<ProvisioningType>automatic</ProvisioningType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- 自包含 Debug APK：关闭 Fast Deployment（默认 Debug 只装壳，程序集靠 -t:Install 单独推到 .__override__，
		     adb install 单装 APK 会因找不到程序集 SIGABRT）。改为程序集+运行时打入 APK，便于 adb install 直接安装且 APK 可移植。
		     iOS 不受此条件影响。 -->
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon + Splash（租户专属，蓝色品牌） -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1565C0" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1565C0" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<!-- 共享 MAUI 层（Views/Services/Converters/AddMobileCommon/Resources）+ 全部业务/平台契约 -->
		<ProjectReference Include="..\..\Mobile\Acme.Mobile.Shared\Acme.Mobile.Shared.csproj" />
		<!-- Quotes 上下文（Qifu 不需要，Stockapp 暴露行情 agent 工具）：
		     Mobile.Shared 不引 Quotes，故租户自行引。Quotes.AI 传递引 Securities.Application + Quotes.application。 -->
		<ProjectReference Include="..\..\..\business\Quotes\Acme.Quotes.Application\Acme.Quotes.Application.csproj" />
		<ProjectReference Include="..\..\..\business\Quotes\Acme.Quotes.Infrastructure\Acme.Quotes.Infrastructure.csproj" />
		<ProjectReference Include="..\..\..\ai\Quotes\Acme.Quotes.AI\Acme.Quotes.AI.csproj" />
		<!-- MySQL 直连数据查询（DataQuery 上下文，纯 net10.0 + MySqlConnector 纯 managed——手机可引）。
		     Domain(DataQueryOptions)/Application(ISqlQueryService)/Infrastructure(MySqlSqlExecutor)/AI(ExecuteSql 工具)。
		     与 Qifu 同构：连接器页 MySQL 卡 + AI ExecuteSql 工具。 -->
		<ProjectReference Include="..\..\..\business\DataQuery\Acme.DataQuery.Domain\Acme.DataQuery.Domain.csproj" />
		<ProjectReference Include="..\..\..\business\DataQuery\Acme.DataQuery.Application\Acme.DataQuery.Application.csproj" />
		<ProjectReference Include="..\..\..\business\DataQuery\Acme.DataQuery.Infrastructure\Acme.DataQuery.Infrastructure.csproj" />
		<ProjectReference Include="..\..\..\ai\DataQuery\Acme.DataQuery.AI\Acme.DataQuery.AI.csproj" />
	</ItemGroup>

</Project>
