<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Acme.Stockapp.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:styles="clr-namespace:Acme.Mobile.Shared.Resources.Styles;assembly=Acme.Mobile.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <styles:Colors />
                <styles:Styles />
            </ResourceDictionary.MergedDictionaries>
            <!-- 行情租户品牌色：与 app 图标 (MauiIcon Color=#1565C0) 一致。
                 直接条目优先于 MergedDictionaries 中的 Primary(#2E7D32 绿)，覆盖共享色。 -->
            <Color x:Key="Primary">#1565C0</Color>
            <Color x:Key="PrimaryDark">#64B5F6</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
