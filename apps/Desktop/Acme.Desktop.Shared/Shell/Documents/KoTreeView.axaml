<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.KoTreeView"
             Background="{DynamicResource CardBgBrush}">

  <UserControl.Resources>
    <!-- .md 树节点模板（镜像 FileTreeView/FileNodeTemplate，纯 .md 知识对象树）。 -->
    <TreeDataTemplate x:Key="FileNodeTemplate" ItemsSource="{Binding Children}">
      <Grid ColumnDefinitions="Auto,*" Background="Transparent">
        <!-- 普通文件/子目录：14×14 描边/填充小图标 -->
        <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
              Margin="0,0,7,0" Fill="{Binding IconColor}" IsVisible="{Binding ShowFillIcon}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
              Margin="0,0,7,0" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
              Stroke="{Binding IconColor}" IsVisible="{Binding ShowStrokeIcon}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- 类型目录入口：彩色圆角方块 + 白填充 Material 字形（手机 AiSettingsPage 同源） -->
        <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,7,0" CornerRadius="5"
                Background="{Binding IconColor}" IsVisible="{Binding IsTypeEntry}"
                HorizontalAlignment="Left" VerticalAlignment="Center">
          <Path Data="{Binding FillCardIcon}" Stretch="Uniform" Width="13" Height="13"
                Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <!-- 类型目录入口的描述副标题（labs 树顶部入口；普通文件/子目录无 Subtitle → 不显） -->
          <TextBlock Text="{Binding Subtitle}" FontSize="10" Opacity="0.6"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasSubtitle}"/>
        </StackPanel>
      </Grid>
    </TreeDataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 共享样式（ScrollViewer 横滚禁用 / TreeViewItem 选中反白 / IsExpanded 双绑）已上移 SharedTheme.axaml，
         匹配 TreeView.ko-tree class 选择器。此处仅留树特有的 chevron 箭头（IsFolder）。 -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="{Binding IsFolder}"/>
    </Style>
  </UserControl.Styles>

  <!-- shell 级独立左栏（占满高度，宽度由外层 LayoutSplit 控制——终端只压右栏编辑器区不压本树，同 FileTreeView）。
       树头=分区切换器（‹ 当前分区 ›，居中；labs 模式显示，其余整条隐藏）；打开/关闭资料库走右键菜单
       （TreeView 菜单含全部操作；空白/空态/树头右键走根级菜单）。与 KnowledgeObjectsView（右栏）共享同一
       KnowledgeObjectsViewModel 单例——树点文件 → VM.SelectedNode 变 → VM.OnSelectedNodeChanged 分流打开 →
       右栏表单/源码刷新。 -->
  <Border Background="{DynamicResource CardBgBrush}">
    <!-- 根级右键（覆盖空白/空态/树头等非树区——TreeView 内的右键走其自身菜单）：打开/关闭资料库 -->
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="打开资料库目录" Click="OnOpenFolderClick">
          <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Folder}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="关闭资料库" Command="{Binding CloseProjectCommand}"
                  IsEnabled="{Binding HasRoot}">
          <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid RowDefinitions="Auto,*">
      <!-- 分区切换器 = "当前位置"指示（居中胶囊分段控件）：labs 模式显示（自定义知识库根/未开目录整条隐藏）。
           箭头 wrap-around 循环切换固定类型目录，树只显当前分区的子节点（分区名在此显示，树内不重复根层）。
           字号/图标刻意大于树内子目录行——当前位置比列表项还小是视觉层级倒挂。胶囊用 accent 淡底 + 发丝描边
           （主题 token，明暗自适应）；箭头 Button.scm-act（伪类在 /template/ ContentPresenter 层），
           Path Fill 绑 Button.Foreground 随 hover 变色。 -->
      <Border Grid.Row="0" Padding="6,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
              IsVisible="{Binding HasScopeSwitcher}">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource AccentTintBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="16" Padding="3,2">
          <StackPanel Orientation="Horizontal">
            <Button Classes="scm-act" Command="{Binding ScopeLeftCommand}" ToolTip.Tip="上一个分区">
              <Path Data="{x:Static shell:Codicons.ChevronLeft}" Stretch="Uniform" Width="15" Height="15"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    VerticalAlignment="Center"/>
            </Button>
            <Grid ColumnDefinitions="Auto,Auto" Margin="6,0" VerticalAlignment="Center">
              <Path Grid.Column="0" Data="{Binding CurrentScopeFillIcon}" Fill="{Binding CurrentScopeIconColor}"
                    Stretch="Uniform" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"
                    IsVisible="{Binding HasScopeIcon}"/>
              <TextBlock Grid.Column="1" Text="{Binding CurrentScopeDisplay}" FontSize="14" FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="130"
                         ToolTip.Tip="{Binding CurrentScopeDirName}"/>
            </Grid>
            <Button Classes="scm-act" Command="{Binding ScopeRightCommand}" ToolTip.Tip="下一个分区">
              <Path Data="{x:Static shell:Codicons.ChevronRight}" Stretch="Uniform" Width="15" Height="15"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Border>
      </Border>
      <TreeView Grid.Row="1" x:Name="KoTree" Classes="ko-tree" Margin="4,4"
                ItemsSource="{Binding Roots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                ItemTemplate="{StaticResource FileNodeTemplate}">
        <!-- 右键菜单（镜像 FileTreeView，对标 VSCode 常用文件操作）。.md 树「新建文件」= 新知识对象。
             文件夹才有「新建」，文件才有「打开」；菜单 DataContext 继承当前节点的 FileNode。 -->
        <TreeView.ContextMenu>
          <!-- 绑定 VM.SelectedNode（右键时已选中该节点），菜单项 DataContext 继承 TreeView=VM 非 TreeViewItem——
               IsEnabled 绑 VM.SelectedNode + FileNodeIsFolderConverter 判 IsFolder。镜像 FileTreeView。 -->
          <ContextMenu>
            <MenuItem Header="新建">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.NewFile}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
              <MenuItem Header="Agent" Tag="Agent" Click="OnNewNodeClick"/>
              <MenuItem Header="Workflow（专家团）" Tag="Workflow" Click="OnNewNodeClick"/>
              <MenuItem Header="规则" Tag="Rule" Click="OnNewNodeClick"/>
              <MenuItem Header="代码规则" Tag="CodeRule" Click="OnNewNodeClick"/>
              <MenuItem Header="代码规则（F#）" Tag="CodeRule:fsharp" Click="OnNewNodeClick"/>
              <MenuItem Header="知识对象" Tag="Knowledge" Click="OnNewNodeClick"/>
              <MenuItem Header="技能" Tag="Skill" Click="OnNewNodeClick"/>
              <MenuItem Header="MCP" Tag="McpServer" Click="OnNewNodeClick"/>
              <MenuItem Header="策略（YAML）" Tag="Strategy" Click="OnNewNodeClick" IsVisible="{Binding HasTradingTypes}"/>
              <MenuItem Header="代码策略" Tag="CodeStrategy" Click="OnNewNodeClick" IsVisible="{Binding HasTradingTypes}"/>
              <MenuItem Header="Lean 算法" Tag="LeanAlgorithm" Click="OnNewNodeClick" IsVisible="{Binding HasTradingTypes}"/>
              <MenuItem Header="文本笔记" Tag="Note" Click="OnNewNodeClick"/>
            </MenuItem>
            <MenuItem Header="新建文件夹" Click="OnNewFolderClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:FileNodeIsFolderConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.NewFolder}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="打开" Click="OnOpenNodeClick">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.File}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="重命名…" Click="OnRenameClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Edit}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="删除" Click="OnDeleteClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Trash}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="复制路径" Click="OnCopyPathClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Copy}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="复制相对路径" Click="OnCopyRelativePathClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.GoToFile}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="在文件管理器中显示" Click="OnRevealInFileManagerClick"
                      IsEnabled="{Binding HasRoot}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.FolderActive}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="打开资料库目录" Click="OnOpenFolderClick">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Folder}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="关闭资料库" Command="{Binding CloseProjectCommand}"
                      IsEnabled="{Binding HasRoot}">
              <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Close}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      <!-- 空态：未打开知识库目录（右键任意空白处打开；根级 ContextMenu 兜底） -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding !HasRoot}" Spacing="8">
        <Path Data="{x:Static shell:Codicons.Collection}" Stretch="Uniform" Width="36" Height="36"
              HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5"/>
        <TextBlock Text="未打开资料库目录" FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="右键 → 打开资料库目录" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
