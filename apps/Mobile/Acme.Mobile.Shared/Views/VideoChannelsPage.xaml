<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Mobile.Shared.Views.VideoChannelsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:mdl="clr-namespace:Acme.Mobile.Mvvm.Models;assembly=Acme.Mobile.Mvvm"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    xmlns:media="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.MediaElement"
    x:DataType="vm:VideoChannelsViewModel"
    Title="视频号"
    BackgroundColor="Black">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid>
        <!-- Loading overlay -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Error / empty overlay -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Label Text="{Binding ErrorMessage}" TextColor="White" FontSize="16"
                   HorizontalTextAlignment="Center" />
            <Button Text="重新加载" Command="{Binding RetryLoadCommand}"
                    BackgroundColor="#2A2A2A" TextColor="White" />
        </VerticalStackLayout>

        <!-- TikTok-style single MediaElement + swipe gesture -->
        <Grid IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}">
            <media:MediaElement x:Name="Player"
                                ShouldAutoPlay="True"
                                ShouldLoopPlayback="True"
                                ShouldShowPlaybackControls="False"
                                Aspect="AspectFill"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />

            <!-- Overlay: author + title at bottom -->
            <VerticalStackLayout Padding="16,0,16,28"
                                 Spacing="4"
                                 VerticalOptions="End"
                                 HorizontalOptions="Start">
                <Label Text="{Binding CurrentVideo.Author, StringFormat='@{0}'}"
                       FontSize="16" FontAttributes="Bold" TextColor="White" Opacity="0.9" />
                <Label Text="{Binding CurrentVideo.Title}"
                       FontSize="14" TextColor="White" Opacity="0.8"
                       LineBreakMode="TailTruncation" MaxLines="2" />
            </VerticalStackLayout>

            <!-- Swipe up/down indicators -->
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,12,0">
                <Label Text="▲ 上滑" TextColor="White" Opacity="0.5" FontSize="12"
                       IsVisible="{Binding HasPrevious}" />
                <Label Text="▼ 下滑" TextColor="White" Opacity="0.5" FontSize="12"
                       IsVisible="{Binding HasNext}" Margin="0,16,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
