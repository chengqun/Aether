<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Mobile.Shared.Views.ServiceAccountDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:sa="clr-namespace:Acme.ServiceAccount.Domain;assembly=Acme.ServiceAccount.Domain"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    x:DataType="vm:ServiceAccountDetailViewModel"
    Title="{Binding Name}">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InitialConverter x:Key="InitialConverter" />
    </ContentPage.Resources>

    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsLoading}"
        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <CollectionView ItemsSource="{Binding Posts}" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                    <!-- 服务号头部信息 -->
                    <VerticalStackLayout Spacing="10" Padding="20,24,20,16"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">

                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="14" RowSpacing="0">
                            <Border Grid.Column="0" WidthRequest="64" HeightRequest="64"
                                    BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 32" StrokeThickness="0"
                                    HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="{Binding Name, Converter={StaticResource InitialConverter}}"
                                       TextColor="White" FontSize="26" FontFamily="OpenSansSemibold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="✓" FontSize="13" IsVisible="{Binding IsVerified}"
                                           TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Category}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding FollowerCount, StringFormat='{0} 关注者'}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="+ 关注" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding FollowCommand}" IsVisible="{Binding IsFollowed, Converter={StaticResource InverseBool}}"
                                    VerticalOptions="Center" Padding="14,6" />
                            <Button Grid.Column="2" Text="已关注" Style="{StaticResource GhostButton}"
                                    Command="{Binding UnfollowCommand}" IsVisible="{Binding IsFollowed}"
                                    VerticalOptions="Center" Padding="14,6" />
                        </Grid>

                        <Label Text="{Binding Description}" FontSize="13" LineBreakMode="WordWrap"
                               IsVisible="{Binding Description, Converter={StaticResource StringToBool}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Border IsVisible="{Binding HasWelcomeMessage}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="12,8" Margin="0,4,0,0">
                            <Label Text="{Binding WelcomeMessage}" FontSize="13" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />

                    <Label Text="历史文章" FontSize="13" FontAttributes="Bold" Margin="16,12,16,4"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <Label Text="{Binding StatusMessage}" FontSize="13" Margin="16,4"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="sa:ServiceAccountPostListItem">
                    <Border Style="{StaticResource CardFrame}" Margin="16,6">
                        <Grid RowDefinitions="Auto,Auto" Padding="12" RowSpacing="4">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToPostDetailCommand}"
                                    CommandParameter="{Binding Id}" />
                            </Grid.GestureRecognizers>

                            <!-- cover + title + summary -->
                            <Grid Grid.Row="0" ColumnDefinitions="72,*" ColumnSpacing="10">
                                <Border Grid.Column="0" WidthRequest="72" HeightRequest="72"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}"
                                        StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                        HorizontalOptions="Start" VerticalOptions="Start">
                                    <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Start">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding Summary}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- meta -->
                            <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,4,0,0">
                                <Label Text="{Binding ContentTypeDisplayName}" FontSize="11"
                                       TextColor="{StaticResource Accent}" />
                                <Label Text="·" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
