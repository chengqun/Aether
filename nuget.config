<?xml version="1.0" encoding="utf-8"?>
<!-- 仓库级 NuGet 配置：clear 后仅保留官方源。
     目的：
     1. CPM（Directory.Build.props）+ 多源会触发 NU1507；本仓库全部包来自官方源，显式单源即消除。
     2. 本地与 CI（GitHub Actions 默认配置）行为对齐，不再依赖开发机用户级 NuGet.Config
        （其 DevExpress 私有 feed 仅服务其他仓库，与本仓库无关，clear 不影响全局配置）。
     Lean / MAF / FlaUI-MCP submodule 无自己的 nuget.config，向上会命中本文件（官方单源，其包均在此源）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
