<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Acme.Desktop.Shared.Shell.Converters"
             x:Class="Acme.Qifu.Desktop.Views.ConnectorView"
             Background="Transparent">

  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Top">

    <!-- 毓数平台认证 卡片 -->
    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="16" Padding="20" Width="340">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="44" Height="44" CornerRadius="22" Background="#E3F2FD">
              <TextBlock Text="🔢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="毓数平台认证" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="连接毓数平台以使用 SQL 数据查询功能" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border CornerRadius="6" Padding="10,6" Background="#FFF3E0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding IsYushuAuthenticated, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
                <TextBlock Text="{Binding YushuStatusText}" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Button Content="同步" Command="{Binding YushuSyncToServerCommand}"
                    IsVisible="{Binding ShowYushuSync}" Padding="10,6" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <Button Command="{Binding YushuLoginCommand}"
                  IsEnabled="{Binding !IsYushuLoggingIn}"
                  Width="32" Height="32" CornerRadius="16"
                  Background="{DynamicResource AccentBrush}" Foreground="White"
                  BorderThickness="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  HorizontalAlignment="Right">
            <TextBlock Text="+" Foreground="White" FontSize="20" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 云文档认证 卡片 -->
    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="16" Padding="20" Width="340">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="44" Height="44" CornerRadius="22" Background="#E8F5E9">
              <TextBlock Text="☁️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="云文档认证" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="连接 360Teams 云文档以使用文件上传功能" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border CornerRadius="6" Padding="10,6" Background="#FFF3E0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding IsCloudDocsAuthenticated, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
                <TextBlock Text="{Binding CloudDocsStatusText}" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Button Content="同步" Command="{Binding CloudDocsSyncToServerCommand}"
                    IsVisible="{Binding ShowCloudDocsSync}" Padding="10,6" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <Button Command="{Binding CloudDocsLoginCommand}"
                  IsEnabled="{Binding !IsCloudDocsLoggingIn}"
                  Width="32" Height="32" CornerRadius="16"
                  Background="{DynamicResource AccentBrush}" Foreground="White"
                  BorderThickness="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  HorizontalAlignment="Right">
            <TextBlock Text="+" Foreground="White" FontSize="20" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>
</UserControl>