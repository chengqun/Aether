<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Acme.Desktop.Shared.Shell"
             xmlns:know="using:Acme.Desktop.Mvvm.Knowledge"
             x:Class="Acme.Desktop.Shared.Shell.CsvTableView"
             Background="{DynamicResource CardBgBrush}">

  <UserControl.Styles>
    <Style Selector="Button.csv-mode">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.csv-mode:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.csv-label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- 字段胶囊 -->
    <Style Selector="local|CsvFieldChip.csv-chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="local|CsvFieldChip.chip-pivot">
      <Setter Property="Background" Value="#330895B2"/>
      <Setter Property="BorderBrush" Value="#0895B2"/>
    </Style>
    <Style Selector="local|CsvFieldChip.chip-measure">
      <Setter Property="Background" Value="#330A7A0A"/>
      <Setter Property="BorderBrush" Value="#B45F06"/>
    </Style>
    <Style Selector="local|CsvFieldChip.chip-dimension">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <!-- 计算字段胶囊：紫色虚线边框，区分普通字段 -->
    <Style Selector="local|CsvFieldChip.chip-calculated">
      <Setter Property="Background" Value="#337C3AED"/>
      <Setter Property="BorderBrush" Value="#7C3AED"/>
    </Style>
    <!-- 投放区 -->
    <Style Selector="Border.drop-zone">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.drop-zone.drop-over">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- 第一行：详情表/透视表切换 + 总计开关 + 刷新按钮 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="8,6,8,0">
      <StackPanel Orientation="Horizontal" Spacing="0">
        <Button Classes="csv-mode" x:Name="DetailButton" Content="详情表" />
        <Button Classes="csv-mode" x:Name="PivotButton" Content="透视表" />
      </StackPanel>
      <CheckBox Classes="csv-label" Content="总计" IsChecked="{Binding ShowTotals}" Margin="8,0,0,0"/>
      <Button Classes="csv-mode" x:Name="RefreshButton" Content="刷新" Click="OnRefreshClick"/>
    </StackPanel>

    <!-- 第二块：字段面板（仅透视视图显示）——顶部字段区两行（原始字段 + 计算字段，各横向滚动）+ 下方投放区。 -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="8,4,8,6" IsVisible="{Binding IsPivot}">
      <!-- 顶部：字段区两行横滑（字段多时左右滑动）。 -->
      <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,6">
        <!-- 第一行：原始字段（原始 CSV 列，横向单行，可左右滑动） -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="csv-label" Text="字段" Width="52" VerticalAlignment="Center"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Border x:Name="FieldsDropZone" Classes="drop-zone" Padding="2">
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="know:CsvFieldItem">
                    <local:CsvFieldChip/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </ScrollViewer>
        </StackPanel>
        <!-- 第二行：计算字段（用户新建的公式字段，另起一行，横向单行，可左右滑动） -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="csv-label" Text="计算字段" Width="52" VerticalAlignment="Center"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ItemsControl ItemsSource="{Binding CalculatedFields}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="know:CsvFieldItem">
                    <local:CsvFieldChip/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="AddCalcButton" Content="＋计算字段" FontSize="11" Padding="6,2"
                      VerticalAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </StackPanel>

      <!-- 投放区（行维度 / 列维度 / 值 / 筛选） -->
      <StackPanel Grid.Row="1" Spacing="6">
        <!-- 行维度（多放） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="csv-label" Text="行维度" Width="52"/>
          <Border x:Name="RowDropZone" Classes="drop-zone" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding RowDimensions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="know:CsvFieldRef">
                  <local:CsvFieldChip/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- 列维度（单放；vintage 场景下即观测点 obs_point） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="csv-label" Text="列维度" Width="52"/>
          <Border x:Name="ColumnDropZone" Classes="drop-zone" HorizontalAlignment="Stretch">
            <ContentControl Content="{Binding ColumnDimension}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="know:CsvFieldRef">
                  <local:CsvFieldChip/>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </StackPanel>

        <!-- 值（多槽：普通字段单列 或 计算字段公式；可拖字段进入；每个值字段带自己的「▾设置」含百分比） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="csv-label" Text="值" Width="52"/>
          <Border x:Name="ValueDropZone" Classes="drop-zone" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ItemsControl ItemsSource="{Binding ValueFields}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="know:CsvValueSpec">
                    <Border Classes="csv-chip" Background="#330A7A0A" BorderBrush="#B45F06"
                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                        <TextBlock Text="%" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   IsVisible="{Binding AsPercent}"/>
                        <Button Content="▾" FontSize="11" Padding="3,0" Background="Transparent"
                                BorderThickness="0"
                                Click="OnValueSettingsClick"
                                Tag="{Binding}"/>
                        <Button Content="×" FontSize="11" Padding="2,0" Background="Transparent"
                                BorderThickness="0"
                                Click="OnValueRemoveClick"
                                Tag="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 筛选（多字段，每个字段可勾选保留哪些值过滤） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="csv-label" Text="筛选" Width="52"/>
          <Border x:Name="FilterDropZone" Classes="drop-zone" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding FilterFields}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="know:CsvFilterField">
                  <Border Classes="csv-chip" Background="#33333333" BorderBrush="#888888"
                          BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Field.Name}" FontSize="12"/>
                      <Button Content="值▾" FontSize="11" Padding="3,0" Background="Transparent"
                              BorderThickness="0"
                              Click="OnFilterValuesClick"
                              Tag="{Binding}"/>
                      <Button Content="×" FontSize="11" Padding="2,0" Background="Transparent"
                              BorderThickness="0"
                              Click="OnFilterRemoveClick"
                              Tag="{Binding}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ProDataGrid：动态列 + 虚拟化；单元格文本 CsvColumn.GenerateElement 零绑定直接赋值 -->
    <DataGrid Grid.Row="2" x:Name="DataGrid"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              UseLogicalScrollable="True"
              IsReadOnly="True"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"/>
  </Grid>
</UserControl>
