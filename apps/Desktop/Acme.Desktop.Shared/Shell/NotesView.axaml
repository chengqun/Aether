<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             xmlns:nav="using:Acme.Desktop.Mvvm"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:ctl="using:Acme.Desktop.Shared.Shell.Controls"
             x:Class="Acme.Desktop.Shared.Shell.NotesView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Border.note-card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="Button.notes-tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.notes-tool:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    <Style Selector="Button.notes-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Grid x:Name="TreeGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="120" MaxWidth="600"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid>
          <TreeView x:Name="NotesTree" Margin="4,4"
                    ItemsSource="{Binding Roots}"
                    SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="新建节点（同级）" Click="OnCreateSiblingClick" />
                <MenuItem Header="新建子节点" Click="OnCreateChildClick"
                          IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
                <Separator />
                <MenuItem Header="修改节点属性" Click="OnEditPropertiesClick"
                          IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
                <MenuItem Header="删除" Click="OnDeleteClick"
                          IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
                <Separator />
                <MenuItem Header="上移" Command="{Binding MoveNodeUpCommand}"
                          IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
                <MenuItem Header="下移" Command="{Binding MoveNodeDownCommand}"
                          IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <Grid HorizontalAlignment="Stretch" Background="Transparent">
                  <Border Background="{DynamicResource AccentBrush}" Opacity="0.22"
                          CornerRadius="4" IsVisible="{Binding IsDropTarget}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                          Fill="{Binding IconColor}" IsVisible="{Binding IconIsFill}" VerticalAlignment="Center"/>
                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{Binding IconColor}" IsVisible="{Binding !IconIsFill}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.Resources>
              <!-- 自定义 TreeViewItem 主题：
                   展开箭头固定在最左 16px 常驻列，不随节点宽度或层级变化；无子节点的项隐藏箭头
                   但保留该列宽（按 NoteNodeVM.Children.Count 判定，避免折叠父节点被误判为叶子）；
                   内容栏铺满整行并 hit-test，整行可点选（不再只有标题文字可点）。 -->
              <ControlTheme x:Key="NotesTreeViewItemTheme" TargetType="TreeViewItem"
                            BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="Template">
                  <ControlTemplate>
                    <Grid RowDefinitions="Auto,Auto">
                      <!-- 选中/悬停高亮：命名 PART_LayoutRoot（继承自默认主题的 :selected/:pointerover 样式
                           按 Border#PART_LayoutRoot 名命中并改其 Background）。Background 绑到模板父级
                           Background（默认透明且可 hit-test）让整行可点选；样式优先级高于 TemplateBinding，
                           故悬停/选中色仍能覆盖透明底色。chevron + 内容嵌在 Border 内，高亮覆盖整行内容。 -->
                      <Border x:Name="PART_LayoutRoot" Grid.Row="0"
                              CornerRadius="4"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}"
                              Focusable="True">
                        <Grid ColumnDefinitions="16,*">
                          <!-- 展开箭头：固定 16px 常驻列，不随节点宽度或层级变化。按 NoteNodeVM.Children.Count
                               判定有无子节点（折叠父节点的生成容器数 ItemCount=0 会误判，故用数据子节点数），
                               无子节点则隐藏箭头但保留该列宽（ContentPresenter 仍在 col 1，左缘对齐一致）。
                               箭头默认指向右（▶ 收起），展开时顺时针旋转 90° 变向下（▼ 展开）。 -->
                          <ToggleButton x:Name="PART_ExpandCollapseChevron"
                                        Grid.Column="0"
                                        Width="16" Height="16"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Margin="0" Focusable="False"
                                        RenderTransformOrigin="0.5,0.5"
                                        IsVisible="{Binding Children.Count, Converter={x:Static shell:CountToBoolConverter.Instance}}"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Path Data="M0,0 L8,5 L0,10 Z"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </ToggleButton>
                          <!-- 显式 Content/ContentTemplate TemplateBinding（Avalonia 无 ContentSource；
                               这是默认 Fluent TreeViewItem 模板的写法），让 TreeView.ItemTemplate
                               （TreeDataTemplate）正确套用到节点头，否则只渲染数据对象的 ToString()。 -->
                          <ContentPresenter x:Name="PART_HeaderPresenter"
                                            Grid.Column="1"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Focusable="False"/>
                        </Grid>
                      </Border>
                      <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="1"
                                      Margin="16,0,0,0"
                                      IsVisible="{TemplateBinding IsExpanded}"/>
                    </Grid>
                  </ControlTemplate>
                </Setter>
                <!-- 展开时箭头顺时针旋转 90°：▶ → ▼ -->
                <Style Selector="^ /template/ ToggleButton#PART_ExpandCollapseChevron[IsChecked=True]">
                  <Setter Property="RenderTransform">
                    <RotateTransform Angle="90"/>
                  </Setter>
                </Style>
              </ControlTheme>
            </TreeView.Resources>
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="Theme" Value="{StaticResource NotesTreeViewItemTheme}"/>
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="0,3"/>
              </Style>
            </TreeView.Styles>
          </TreeView>
          <!-- 空态：无笔记时提示（TreeView 空集合不渲染，此 TextBlock 占位） -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      IsVisible="{Binding !Roots.Count}" Spacing="6">
            <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center" Opacity="0.5" />
            <TextBlock Text="暂无笔记" FontSize="13" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="右键根节点或点上方「+」新建" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}" Cursor="SizeWestEast" />

      <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}">
        <Grid>
          <DockPanel IsVisible="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
            <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Data="{Binding SelectedNode.Icon}" Stretch="Uniform" Width="15" Height="15"
                        Fill="{Binding SelectedNode.IconColor}" IsVisible="{Binding SelectedNode.IconIsFill}" VerticalAlignment="Center"/>
                  <Path Data="{Binding SelectedNode.Icon}" Stretch="Uniform" Width="15" Height="15"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding SelectedNode.IconColor}" IsVisible="{Binding !SelectedNode.IconIsFill}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedNode.Title}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                           IsVisible="{Binding StatusMessage, Converter={x:Static shell:NotNullConverter.Instance}}"/>
                <Button Grid.Column="2" Classes="notes-tool" IsVisible="{Binding HasRightPane}"
                        Command="{Binding TogglePreviewOnlyCommand}" ToolTip.Tip="切换仅显示上栏 / 上下双栏">
                  <Path Data="{Binding IsPreviewOnly, Converter={x:Static shell:PreviewIconConverter.Instance}}"
                        Stretch="Uniform" Width="15" Height="15" StrokeThickness="1.6"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding $parent.Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </Grid>
            </Border>

            <Grid x:Name="SplitGrid">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- 下：源码编辑器 -->
              <edit:TextEditor Grid.Row="{Binding EditorRow}" Grid.RowSpan="{Binding EditorRowSpan}"
                       x:Name="CodeEditor" IsVisible="{Binding EditorVisible}"
                       ShowLineNumbers="False" WordWrap="True"
                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="{Binding EditorFontSize}"
                       Background="Transparent" Margin="8,6" />
              <!-- 中：可拖动分隔条（上下） -->
              <GridSplitter Grid.Row="1" IsVisible="{Binding SplitterVisible}" ResizeDirection="Rows"
                            Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}" Cursor="SizeNorthSouth" />
              <!-- 上栏容器：预览/表单（仅显示模式时跨满） -->
              <Grid Grid.Row="0" Grid.RowSpan="{Binding RightPaneRowSpan}"
                    IsVisible="{Binding RightPaneVisible}">
                <!-- markdown 渲染 -->
                <ctl:SelectableMarkdownViewer IsVisible="{Binding IsMarkdownNode}"
                       Markdown="{Binding SelectedNode.Content}"
                       AssetPathRoot="{Binding ImageRoot}"/>
                <!-- Agent 表单 -->
                <Border IsVisible="{Binding IsAgentNode}">
                  <shell:ExpertEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
                <!-- 规则表单（独立 RuleEditView，单 YAML 文档） -->
                <Border IsVisible="{Binding IsRuleNode}">
                  <shell:RuleEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
                <!-- 代码规则表单（复用 RuleEditView；NodeType=CodeRule，下栏为 C# 源码） -->
                <Border IsVisible="{Binding IsCodeRuleNode}">
                  <shell:RuleEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
                <!-- Workflow 表单 -->
                <Border IsVisible="{Binding IsWorkflowNode}">
                  <shell:WorkflowEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
                <!-- 知识对象表单 -->
                <Border IsVisible="{Binding IsKnowledgeNode}">
                  <shell:KnowledgeEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
              </Grid>
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>