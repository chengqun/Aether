<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Acme.Mobile.Shared.Views.AgentChatSurface"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:md="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
    xmlns:model="clr-namespace:Acme.Mobile.Mvvm.Models;assembly=Acme.Mobile.Mvvm"
    xmlns:views="clr-namespace:Acme.Mobile.Shared.Views"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters">

    <ContentView.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:MarkdownTableFillConverter x:Key="MarkdownTableFill" />
        <!-- 用户消息：右侧绿色气泡 -->
        <DataTemplate x:Key="UserTextTemplate" x:DataType="model:ChatMessageItem">
            <HorizontalStackLayout Margin="12,4" HorizontalOptions="End">
                <Border BackgroundColor="{StaticResource BubbleMine}" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12,8" MaximumWidthRequest="280">
                    <Label Text="{Binding Content}" TextColor="{StaticResource TextPrimary}" FontSize="15" LineBreakMode="WordWrap" />
                </Border>
            </HorizontalStackLayout>
        </DataTemplate>

        <!-- 助手消息：占满宽度的气泡 + Markdown（手机端尽量多显示内容） -->
        <DataTemplate x:Key="AssistantTextTemplate" x:DataType="model:ChatMessageItem">
            <Border Margin="12,4" HorizontalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BubbleOther}, Dark={StaticResource BubbleOtherDark}}"
                    StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12,8">
                <md:MarkdownView MarkdownText="{Binding Content, Converter={StaticResource MarkdownTableFill}}" Theme="{StaticResource AppMarkdownTheme}" UseAppTheme="True" />
            </Border>
        </DataTemplate>

        <!-- 工具调用：紧凑卡片 + 参数详情 -->
        <DataTemplate x:Key="ToolCallTemplate" x:DataType="model:ChatMessageItem">
            <HorizontalStackLayout Margin="12,2" HorizontalOptions="Start">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BubbleTool}, Dark={StaticResource BubbleToolDark}}"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6" MaximumWidthRequest="320">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🔧" FontSize="13" />
                            <Label Text="{Binding ToolName, StringFormat='调用 {0}'}" FontSize="13" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ToolDetail}" FontSize="11" FontFamily="OpenSansRegular"
                               LineBreakMode="CharacterWrap" MaxLines="6"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               IsVisible="{Binding ToolDetail, Converter={StaticResource StringToBool}}" />
                    </VerticalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </DataTemplate>

        <!-- 工具结果：紧凑卡片 + 返回详情 -->
        <DataTemplate x:Key="ToolResultTemplate" x:DataType="model:ChatMessageItem">
            <HorizontalStackLayout Margin="12,2" HorizontalOptions="Start">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BubbleTool}, Dark={StaticResource BubbleToolDark}}"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6" MaximumWidthRequest="320">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="✅" FontSize="13" />
                            <Label Text="{Binding ToolName, StringFormat='结果 {0}'}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ToolDetail}" FontSize="11" FontFamily="OpenSansRegular"
                               LineBreakMode="CharacterWrap" MaxLines="8"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               IsVisible="{Binding ToolDetail, Converter={StaticResource StringToBool}}" />
                    </VerticalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </DataTemplate>

        <!-- 思考：斜体灰色 -->
        <DataTemplate x:Key="ThinkingTemplate" x:DataType="model:ChatMessageItem">
            <HorizontalStackLayout Margin="12,2" HorizontalOptions="Start">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BubbleThinking}, Dark={StaticResource BubbleThinkingDark}}"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6" MaximumWidthRequest="300">
                    <Label Text="{Binding Content, StringFormat='💭 {0}'}" FontSize="13" FontAttributes="Italic"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </Border>
            </HorizontalStackLayout>
        </DataTemplate>

        <views:ChatMessageTemplateSelector x:Key="ChatMessageSelector"
            UserTextTemplate="{StaticResource UserTextTemplate}"
            AssistantTextTemplate="{StaticResource AssistantTextTemplate}"
            ToolCallTemplate="{StaticResource ToolCallTemplate}"
            ToolResultTemplate="{StaticResource ToolResultTemplate}"
            ThinkingTemplate="{StaticResource ThinkingTemplate}" />
    </ContentView.Resources>

    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="MessagesList"
                        Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        ItemTemplate="{StaticResource ChatMessageSelector}"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- 输入栏（AI tab 设 ShowInputBar=False 隐藏，由页面自带选择条+输入栏） -->
        <Border x:Name="InputBar" Grid.Row="1" Padding="8" BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="MessageEntry"
                       Text="{Binding MessageText}"
                       Placeholder="输入消息…"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendMessageCommand}" />
                <Button Grid.Column="1" Text="发送" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding CanSendMessage}" Padding="16,8" />
            </Grid>
        </Border>
    </Grid>

</ContentView>
