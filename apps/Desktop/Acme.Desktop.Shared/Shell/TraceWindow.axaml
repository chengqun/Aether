<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Acme.Desktop.Shared.Shell.TraceWindow"
        Title="运行 Trace"
        Width="720" Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel>
    <!-- 顶部工具栏 -->
    <Border DockPanel.Dock="Top" Padding="16,10" Background="White"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding FilterText}" Watermark="筛选（agent / status / 事件）"
                 Padding="8,4" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="↻" Command="{Binding RefreshCommand}" Padding="10,4" FontSize="12" Margin="6,0,0,0" ToolTip.Tip="刷新"/>
        <Button Grid.Column="2" Content="导出" Click="OnExportClick" Padding="10,4" FontSize="11" Margin="6,0,0,0" ToolTip.Tip="导出 JSON"/>
        <Button Grid.Column="3" Content="清空" Command="{Binding ClearCommand}" Padding="10,4" FontSize="11" Margin="6,0,0,0"/>
      </Grid>
    </Border>

    <ScrollViewer Padding="16,8">
      <ItemsControl ItemsSource="{Binding VisibleTraces}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
              <Expander IsExpanded="False">
                <Expander.Header>
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontSize="14"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                      <TextBlock Text="{Binding AgentId}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Mode, StringFormat={}[{0}]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                 IsVisible="{Binding Mode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <TextBlock Text="{Binding ToolCallCount, StringFormat={}🔧 {0}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StartTime, StringFormat={}{0:HH:mm:ss}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                  </Grid>
                </Expander.Header>
                <!-- 展开后：完整事件列表 -->
                <StackPanel Spacing="2" Margin="0,6,0,0">
                  <TextBlock Text="{Binding ConversationId, StringFormat={}conv: {0}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                          <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                          <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                          <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                     TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
