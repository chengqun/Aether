<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        xmlns:mdc="clr-namespace:Markdown.Avalonia.Controls;assembly=Markdown.Avalonia"
        x:Class="Acme.Desktop.Shared.Shell.Controls.MarkdownThemeStyles">

  <!-- 自有 Markdown 主题（取代 GithubLike）。
       原先 4 处 SelectableMarkdownViewer 设 MarkdownStyleName="GithubLike"——GithubLike 由
       MarkdownScrollViewer ctor Styles.Insert(0,…) 挂进控件自身 Styles（控件级 > app 级），且硬编码浅色
       （表格 #DFE2E5/#FFFFFF/White/#F6F8FA、代码块 DarkBlue/#12181F25、链接 Blue/Red…）→ 非 light 主题白块。
       现改为 MarkdownStyleName="Empty"（空主题），由本 Styles 提供【完整】markdown 样式：
       布局沿用 GithubLike 的 margin/font-size/padding（视觉不变），颜色全部绑 {DynamicResource} token
       → 跟随窗口主题 overlay。AgentMessageTheme 全元素覆盖：Text/Heading/Code/Table/Quote/Link。
       本 Styles 由 SelectableMarkdownViewer ctor Styles.Add 进来（Empty 在 [0]，本样式在后 → 生效）。 -->

  <!-- 正文 / 默认文字 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0, 5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- 段落 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Paragraph">
    <Setter Property="Margin" Value="0, 7, 0, 0"/>
  </Style>

  <!-- 标题 H1–H6（GithubLike 只到 H4，补 H5/H6） -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Heading1">
    <Setter Property="Margin" Value="0, 0, 15, 0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="UltraBold"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Heading2">
    <Setter Property="Margin" Value="0, 0, 15, 0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="21"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Heading3">
    <Setter Property="Margin" Value="0, 0, 10, 0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="17.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Heading4">
    <Setter Property="Margin" Value="0, 0, 5, 0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Heading5">
    <Setter Property="Margin" Value="0, 0, 5, 0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.Heading6">
    <Setter Property="Margin" Value="0, 0, 5, 0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- 引用块：品牌色竖线 + 表面底 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="5,0,0,0"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="0,6,6,0"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer StackPanel.Blockquote">
    <Setter Property="Margin" Value="10, 5"/>
  </Style>

  <!-- 行内代码：品牌色字 + 表面底 + 等宽 fallback（修 macOS Consolas 崩） -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CCode">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="MonospaceFontFamily" Value="ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,Courier New,monospace"/>
  </Style>

  <!-- 代码块：表面底 + 品牌色左竖条 + 圆角 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="4,0,0,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16, 10"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock">
    <Setter Property="FontFamily" Value="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"/>
    <Setter Property="FontSize" Value="11.9"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- Note 块 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Note">
    <Setter Property="Margin" Value="5,0,5,0"/>
    <Setter Property="Padding" Value="10, 5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="3,3,3,3"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>

  <!-- 列表 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.List">
    <Setter Property="Margin" Value="40,0,0,0"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CTextBlock.ListMarker">
    <Setter Property="Margin" Value="0,5,5,5"/>
  </Style>

  <!-- 表格：边框/表头/斑马纹全 token 化 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Table">
    <Setter Property="Margin" Value="5"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TightTable">
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table > Border">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="1,1,0,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Padding" Value="13, 6"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table">
    <Setter Property="mdc:AutoScaleColumnDefinitions.IsEnabled" Value="True"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader cb|CTextBlock">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.OddTableRow">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.EvenTableRow">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>

  <!-- 链接：品牌色 + hover -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer cb|CHyperlink">
    <Setter Property="IsUnderline" Value="true"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="HoverForeground" Value="{DynamicResource AccentHoverBrush}"/>
  </Style>

  <!-- 水平线 -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer mdc|Rule">
    <Setter Property="Margin" Value="0,3"/>
  </Style>

</Styles>
