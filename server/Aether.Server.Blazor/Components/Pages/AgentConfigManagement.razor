@page "/agent-config-management"
@inherits AbpComponentBase
@using Aether.Server.Application.Contracts.DTOs.AgentConfig
@using Aether.Server.Application.Contracts.Services.AgentConfig
@inject INoteNodeAppService NoteNodeAppService
@inject IAgentMarketplaceAppService AgentMarketplaceAppService
@inject IJSRuntime JS

<PageTitle>NoteNode 管理（Agent 市场）</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0"><i class="fas fa-stream me-2"></i>NoteNode 管理（Agent/Workflow 源文本）</h3>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus"></i> 新增 NoteNode
                </button>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex gap-3 mb-3 align-items-center">
                        <label class="form-label mb-0 me-1">类型:</label>
                        <select class="form-select form-select-sm" style="width:140px" value="@filterNodeType" @onchange="@(e => { filterNodeType = e?.Value?.ToString() ?? string.Empty; _ = OnFilterChanged(); })">
                            <option value="">全部</option>
                            <option value="Agent">Agent</option>
                            <option value="Workflow">专家团</option>
                            <option value="Note">笔记</option>
                        </select>
                        <label class="form-label mb-0 ms-2 me-1">市场:</label>
                        <select class="form-select form-select-sm" style="width:140px" value="@filterPublished" @onchange="@(e => { filterPublished = e?.Value?.ToString() ?? string.Empty; _ = OnFilterChanged(); })">
                            <option value="">全部</option>
                            <option value="yes">已发布</option>
                            <option value="no">未发布</option>
                        </select>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-3"><div class="spinner-border" role="status"></div></div>
                    }
                    else if (noteNodes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>标题</th>
                                        <th>类型</th>
                                        <th>用户</th>
                                        <th>分类</th>
                                        <th>市场</th>
                                        <th>更新时间</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var node in noteNodes)
                                    {
                                        <tr>
                                            <td>@node.Title</td>
                                            <td><span class="badge bg-secondary">@TypeBadge(node.NodeType)</span></td>
                                            <td>@(node.CreatorUserName ?? "-")</td>
                                            <td>@node.Category</td>
                                            <td>
                                                @if (node.IsPublished)
                                                { <span class="badge bg-success">已发布</span> }
                                                else
                                                { <span class="badge bg-light text-dark">未发布</span> }
                                            </td>
                                            <td>@(node.LastModifiedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => ShowEditModal(node))">编辑</button>
                                                @if (node.IsPublished)
                                                {
                                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="@(() => UnpublishAsync(node))">下架</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="@(() => PublishAsync(node))">发布</button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteAsync(node))">删除</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPages > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>共 @totalCount 条</div>
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="PrevPage">«</a>
                                        </li>
                                        @foreach (var p in GetPageNumbers())
                                        {
                                            if (p < 0)
                                            { <li class="page-item disabled"><span class="page-link">…</span></li> }
                                            else
                                            {
                                                <li class="page-item @(p == currentPage ? "active" : "")">
                                                    <a class="page-link" @onclick="@(() => GoToPage(p))">@p</a>
                                                </li>
                                            }
                                        }
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="NextPage">»</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">暂无 NoteNode</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (show_modal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "编辑 NoteNode" : "新增 NoteNode")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">标题 (Agent/Workflow 名)</label>
                        <input class="form-control" @bind="editing.Title" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">类型</label>
                            <select class="form-select" @bind="editing.NodeType">
                                <option value="Agent">Agent</option>
                                <option value="Workflow">专家团 (Workflow)</option>
                                <option value="Note">笔记</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">分类</label>
                            <input class="form-control" @bind="editing.Category" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">最低版本</label>
                            <input class="form-control" @bind="editing.MinAppVersion" placeholder="如 1.5" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">描述</label>
                        <input class="form-control" @bind="editing.Description" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">源文本 (front-matter + Markdown)</label>
                        <textarea class="form-control" rows="14" style="font-family:monospace" @bind="editing.Content"></textarea>
                        <small class="text-muted">YAML front-matter（--- 包裹）+ Markdown 提示词正文，即 agent/workflow 真相源。</small>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="isPublished" @bind="editing.IsPublished" />
                        <label class="form-check-label" for="isPublished">发布到市场</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">取消</button>
                    <button type="button" class="btn btn-primary" disabled="@isSaving" @onclick="SaveAsync">
                        @(isSaving ? "保存中..." : "保存")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
