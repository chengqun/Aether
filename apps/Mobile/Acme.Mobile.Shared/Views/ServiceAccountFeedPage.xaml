<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Mobile.Shared.Views.ServiceAccountFeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:sa="clr-namespace:Acme.ServiceAccount.Domain;assembly=Acme.ServiceAccount.Domain"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    x:DataType="vm:ServiceAccountFeedViewModel"
    Title="服务号">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <Label Grid.Row="0" Text="{Binding StatusMessage}"
               FontSize="13" Margin="16,8"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <CollectionView ItemsSource="{Binding Posts}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sa:ServiceAccountPostListItem">
                        <Border Style="{StaticResource CardFrame}" Margin="16,6">
                            <Grid RowDefinitions="Auto,Auto" Padding="12" RowSpacing="4">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToPostDetailCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Grid.GestureRecognizers>

                                <!-- cover + title + summary -->
                                <Grid Grid.Row="0" ColumnDefinitions="72,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="72" HeightRequest="72"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource NavBackground}, Dark={StaticResource NavBackgroundDark}}"
                                            StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                            HorizontalOptions="Start" VerticalOptions="Start">
                                        <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Start">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding Summary}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- meta -->
                                <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,4,0,0">
                                    <Label Text="{Binding ServiceAccountName}" FontSize="11"
                                           TextColor="{StaticResource Accent}" />
                                    <Label Text="·" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="{Binding ContentTypeDisplayName}" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="·" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
