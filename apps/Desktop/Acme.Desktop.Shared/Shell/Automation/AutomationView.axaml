<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.AutomationView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Border.auto-card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- 顶部标题栏 -->
    <Border DockPanel.Dock="Top" Classes="page-header">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Data="{x:Static shell:Codicons.Calendar}" Stretch="Uniform" Width="15" Height="15"
                  Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="自动化" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="定时运行专家" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                     Margin="12,0,0,0" />
          <Button Grid.Column="2" Content="+ 创建任务" Classes="primary" Click="OnAddTaskClick" Padding="14,6"
                  IsEnabled="{Binding !IsBusy}" />
        </Grid>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" />
      </StackPanel>
    </Border>

    <!-- 任务卡片列表 -->
    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- 空状态 -->
        <Border Classes="empty-state" IsVisible="{Binding !Tasks.Count}" Margin="0,40">
          <StackPanel>
            <Path Data="{x:Static shell:Codicons.Calendar}" Stretch="Uniform" Width="40" Height="40" HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="还没有定时任务" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="点击右上角「+ 创建任务」，让专家按计划自动运行" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 卡片网格 -->
        <ItemsControl ItemsSource="{Binding Tasks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="auto-card" Width="320">
                <StackPanel Spacing="6">
                  <!-- 标题行 + 启用徽章 -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{x:Static shell:Codicons.Calendar}" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TaskName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SuccessBgBrush}" VerticalAlignment="Center"
                            IsVisible="{Binding IsEnabled}">
                      <TextBlock Text="启用" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                    </Border>
                    <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource DangerBgBrush}" VerticalAlignment="Center"
                            IsVisible="{Binding !IsEnabled}">
                      <TextBlock Text="停用" FontSize="9" Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                  </StackPanel>

                  <!-- 触发专家 -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{x:Static shell:Codicons.Hubot}" Stretch="Uniform" Width="11" Height="11" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AgentName}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- 计划 -->
                  <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource AccentTintBgBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ScheduleDisplay}" FontSize="10"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Border>

                  <!-- 下次运行 -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="下次" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding NextRunDisplay}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>

                  <!-- 上次运行 -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="上次" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding LastRunDisplay}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>

                  <!-- 上次结果摘要 -->
                  <TextBlock Text="{Binding LastResultDisplay}" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                             MaxLines="3" IsVisible="{Binding LastResultDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <!-- 操作按钮 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="立即运行" Classes="primary tool" Click="OnRunNowClick" Tag="{Binding}" />
                    <Button Content="停用" Classes="tool" Click="OnToggleEnabledClick" Tag="{Binding}"
                            IsVisible="{Binding IsEnabled}" />
                    <Button Content="启用" Classes="tool" Click="OnToggleEnabledClick" Tag="{Binding}"
                            IsVisible="{Binding !IsEnabled}" />
                    <Button Content="编辑" Classes="tool" Click="OnEditClick" Tag="{Binding}" />
                    <Button Content="删除" Classes="danger tool" Click="OnDeleteClick" Tag="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
