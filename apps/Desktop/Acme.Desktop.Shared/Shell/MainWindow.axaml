<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Desktop.Shared.Shell.MainWindow"
        Title="Aether 桌面"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="Auto,*">

    <!-- ═══ 展开态侧边栏（220px，图标+文字） ═══ -->
    <Border Grid.Column="0" Width="220" IsVisible="{Binding IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
          <Button Command="{Binding ToggleSidebarCommand}" Classes="settings-nav" ToolTip.Tip="收起侧边栏">
            <TextBlock Text="☰" FontSize="15"/>
          </Button>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="settings-nav" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        IsEnabled="{Binding !IsCurrent}" ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Icon}" FontSize="16"/>
                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="settings-nav" Command="{Binding NewChatCommand}" Margin="0,8,0,0"
                  ToolTip.Tip="新聊天">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="✏️" FontSize="16"/>
              <TextBlock Text="新聊天" FontSize="14"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 最近会话列表 -->
        <ScrollViewer Grid.Row="1" Margin="8,8,8,8" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Conversations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="conv-item" HorizontalAlignment="Stretch"
                        Command="{Binding DataContext.ResumeConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="删除"
                                Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </MenuFlyout>
                  </Button.ContextFlyout>
                  <Grid Margin="2,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="{Binding Preview}" FontSize="11" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Classes="account-chip" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="{Binding UserName}" IsEnabled="False"/>
              <MenuItem Header="设置" Command="{Binding ShowSettingsCommand}"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Orientation="Vertical" Spacing="2">
              <TextBlock Text="{Binding UserName}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Tenant}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 收起态侧边栏（48px，纯图标 rail） ═══ -->
    <Border Grid.Column="0" Width="48" IsVisible="{Binding !IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
          <Button Command="{Binding ToggleSidebarCommand}" Classes="nav-rail" ToolTip.Tip="展开侧边栏">
            <TextBlock Text="☰" FontSize="15"/>
          </Button>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="nav-rail" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        IsEnabled="{Binding !IsCurrent}" ToolTip.Tip="{Binding Title}">
                  <TextBlock Text="{Binding Icon}" FontSize="16"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Button Grid.Row="2" Classes="account-rail" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="{Binding UserName}" IsEnabled="False"/>
              <MenuItem Header="设置" Command="{Binding ShowSettingsCommand}"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 内容区（View 实例驻留，IsVisible 切换，保持状态） ═══ -->
    <Grid Grid.Column="1" Background="{DynamicResource ContentBgBrush}">
      <shell:ChatView x:Name="ChatViewInstance" DataContext="{Binding}" IsVisible="{Binding IsChatPage}" />
      <shell:NotesView x:Name="NotesViewInstance" DataContext="{Binding Notes}"
          IsVisible="{Binding DataContext.IsNotesPage, RelativeSource={RelativeSource AncestorType=Window}}" />
      <shell:ExpertsView x:Name="ExpertsViewInstance" DataContext="{Binding Experts}"
          IsVisible="{Binding DataContext.IsExpertsPage, RelativeSource={RelativeSource AncestorType=Window}}" />
      <TextBlock x:Name="PlaceholderView" Text="即将上线…"
                 FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding IsPlaceholderPage}" />
    </Grid>

  </Grid>
</Window>
