<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Acme.Desktop.Shared.Shell.WorkflowGraphWindow"
        Title="工作流转交图"
        Width="760" Height="640" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="节点=参与者，箭头=转交边（标注=原因），高亮=入口" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        <Button Content="复制 Mermaid" Classes="tool" Click="OnCopyMermaidClick" Padding="10,4" FontSize="11"/>
      </StackPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
      <Canvas x:Name="GraphCanvas" Background="Transparent"/>
    </ScrollViewer>
  </DockPanel>
</Window>
