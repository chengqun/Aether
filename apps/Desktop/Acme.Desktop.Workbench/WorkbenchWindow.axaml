<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="using:Acme.Desktop.Mvvm"
        x:Class="Acme.Desktop.Workbench.WorkbenchWindow"
        Title="Aether"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WorkspaceBackground}"
        FontFamily="{DynamicResource UiFont}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 内置 light 主题 + 设计 token 层（颜色/字体/圆角/间距/背景）。JSON theme 经 ThemeLoader 叠加覆盖。 -->
        <ResourceInclude Source="avares://Acme.Desktop.Workbench/Themes/WorkbenchTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
    <!-- ═══ 展开态侧边栏（200px） ═══ -->
    <Border DockPanel.Dock="Left" Width="200" IsVisible="{Binding IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Classes="account-chip" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="⚙ 设置" Command="{Binding ShowSettingsCommand}"/>
              <MenuItem Header="🔍 运行 Trace" Click="OnOpenTrace"/>
              <MenuItem Header="↺ 重置布局" Command="{Binding ResetLayoutCommand}"/>
              <MenuItem Header="🎨 主题" ItemsSource="{Binding Themes}">
                <MenuItem.ItemTemplate>
                  <DataTemplate>
                    <MenuItem Header="{Binding Name}"
                              Command="{Binding $parent[MenuItem].DataContext.SelectThemeCommand}"
                              CommandParameter="{Binding Name}"
                              IsEnabled="{Binding !IsCurrent}"/>
                  </DataTemplate>
                </MenuItem.ItemTemplate>
              </MenuItem>
              <MenuItem Header="━" IsEnabled="False"/>
              <MenuItem Header="🔑 登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="🚪 退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="{DynamicResource CornerRadiusLg}" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="{Binding UserInitial}" Foreground="{DynamicResource OnAccentBrush}" FontSize="13" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Orientation="Vertical" Spacing="1">
              <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Tenant}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Button>

        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding ToggleSidebarCommand}" Classes="settings-nav"
                    ToolTip.Tip="收起侧边栏" HorizontalAlignment="Right">
              <Path Data="{x:Static nav:NavIcons.Menu}" Stretch="Uniform" Width="18" Height="18"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding WorkbenchNavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="settings-nav" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="18" Height="18"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border/>
      </DockPanel>
    </Border>

    <!-- ═══ 收起态侧边栏（48px） ═══ -->
    <Border DockPanel.Dock="Left" Width="48" IsVisible="{Binding !IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
          <Button Command="{Binding ToggleSidebarCommand}" Classes="nav-rail" ToolTip.Tip="展开侧边栏">
            <Path Data="{x:Static nav:NavIcons.Menu}" Stretch="Uniform" Width="18" Height="18"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <ItemsControl ItemsSource="{Binding WorkbenchNavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="nav-rail" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        ToolTip.Tip="{Binding Title}">
                  <Path Data="{Binding Icon}" Stretch="Uniform" Width="18" Height="18"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Button Grid.Row="2" Classes="account-rail" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="⚙ 设置" Command="{Binding ShowSettingsCommand}"/>
              <MenuItem Header="🔍 运行 Trace" Click="OnOpenTrace"/>
              <MenuItem Header="↺ 重置布局" Command="{Binding ResetLayoutCommand}"/>
              <MenuItem Header="🎨 主题" ItemsSource="{Binding Themes}">
                <MenuItem.ItemTemplate>
                  <DataTemplate>
                    <MenuItem Header="{Binding Name}"
                              Command="{Binding $parent[MenuItem].DataContext.SelectThemeCommand}"
                              CommandParameter="{Binding Name}"
                              IsEnabled="{Binding !IsCurrent}"/>
                  </DataTemplate>
                </MenuItem.ItemTemplate>
              </MenuItem>
              <MenuItem Header="━" IsEnabled="False"/>
              <MenuItem Header="🔑 登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="🚪 退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <Border Width="28" Height="28" CornerRadius="{DynamicResource CornerRadiusLg}" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="{Binding UserInitial}" Foreground="{DynamicResource OnAccentBrush}" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 工作台主区（Workspace 决定布局，非 Window） ═══ -->
    <ContentControl Content="{Binding ActiveWorkspace}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="{DynamicResource ContentBgBrush}"/>
  </DockPanel>
</Window>
