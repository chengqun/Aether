@page "/llm-config-management"
@inherits AbpComponentBase
@using Aether.Server.Application.Contracts.DTOs.AgentConfig
@using Aether.Server.Application.Contracts.Services.AgentConfig
@inject ILlmConfigAppService LlmConfigAppService
@inject IJSRuntime JS

<PageTitle>LLM 配置管理</PageTitle>

<div class="container-fluid py-4">
    <!-- 系统级 LLM 配置 -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0"><i class="fas fa-server me-2"></i>系统级 LLM 配置</h3>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateSystemLlmModal">
                    <i class="fas fa-plus"></i> 新增系统LLM配置
                </button>
            </div>
            <div class="card">
                <div class="card-body">
                    @if (isLoadingSystemLlm)
                    {
                        <div class="text-center py-3"><div class="spinner-border" role="status"></div></div>
                    }
                    else if (systemLlmConfigs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>名称</th>
                                        <th>模型</th>
                                        <th>Endpoint</th>
                                        <th>ApiKey</th>
                                        <th>Temperature</th>
                                        <th>默认</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var config in systemLlmConfigs)
                                    {
                                        <tr>
                                            <td>
                                                @config.Name
                                                <span class="badge badge-info ml-1">系统</span>
                                            </td>
                                            <td>@config.ModelName</td>
                                            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@config.Endpoint">@config.Endpoint</td>
                                            <td><code>@MaskApiKey(config.ApiKey)</code></td>
                                            <td>@config.Temperature</td>
                                            <td>
                                                @if (config.IsDefault)
                                                {
                                                    <span class="badge badge-success">系统默认</span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => SetSystemDefaultLlm(config)">设为系统默认</button>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-warning me-1" @onclick="() => ShowEditSystemLlmModal(config)">编辑</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSystemLlmConfig(config)">删除</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-server" style="font-size: 32px;"></i>
                            <p class="mt-2">暂无系统级LLM配置</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 用户级 LLM 配置 -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0"><i class="fas fa-brain me-2"></i>用户级 LLM 配置</h3>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateLlmModal">
                    <i class="fas fa-plus"></i> 新增LLM配置
                </button>
            </div>
            <div class="card">
                <div class="card-body">
                    @if (isLoadingLlm)
                    {
                        <div class="text-center py-3"><div class="spinner-border" role="status"></div></div>
                    }
                    else if (llmConfigs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>名称</th>
                                        <th>模型</th>
                                        <th>Endpoint</th>
                                        <th>ApiKey</th>
                                        <th>Temperature</th>
                                        <th>用户</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var config in llmConfigs)
                                    {
                                        <tr>
                                            <td>@config.Name</td>
                                            <td>@config.ModelName</td>
                                            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@config.Endpoint">@config.Endpoint</td>
                                            <td><code>@MaskApiKey(config.ApiKey)</code></td>
                                            <td>@config.Temperature</td>
                                            <td>@(config.CreatorUserName ?? config.CreatorId?.ToString() ?? "-")</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-warning me-1" @onclick="() => ShowEditLlmModal(config)">编辑</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLlmConfig(config)">删除</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-plug" style="font-size: 32px;"></i>
                            <p class="mt-2">暂无LLM配置，请先添加</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- LLM 配置 Modal -->
<div class="modal" tabindex="-1" role="dialog" style="display: @(showLlmModal ? "block" : "none");" @onclick="CloseLlmModal">
    <div class="modal-dialog" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (isSystemLlm)
                    {
                        <span><i class="fas fa-server me-1"></i>@(isEditingLlm ? "编辑系统LLM配置" : "新增系统LLM配置")</span>
                    }
                    else
                    {
                        <span>@(isEditingLlm ? "编辑LLM配置" : "新增LLM配置")</span>
                    }
                </h5>
                <button type="button" class="close" aria-label="Close" @onclick="CloseLlmModal"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>配置名称</label>
                    <input type="text" class="form-control" @bind="editingLlm.Name" placeholder="如 DeepSeek、GPT-4o" />
                </div>
                <div class="form-group">
                    <label>模型名称</label>
                    <input type="text" class="form-control" @bind="editingLlm.ModelName" placeholder="如 deepseek-chat" />
                </div>
                <div class="form-group">
                    <label>ApiKey</label>
                    <input type="text" class="form-control" @bind="editingLlm.ApiKey" placeholder="API密钥" />
                </div>
                <div class="form-group">
                    <label>Endpoint</label>
                    <input type="text" class="form-control" @bind="editingLlm.Endpoint" placeholder="如 https://api.deepseek.com/v1" />
                </div>
                <div class="form-group">
                    <label>Temperature</label>
                    <input type="number" class="form-control" @bind="editingLlm.Temperature" step="0.1" min="0" max="2" placeholder="0.5" />
                </div>
                @if (isSystemLlm)
                {
                    <div class="form-group">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" @bind="editingLlm.IsDefault" />
                            <label class="form-check-label">设为系统默认配置</label>
                            <small class="d-block text-muted">系统默认 LLM 是所有未指定 LLM 的 Agent 共享使用的</small>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseLlmModal">取消</button>
                <button type="button" class="btn btn-primary" @onclick="SaveLlmConfig" disabled="@isSaving">
                    @if (isSaving) { <div class="spinner-border spinner-border-sm" role="status"></div> }
                    else { <span>保存</span> }
                </button>
            </div>
        </div>
    </div>
</div>

@if (showLlmModal)
{
    <div class="modal-backdrop fade show"></div>
}
