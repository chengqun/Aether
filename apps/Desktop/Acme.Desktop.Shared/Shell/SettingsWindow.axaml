<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Desktop.Shared.Shell.SettingsWindow"
        Title="设置"
        Width="900" Height="550"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <local:MaskApiKeyConverter x:Key="MaskApiKeyConverter"/>
  </Window.Resources>

  <Grid ColumnDefinitions="180,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="8">
        <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Margin="10,12,0,20"/>
        
        <Button Classes="settings-nav" Content="⚙️ LLM 配置"
                Command="{Binding SwitchTabCommand}" CommandParameter="llm"
                IsEnabled="{Binding IsNotLlmTab}"/>
        <Button Classes="settings-nav" Content="🔗 设备连接"
                Command="{Binding SwitchTabCommand}" CommandParameter="device"
                IsEnabled="{Binding IsNotDeviceTab}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="20" HorizontalScrollBarVisibility="Auto">
      <Grid>
        <Grid x:Name="LlmSection" IsVisible="{Binding IsLlmTabActive}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <TextBlock Text="LLM 配置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="+ 新增配置" Classes="primary" Margin="16,0,0,0"
                      Command="{Binding ShowAddLlmModalCommand}"/>
            </StackPanel>

            <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="0">
              <StackPanel>
                <Grid ColumnDefinitions="*,120,200,140,80,100,140" Background="#F8F9FA">
                  <TextBlock Grid.Column="0" Text="名称" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8"/>
                  <TextBlock Grid.Column="1" Text="模型" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8"/>
                  <TextBlock Grid.Column="2" Text="Endpoint" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8"/>
                  <TextBlock Grid.Column="3" Text="API Key" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8"/>
                  <TextBlock Grid.Column="4" Text="温度" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8"/>
                  <TextBlock Grid.Column="5" Text="默认" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8"/>
                  <TextBlock Grid.Column="6" Text="操作" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8" HorizontalAlignment="Right"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding LlmConfigs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" 
                              BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,120,200,140,80,100,140">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                      Margin="12,10">
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                            <Border Background="#6B7280" Padding="3,1,3,1" CornerRadius="3"
                                    IsVisible="{Binding IsSystem}">
                              <TextBlock Text="系统" FontSize="10" Foreground="White"/>
                            </Border>
                          </StackPanel>

                          <TextBlock Grid.Column="1" Text="{Binding ModelName}" FontSize="13"
                                     VerticalAlignment="Center" Padding="12,10"/>
                          <TextBlock Grid.Column="2" Text="{Binding Endpoint}" FontSize="13"
                                     VerticalAlignment="Center" Padding="12,10"
                                     ToolTip.Tip="{Binding Endpoint}"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="3" Text="{Binding ApiKey, Converter={StaticResource MaskApiKeyConverter}}"
                                     FontSize="12" VerticalAlignment="Center" Padding="12,10" FontFamily="Consolas"/>
                          <TextBlock Grid.Column="4" Text="{Binding Temperature}" FontSize="13"
                                     VerticalAlignment="Center" Padding="12,10"/>

                          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                      Margin="12,10">
                            <Border Background="#28A745" Padding="4,1,4,1" CornerRadius="3"
                                    IsVisible="{Binding IsDefault}">
                              <TextBlock Text="默认" FontSize="10" Foreground="White"/>
                            </Border>
                            <Button Content="设为默认" Padding="6,2" FontSize="11"
                                    IsVisible="{Binding !IsDefault}"
                                    Classes="outline-success"
                                    Command="{Binding DataContext.SetDefaultLlmConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>

                          <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="12,10">
                            <Button Content="编辑" Padding="6,3" FontSize="12"
                                    Classes="outline-warning"
                                    Command="{Binding DataContext.EditLlmConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="删除" Padding="6,3" FontSize="12"
                                    IsEnabled="{Binding !IsSystem}"
                                    Classes="outline-danger"
                                    Command="{Binding DataContext.DeleteLlmConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,20,0,20" Orientation="Vertical" VerticalAlignment="Center"
                            IsVisible="{Binding HasNoLlmConfigs}">
                  <TextBlock Text="暂无 LLM 配置" FontSize="14" 
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" Margin="0,0,0,4"/>
                  <TextBlock Text="点击上方「新增配置」按钮添加" FontSize="12" 
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding LlmError}" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" Margin="0,8,0,0"
                       IsVisible="{Binding HasLlmError}"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="DeviceSection" IsVisible="{Binding IsDeviceTabActive}">
          <StackPanel>
            <TextBlock Text="设备连接" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="8">
              <StackPanel Margin="16">
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址" FontSize="13" 
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceServerUrl}" 
                           Margin="8,0,0,10" PlaceholderText="如 https://api.example.com"
                           Classes="input"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="设备认证码" FontSize="13" 
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceAuthorizationCode}" 
                           Margin="8,0,0,10" PlaceholderText="输入设备认证码"
                           Classes="input"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="设备名称" FontSize="13" 
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeviceName}" 
                           Margin="8,0,0,10" PlaceholderText="如 桌面助手"
                           Classes="input"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="设备类型" FontSize="13" 
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeviceType}" 
                           Margin="8,0,0,10" IsReadOnly="True"
                           Classes="input"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="当前租户" FontSize="13" 
                             VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DeviceTenant}" 
                           Margin="8,0,0,10" IsReadOnly="True"
                           Classes="input"/>

                  <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                          Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" 
                          CornerRadius="6" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <CheckBox IsChecked="{Binding AutoConnect}" FontSize="13" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Vertical">
                        <TextBlock Text="自动连接" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="启动时自动使用保存的配置连接到服务器" FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                          CornerRadius="6" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="12" Height="12" CornerRadius="6" 
                              Background="{Binding ConnectionStatusColor}"/>
                      <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="13" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="使用设备认证码连接到服务器" FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                             Text="{Binding DeviceError}" FontSize="12"
                             Foreground="{DynamicResource DangerBrush}"
                             IsVisible="{Binding HasDeviceError}" Margin="0,0,0,10"/>

                  <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" 
                              Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="连接" Classes="primary"
                            IsEnabled="{Binding CanConnect}"
                            Command="{Binding ConnectDeviceCommand}"/>
                    <Button Content="断开"
                            IsEnabled="{Binding IsDeviceConnected}"
                            Command="{Binding DisconnectDeviceCommand}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>