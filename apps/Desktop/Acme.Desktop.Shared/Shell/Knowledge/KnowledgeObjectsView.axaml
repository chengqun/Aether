<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.KnowledgeObjectsView"
             Background="{DynamicResource CardBgBrush}">

  <UserControl.Styles>
    <!-- 状态条按钮（保存） -->
    <Style Selector="Button.ko-head">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.ko-head:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- 知识对象右栏（左 .ok 树在 LeftTree 切换层 KoTreeView，按 knowledge tab 切显隐，镜像文档页 FileTreeView+DocumentsEditorView）。
       状态条 + 上下两栏（上=表单，下=源码）。 -->
  <Grid RowDefinitions="Auto,*">
    <!-- 状态条：dirty 指示 + 名称 + 状态消息 + 保存 -->
    <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ko-head" Command="{Binding SaveCommand}"
                ToolTip.Tip="保存 (Ctrl+S)" VerticalAlignment="Center" Margin="4,0,0,0">
          <Path Data="{x:Static shell:Codicons.Save}" Stretch="Uniform" Width="14" Height="14"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="8,0,6,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   IsVisible="{Binding StatusMessage, Converter={x:Static shell:NotNullConverter.Instance}}"/>
        <Path DockPanel.Dock="Left" Data="{x:Static shell:Codicons.Dot}" Stretch="Uniform"
              Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource AccentBrush}"
              IsVisible="{Binding IsDirty}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ActiveKnowledgeVm.Name}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" FontWeight="SemiBold"
                   IsVisible="{Binding HasActiveKnowledge}"/>
        <TextBlock Text="选择左侧 .md 文件查看知识对象" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   IsVisible="{Binding !HasActiveKnowledge}"/>
      </DockPanel>
    </Border>

    <!-- 上下两栏：上=表单，下=源码（镜像 DocumentsEditorView .ok 双栏） -->
    <Grid Grid.Row="1" x:Name="EditorGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 上栏：知识对象表单（复用 DocumentKnowledgeView，零改） -->
      <shell:DocumentKnowledgeView Grid.Row="0"
                                   DataContext="{Binding ActiveKnowledgeVm}"
                                   IsVisible="{Binding HasActiveKnowledge}"/>

      <!-- 中：上下分隔条 -->
      <GridSplitter Grid.Row="1" IsVisible="{Binding HasActiveKnowledge}"
                    Height="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}" Cursor="SizeNorthSouth"/>

      <!-- 下栏：源码编辑器 + 空态 -->
      <Grid Grid.Row="2">
        <edit:TextEditor x:Name="CodeEditor"
                         ShowLineNumbers="False" WordWrap="True"
                         FontFamily="Menlo,Monaco,Consolas,monospace"
                         FontSize="{Binding EditorFontSize}"
                         Background="Transparent" Margin="8,6"
                         IsReadOnly="False"
                         IsVisible="{Binding HasActiveKnowledge}"/>
        <Border Background="{DynamicResource CardBgBrush}" IsVisible="{Binding !HasActiveKnowledge}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="10" Opacity="0.6">
            <Path Data="{x:Static shell:Codicons.Collection}" Stretch="Uniform" Width="36" Height="36"
                  HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="知识对象（.md 文件）" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="跨项目复用的知识资产；左树点 .md → 上栏表单 + 下栏 YAML 源码" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
