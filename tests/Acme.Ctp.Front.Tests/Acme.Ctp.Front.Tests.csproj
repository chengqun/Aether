<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\business\CtpFront\Acme.Ctp.Front\Acme.Ctp.Front.csproj" />
    <!-- 进程分离形态（2026-10-05）：FrontLoopback 组合 core + SimRpcServer（交易所）+ RPC 前置——需 Sim.Server/Simulator -->
    <ProjectReference Include="..\..\business\CtpExchange\Acme.Ctp.Sim.Server\Acme.Ctp.Sim.Server.csproj" />
    <ProjectReference Include="..\..\business\CtpExchange\Acme.Ctp.Simulator\Acme.Ctp.Simulator.csproj" />
    <ProjectReference Include="..\..\externals\Ctp.Net.Core\Ctp.Net.Core.csproj" />
  </ItemGroup>

  <!-- libctp_native.dylib 的 @rpath 依赖三个 macOS frameworks（thosttraderapi_se/thostmduserapi_se/MacDataCollect）——
       Ctp.Net.Core 的 Content 只带 build/native 的 dylib/so/dll，frameworks 不在其中；
       dyld 载入时全部链接镜像即解析，缺一个就 DllNotFoundError。此处构建后复制到输出目录
       （cp -R 保留 frameworks 的 Versions/A symlink 结构；重复执行为幂等合并覆盖）。 -->
  <PropertyGroup>
    <CtpSdkDir>$(MSBuildThisFileDirectory)../../externals/Ctp.Net.Core/ctp-sdk/macos-universal</CtpSdkDir>
  </PropertyGroup>
  <Target Name="CopyCtpMacFrameworks" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Message Importance="high" Text="复制 CTP macOS frameworks → $(OutDir)" />
    <Exec Command='cp -R "$(CtpSdkDir)/thosttraderapi_se.framework" "$(OutDir)"' />
    <Exec Command='cp -R "$(CtpSdkDir)/thostmduserapi_se.framework" "$(OutDir)"' />
    <Exec Command='cp -R "$(CtpSdkDir)/MacDataCollect.framework" "$(OutDir)"' />
  </Target>

</Project>
