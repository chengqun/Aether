<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.TerminalView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <!-- 终端标签按钮：活跃态加粗 + 亮底 -->
    <Style Selector="Button.term-tab">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.term-tab:active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.term-tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarBgBrush}"/>
    </Style>
    <Style Selector="Button.term-close">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.term-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <!-- 关闭按钮内容已从文字「✕」改为 codicon Path；Path.Fill 绑按钮 Foreground（非 TextElement.Foreground），
         故 :pointerover 须改按钮 Foreground 属性让图标随 accent 底反白。 -->
    <Style Selector="Button.term-close:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <!-- 空态占位「新建终端」按钮（零会话时唯一新建入口；常驻样式 term-new 已随 [+] 删除） -->
    <Style Selector="Button.term-empty">
      <Setter Property="Background" Value="{DynamicResource SidebarBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.term-empty:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- 标签条：仅会话 tab（切换/关闭）。无 [+]（新建只在空态占位/agent 路径）与 [▼]（折叠与标题栏终端 toggle
         同一 SetPanelVisible 调用，纯重复控件）——2026-09-23 按用户心智删除「+ 下拉」冗余部分。 -->
    <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <ItemsControl ItemsSource="{Binding Sessions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="term-tab"
                        Command="{Binding $parent[UserControl].DataContext.SwitchSessionCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Title}"/>
                    <!-- shell 已退出标记 -->
                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding !IsRunning}" VerticalAlignment="Center"/>
                    <!-- 活跃会话下划线 -->
                    <Border Height="2" Background="{DynamicResource AccentBrush}"
                            IsVisible="{Binding IsActive}" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="term-close"
                        Command="{Binding $parent[UserControl].DataContext.CloseSessionCommand}"
                        CommandParameter="{Binding}">
                  <Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="10" Height="10"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <!-- 终端控件宿主：每会话一个 RoyalTerminal TerminalControl，靠 IsVisible 切换。
         空态占位：删掉标签条 [+] 后，关掉全部会话时唯一的新建入口（平时不可见，零常驻 chrome）。 -->
    <Panel Grid.Row="1">
      <Grid x:Name="ContentHost" Background="{DynamicResource TerminalBgBrush}"/>
      <Button Command="{Binding NewSessionCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="16,8" Classes="term-empty"
              IsVisible="{Binding HasNoSessions}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Data="{x:Static shell:Codicons.Add}" Stretch="Uniform" Width="14" Height="14"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="新建终端" FontSize="13"/>
        </StackPanel>
      </Button>
    </Panel>
  </Grid>
</UserControl>
