<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             xmlns:nav="using:Acme.Shell"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:ctl="using:Acme.Desktop.Shared.Shell.Controls"
             x:Class="Acme.Desktop.Shared.Shell.NotesView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Styles>
    <Style Selector="Border.note-card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="Button.notes-tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.notes-tool:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="#F5F5F5"/>
    </Style>
    <Style Selector="Button.notes-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 已打开笔记 tab 栏 -->
    <Style Selector="ListBox.note-tabs">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.note-tabs > ListBoxItem">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="ListBox.note-tabs > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ListBox.note-tabs > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" Background="White"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Path Data="{x:Static nav:NavIcons.Notes}" Stretch="Uniform" Width="18" Height="18"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="笔记" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="右键菜单操作" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="TreeGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="120" MaxWidth="600"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <TreeView x:Name="NotesTree" Margin="4,4"
                  ItemsSource="{Binding Roots}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="新建节点（同级）" Click="OnCreateSiblingClick" />
              <MenuItem Header="新建子节点" Click="OnCreateChildClick"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              <Separator />
              <MenuItem Header="修改节点属性" Click="OnEditPropertiesClick"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              <MenuItem Header="删除" Click="OnDeleteClick"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              <Separator />
              <MenuItem Header="上移" Command="{Binding MoveNodeUpCommand}"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
              <MenuItem Header="下移" Command="{Binding MoveNodeDownCommand}"
                        IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <Grid HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource AccentBrush}" Opacity="0.22"
                        CornerRadius="4" IsVisible="{Binding IsDropTarget}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                        Fill="{Binding IconColor}" IsVisible="{Binding IconIsFill}" VerticalAlignment="Center"/>
                  <Path Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding IconColor}" IsVisible="{Binding !IconIsFill}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="Padding" Value="2,1"/>
            </Style>
            <!-- 箭头三角大小不变，只压缩容器空白让其紧贴节点 -->
            <Style Selector="TreeViewItem /template/ ToggleButton">
              <Setter Property="Width" Value="12"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
            </Style>
            <!-- 选中后背景变深，文字转白保证可读 -->
            <Style Selector="TreeViewItem:selected">
              <Setter Property="Foreground" Value="White"/>
            </Style>
          </TreeView.Styles>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}" Cursor="SizeWestEast" />

      <Border Grid.Column="2" Background="White">
        <Grid>
          <DockPanel IsVisible="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}">
            <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- 已打开笔记 tab：点击切换活动节点，✕ 关闭 -->
                <ListBox Grid.Column="0" Classes="note-tabs"
                         ItemsSource="{Binding OpenNodes}"
                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="1" Classes="notes-tool" IsVisible="{Binding HasRightPane}"
                        Command="{Binding TogglePreviewOnlyCommand}" ToolTip.Tip="切换仅显示上栏 / 上下双栏">
                  <Path Data="{Binding IsPreviewOnly, Converter={x:Static shell:PreviewIconConverter.Instance}}"
                        Stretch="Uniform" Width="15" Height="15" StrokeThickness="1.6"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding $parent.Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Grid.Column="2" Classes="notes-primary" Command="{Binding SaveNoteCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Data="{x:Static nav:NavIcons.Save}" Stretch="Uniform" Width="14" Height="14"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="White"/>
                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Grid x:Name="SplitGrid">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- 下：源码编辑器 -->
              <edit:TextEditor Grid.Row="{Binding EditorRow}" Grid.RowSpan="{Binding EditorRowSpan}"
                       x:Name="CodeEditor" IsVisible="{Binding EditorVisible}"
                       ShowLineNumbers="False" WordWrap="True"
                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="{Binding EditorFontSize}"
                       Background="Transparent" Margin="8,6" />
              <!-- 中：可拖动分隔条（上下） -->
              <GridSplitter Grid.Row="1" IsVisible="{Binding SplitterVisible}" ResizeDirection="Rows"
                            Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}" Cursor="SizeNorthSouth" />
              <!-- 上栏容器：预览/表单（仅显示模式时跨满） -->
              <Grid Grid.Row="0" Grid.RowSpan="{Binding RightPaneRowSpan}"
                    IsVisible="{Binding RightPaneVisible}">
                <!-- markdown 渲染 -->
                <ctl:SelectableMarkdownViewer IsVisible="{Binding IsMarkdownNode}"
                       Markdown="{Binding SelectedNode.Content}" MarkdownStyleName="Standard"
                       AssetPathRoot="{Binding ImageRoot}"/>
                <!-- Agent 表单 -->
                <Border IsVisible="{Binding IsAgentNode}">
                  <shell:ExpertEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
                <!-- Workflow 表单 -->
                <Border IsVisible="{Binding IsWorkflowNode}">
                  <shell:WorkflowEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
                <!-- 知识对象表单 -->
                <Border IsVisible="{Binding IsKnowledgeNode}">
                  <shell:KnowledgeEditView DataContext="{Binding ActiveEditVm}"/>
                </Border>
              </Grid>
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>