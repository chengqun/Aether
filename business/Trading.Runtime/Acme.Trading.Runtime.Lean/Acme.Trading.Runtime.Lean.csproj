    <ProjectReference Include="..\..\..\externals\Lean\Common\QuantConnect.csproj" />
    <ProjectReference Include="..\..\..\externals\Lean\Queues\QuantConnect.Queues.csproj" />
    <ProjectReference Include="..\..\..\externals\Lean\Messaging\QuantConnect.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
