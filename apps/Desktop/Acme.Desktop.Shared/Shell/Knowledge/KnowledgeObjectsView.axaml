<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:ctl="using:Acme.Desktop.Shared.Shell.Controls"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.KnowledgeObjectsView"
             Background="{DynamicResource CardBgBrush}">

  <UserControl.Styles>
    <!-- 状态条按钮（保存） -->
    <Style Selector="Button.ko-head">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.ko-head:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- labs 右栏（左树在 LeftTree 切换层 KoTreeView，按 labs tab 切显隐）。
       状态条 + 上下两栏（上=按类型切换的表单，下=源码）。 -->
  <Grid RowDefinitions="Auto,*">
    <!-- 状态条：dirty 指示 + 名称 + 状态消息 + 保存 -->
    <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ko-head" Command="{Binding SaveCommand}"
                ToolTip.Tip="保存 (Ctrl+S)" VerticalAlignment="Center" Margin="4,0,0,0">
          <Path Data="{x:Static shell:Codicons.Save}" Stretch="Uniform" Width="14" Height="14"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="8,0,6,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   IsVisible="{Binding StatusMessage, Converter={x:Static shell:NotNullConverter.Instance}}"/>
        <Path DockPanel.Dock="Left" Data="{x:Static shell:Codicons.Dot}" Stretch="Uniform"
              Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource AccentBrush}"
              IsVisible="{Binding IsDirty}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SelectedNode.Name}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" FontWeight="SemiBold"
                   IsVisible="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}"/>
        <TextBlock Text="选择左侧文件打开对应编辑器" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   IsVisible="{Binding !EditorVisible}"/>
      </DockPanel>
    </Border>

    <!-- form 类型：上下两栏（上=表单，下=源码）；代码类型：全宽源码 -->
    <Grid Grid.Row="1" x:Name="EditorGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 上栏：按类型切换的表单（按类型 Border 切换） -->
      <Grid Grid.Row="0" IsVisible="{Binding RightPaneVisible}">
        <Border IsVisible="{Binding IsAgentNode}">
          <shell:ExpertEditView DataContext="{Binding ActiveEditVm}"/>
        </Border>
        <Border IsVisible="{Binding IsRuleNode}">
          <shell:RuleEditView DataContext="{Binding ActiveEditVm}"/>
        </Border>
        <Border IsVisible="{Binding IsCodeRuleNode}">
          <shell:RuleEditView DataContext="{Binding ActiveEditVm}"/>
        </Border>
        <Border IsVisible="{Binding IsWorkflowNode}">
          <shell:WorkflowEditView DataContext="{Binding ActiveEditVm}"/>
        </Border>
        <Border IsVisible="{Binding IsStrategyNode}">
          <shell:StrategyEditView DataContext="{Binding ActiveEditVm}"/>
        </Border>
        <Border IsVisible="{Binding IsKnowledgeNode}">
          <shell:DocumentKnowledgeView DataContext="{Binding ActiveEditVm}"/>
        </Border>
        <!-- README：markdown 上栏预览（下栏=可编辑源码，见下 Grid.Row=2） -->
        <Border IsVisible="{Binding IsReadme}">
          <ctl:SelectableMarkdownViewer Markdown="{Binding ReadmeMarkdown}" Margin="8,6"/>
        </Border>
      </Grid>

      <!-- 中：上下分隔条（仅 form 类型） -->
      <GridSplitter Grid.Row="1" IsVisible="{Binding SplitterVisible}"
                    Height="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}" Cursor="SizeNorthSouth"/>

      <!-- 下栏：源码编辑器 + 空态（代码类型跨满 EditorGrid 三行＝全宽，form 类型仅 Row 2） -->
      <Grid Grid.Row="{Binding EditorRow}" Grid.RowSpan="{Binding EditorRowSpan}">
        <edit:TextEditor x:Name="CodeEditor"
                         ShowLineNumbers="False" WordWrap="True"
                         FontFamily="Menlo,Monaco,Consolas,monospace"
                         FontSize="{Binding EditorFontSize}"
                         Background="Transparent" Margin="8,6"
                         IsReadOnly="False"
                         IsVisible="{Binding EditorVisible}"/>
        <Border Background="{DynamicResource CardBgBrush}" IsVisible="{Binding !EditorVisible}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="10" Opacity="0.6">
            <Path Data="{x:Static shell:Codicons.Collection}" Stretch="Uniform" Width="36" Height="36"
                  HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="labs（九类节点）" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="左树按目录分组；点文件 → 对应编辑器（表单/源码）" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
