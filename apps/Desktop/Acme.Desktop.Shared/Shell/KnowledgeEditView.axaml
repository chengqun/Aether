<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Acme.Desktop.Shared.Shell.KnowledgeEditView">

  <UserControl.Styles>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Error}" Foreground="#D9534F" VerticalAlignment="Center" IsVisible="{Binding HasError}"/>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="2" Margin="10,6">

        <Expander Header="基本信息" IsExpanded="True">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="名称（笔记标题）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Name}" PlaceholderText="如 ExternalIntelTable / 崇齐网络案"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="kind（分类）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding Kind}" PlaceholderText="如 Entity / Rule / 情报案件"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander Header="links（typed 引用）" IsExpanded="True">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="+ 新增引用" Command="{Binding AddLinkCommand}" Padding="12,4"/>
              <Button Content="📊 查看图" Click="OnViewGraphClick" Classes="tool" Padding="12,4"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Links}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,2*,Auto" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Text="{Binding Role}" PlaceholderText="role（uses/then/applies-to/produces…）" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Margin="0,0,4,0" Click="OnPickTarget"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      <TextBlock Text="{Binding SelectedTarget.Title, FallbackValue=选择目标…}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button Grid.Column="2" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.RemoveLinkCommand}"
                            CommandParameter="{Binding}" Padding="8,4"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Expander Header="正文（markdown / 结构化数据）" IsExpanded="True">
          <TextBox Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="300" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"/>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
