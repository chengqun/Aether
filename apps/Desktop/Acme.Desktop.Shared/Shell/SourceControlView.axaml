<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.SourceControlView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Resources>
    <!-- 变更行模板：状态字母(着色) + 文件名 + 暗色路径 + 行内操作 -->
    <DataTemplate x:Key="ChangeRowTemplate">
      <Grid ColumnDefinitions="18,*" Margin="2,1" Classes="scm-row">
        <Button Grid.Column="0" Grid.ColumnSpan="2" Classes="scm-row-btn"
                Command="{Binding $parent[UserControl].DataContext.OpenDiffCommand}"
                CommandParameter="{Binding}"
                HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="18,*">
            <TextBlock Grid.Column="0" Text="{Binding StatusLetter}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{Binding Kind, Converter={x:Static shell:ChangeKindToBrushConverter.Instance}}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Dir}" FontSize="10" Opacity="0.55" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </Grid>
        </Button>
        <StackPanel Grid.Column="1" Classes="scm-actions" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Background="{DynamicResource AccentTintBrush}">
          <Button Classes="scm-act" ToolTip.Tip="对比差异"
                  Command="{Binding $parent[UserControl].DataContext.OpenDiffCommand}"
                  CommandParameter="{Binding}">
            <TextBlock Text="∓" FontSize="12"/>
          </Button>
          <Button Classes="scm-act" ToolTip.Tip="暂存"
                  IsVisible="{Binding !IsStaged}"
                  Command="{Binding $parent[UserControl].DataContext.StageCommand}"
                  CommandParameter="{Binding}">
            <TextBlock Text="＋" FontSize="12"/>
          </Button>
          <Button Classes="scm-act" ToolTip.Tip="取消暂存"
                  IsVisible="{Binding IsStaged}"
                  Command="{Binding $parent[UserControl].DataContext.UnstageCommand}"
                  CommandParameter="{Binding}">
            <TextBlock Text="－" FontSize="12"/>
          </Button>
          <Button Classes="scm-act" ToolTip.Tip="撤销改动"
                  Command="{Binding $parent[UserControl].DataContext.DiscardCommand}"
                  CommandParameter="{Binding}">
            <TextBlock Text="↺" FontSize="12"/>
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- ref 徽标（分支/标签）：按类型着色，对齐 VSCode Git Graph。
         HEAD(绿,「HEAD → name」) → 本地分支(紫) → 远端分支(琥珀) → 标签(中性)。 -->
    <DataTemplate x:Key="RefBadgeTemplate">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="3" Padding="5,1"
                Margin="0,0,4,0" IsVisible="{Binding IsHead}">
          <TextBlock FontSize="10" VerticalAlignment="Center"
                     Foreground="{DynamicResource SuccessBrush}"
                     Text="{Binding Name, StringFormat='HEAD → {0}'}"/>
        </Border>
        <Border Background="{DynamicResource AccentTintBgBrush}" CornerRadius="3" Padding="5,1"
                Margin="0,0,4,0" IsVisible="{Binding IsLocalBranch}">
          <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentBrush}"/>
        </Border>
        <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="3" Padding="5,1"
                Margin="0,0,4,0" IsVisible="{Binding IsRemote}">
          <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center"
                     Foreground="{DynamicResource WarningBrush}"/>
        </Border>
        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" IsVisible="{Binding IsTag}">
          <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- 提交历史行：色点(lane色) + ref徽标 + 消息 + 短日期；单击 → 选中提交看其改动 -->
    <DataTemplate x:Key="CommitRowTemplate">
      <Button Classes="scm-row-btn" Margin="2,1"
              Command="{Binding $parent[UserControl].DataContext.SelectCommitCommand}"
              CommandParameter="{Binding}"
              ToolTip.Tip="{Binding Info.Message}"
              HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="12,Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="●" FontSize="10"
                     Foreground="{Binding Lane, Converter={x:Static shell:LaneToBrushConverter.Instance}}"
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Refs}"
                        ItemTemplate="{StaticResource RefBadgeTemplate}" Margin="6,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Grid.Column="2" Text="{Binding Info.Message}" FontSize="12" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding Info.When, StringFormat='{}{0:MM-dd}'}"
                     FontSize="10" Opacity="0.5" Margin="6,0,4,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- 提交改动文件行：状态字母(着色) + 文件名；单击 → 看该文件 commit diff -->
    <DataTemplate x:Key="CommitFileTemplate">
      <Button Classes="scm-row-btn" Margin="2,1"
              Command="{Binding $parent[UserControl].DataContext.OpenCommitFileDiffCommand}"
              CommandParameter="{Binding}"
              HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="18,*">
          <TextBlock Grid.Column="0" Text="{Binding StatusLetter}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{Binding Kind, Converter={x:Static shell:ChangeKindToBrushConverter.Instance}}"
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.scm-act">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.scm-act:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.scm-section-header">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.scm-section-header:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
    <Style Selector="Grid.scm-row">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Grid.scm-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
    <Style Selector="Button.scm-row-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.scm-row-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
    <Style Selector="Button.scm-row-btn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Grid.scm-row StackPanel.scm-actions">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Grid.scm-row:pointerover StackPanel.scm-actions">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="260,4,*">
    <!-- ═══ 左：SCM 面板 ═══ -->
    <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*">
        <!-- 头：项目名 + 远程同步按钮 + 刷新 -->
        <Border Grid.Row="0" Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Spacing="2">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- 远程设置（GitHub 用户名 + PAT） -->
                <Button Classes="scm-act" Width="24" Height="24" ToolTip.Tip="远程设置"
                        Command="{Binding OpenRemoteSettingsCommand}" IsVisible="{Binding IsRepository}">
                  <TextBlock Text="⚙" FontSize="13"/>
                </Button>
                <!-- 同步（pull + push） -->
                <Button Classes="scm-act" Width="24" Height="24" ToolTip.Tip="同步（拉取并推送）"
                        Command="{Binding SyncCommand}" IsVisible="{Binding IsRepository}"
                        IsEnabled="{Binding !IsBusy}">
                  <TextBlock Text="⟳" FontSize="13"/>
                </Button>
                <!-- ahead/behind 徽标（本地领先↑ / 落后↓ 上游） -->
                <TextBlock Text="{Binding Ahead, StringFormat='↑{0}'}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource SuccessBrush}"
                           IsVisible="{Binding IsRepository}"
                           Margin="2,0,0,0"/>
                <TextBlock Text="{Binding Behind, StringFormat='↓{0}'}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding IsRepository}"
                           Margin="2,0,4,0"/>
                <Button Classes="scm-act" Width="24" Height="24" ToolTip.Tip="拉取（pull）"
                        Command="{Binding PullCommand}" IsVisible="{Binding IsRepository}"
                        IsEnabled="{Binding !IsBusy}">
                  <TextBlock Text="↓" FontSize="14"/>
                </Button>
                <Button Classes="scm-act" Width="24" Height="24" ToolTip.Tip="推送（push）"
                        Command="{Binding PushCommand}" IsVisible="{Binding IsRepository}"
                        IsEnabled="{Binding !IsBusy}">
                  <TextBlock Text="↑" FontSize="14"/>
                </Button>
                <Button Classes="scm-act" Width="24" Height="24" ToolTip.Tip="刷新"
                        Command="{Binding RefreshCommand}">
                  <TextBlock Text="↻" FontSize="13"/>
                </Button>
              </StackPanel>
              <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Opacity="0.75" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static shell:NotNullConverter.Instance}}"/>
          </StackPanel>
        </Border>

        <!-- 提交框（VSCode 式：顶部） -->
        <Border Grid.Row="1" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding IsRepository}">
          <StackPanel Spacing="6">
            <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" Watermark="提交消息…" AcceptsReturn="True"
                     TextWrapping="Wrap" FontSize="12" MinHeight="44" MaxHeight="120"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <Button Classes="primary" Content="✓ 提交" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CommitCommand}"/>
          </StackPanel>
        </Border>

        <!-- 变更 / 历史 / 空态 -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <Panel>
            <!-- 未开项目 -->
            <StackPanel IsVisible="{Binding !HasProject}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Opacity="0.6">
              <TextBlock Text="未打开项目目录" FontSize="13" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text="在「文档」页打开一个 git 项目" FontSize="11" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <!-- 非 git 仓库 -->
            <StackPanel IsVisible="{Binding IsNotRepository}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Opacity="0.6">
              <TextBlock Text="当前项目不是 git 仓库" FontSize="13" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 变更 + 历史 -->
            <StackPanel IsVisible="{Binding IsRepository}">
              <!-- 更改段（可折叠头 + 全部暂存图标） -->
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="scm-section-header" Command="{Binding ToggleChangesCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="▾" FontSize="10" IsVisible="{Binding IsChangesExpanded}"/>
                    <TextBlock Text="▸" FontSize="10" IsVisible="{Binding !IsChangesExpanded}"/>
                    <TextBlock Text="更改" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Changes.Count, StringFormat='{}· {0}'}" FontSize="11" Opacity="0.7"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="scm-act" Width="22" Height="22" Margin="0,0,4,0"
                        ToolTip.Tip="全部暂存" IsVisible="{Binding IsChangesExpanded}"
                        Command="{Binding StageAllCommand}">
                  <TextBlock Text="＋" FontSize="13"/>
                </Button>
              </Grid>
              <ItemsControl IsVisible="{Binding IsChangesExpanded}" ItemsSource="{Binding Changes}"
                            ItemTemplate="{StaticResource ChangeRowTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- 暂存的更改段（可折叠头） -->
              <Button Classes="scm-section-header" Command="{Binding ToggleStagedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="▾" FontSize="10" IsVisible="{Binding IsStagedExpanded}"/>
                  <TextBlock Text="▸" FontSize="10" IsVisible="{Binding !IsStagedExpanded}"/>
                  <TextBlock Text="暂存的更改" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding StagedChanges.Count, StringFormat='{}· {0}'}" FontSize="11" Opacity="0.7"/>
                </StackPanel>
              </Button>
              <ItemsControl IsVisible="{Binding IsStagedExpanded}" ItemsSource="{Binding StagedChanges}"
                            ItemTemplate="{StaticResource ChangeRowTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- 历史段（可折叠头，带图标；首次展开懒加载） -->
              <Button Classes="scm-section-header" Command="{Binding ToggleHistoryCommand}" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="▾" FontSize="10" IsVisible="{Binding IsHistoryExpanded}"/>
                  <TextBlock Text="▸" FontSize="10" IsVisible="{Binding !IsHistoryExpanded}"/>
                  <TextBlock Text="🕘" FontSize="11"/>
                  <TextBlock Text="历史" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding HistoryGraph.Commits.Count, StringFormat='{}· {0}'}"
                             FontSize="11" Opacity="0.7" IsVisible="{Binding HasHistory}"/>
                </StackPanel>
              </Button>
              <ItemsControl IsVisible="{Binding IsHistoryExpanded}" ItemsSource="{Binding HistoryGraph.Commits}"
                            ItemTemplate="{StaticResource CommitRowTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Panel>
        </ScrollViewer>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" Cursor="SizeWestEast"/>

    <!-- ═══ 右：diff 区（工作区 diff / 提交详情 叠加） ═══ -->
    <Grid Grid.Column="2">
      <!-- 工作区 diff 层（未选中提交） -->
      <Panel IsVisible="{Binding !HasSelectedCommit}">
        <StackPanel IsVisible="{Binding !HasActiveDiff}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Opacity="0.6">
          <TextBlock Text="∓" FontSize="40" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="选择一个变更查看差异" FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <DockPanel IsVisible="{Binding HasActiveDiff}">
          <Border DockPanel.Dock="Top" Padding="8,5" Background="{DynamicResource SidebarBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding ActiveDiffPath}" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Border>
          <shell:DiffView DataContext="{Binding ActiveDiff}"/>
        </DockPanel>
      </Panel>

      <!-- 提交详情层（选中提交：元信息 + 改动文件 + 文件 diff） -->
      <Grid IsVisible="{Binding HasSelectedCommit}" RowDefinitions="Auto,*,4,*">
        <!-- 元信息头（✕ 回工作区层） -->
        <Border Grid.Row="0" Padding="10,6" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="scm-act" Width="24" Height="24" ToolTip.Tip="关闭"
                    Command="{Binding ClearSelectedCommitCommand}">
              <TextBlock Text="✕" FontSize="13"/>
            </Button>
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding SelectedCommit.Info.ShaShort}"
                           FontFamily="Menlo,Monaco,Consolas,monospace" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding SelectedCommit.Info.Author}" FontSize="12" Opacity="0.8"/>
                <TextBlock Text="{Binding SelectedCommit.Info.When, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                           FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding SelectedCommit.Info.Message}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 改动文件 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="改动文件" FontSize="11" FontWeight="SemiBold" Margin="10,8,8,2"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ItemsControl ItemsSource="{Binding CommitFiles}" ItemTemplate="{StaticResource CommitFileTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" Cursor="SizeNorthSouth"/>

        <!-- 提交文件 diff -->
        <Grid Grid.Row="3">
          <StackPanel IsVisible="{Binding !HasCommitDiff}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" Opacity="0.6">
            <TextBlock Text="∓" FontSize="32" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="选择一个改动文件查看差异" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <DockPanel IsVisible="{Binding HasCommitDiff}">
            <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="{Binding ActiveCommitDiffPath}" FontSize="12" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
            </Border>
            <shell:DiffView DataContext="{Binding ActiveCommitDiff}"/>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
