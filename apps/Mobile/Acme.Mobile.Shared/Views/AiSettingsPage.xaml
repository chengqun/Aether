<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage Shell.TabBarIsVisible="False"
    x:Class="Acme.Mobile.Shared.Views.AiSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:model="clr-namespace:Acme.Mobile.Mvvm.Models;assembly=Acme.Mobile.Mvvm"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    x:DataType="vm:AiSettingsViewModel"
    Title="AI 设置">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,16,16,32">

            <!-- Agent 管理（配置侧：新建/编辑/删除 AI 助手，与聊天侧分离；两租户都显示） -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="管理 AI 助手" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="＋ 新建" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                Command="{Binding NavigateToNewAgentCommand}" />
                    </Grid>

                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding AvailableAgents}">
                        <BindableLayout.EmptyView>
                            <Label Text="暂无 AI 助手" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:AgentInfoDto">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="6,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToAgentEditCommand}"
                                                              CommandParameter="{Binding Id}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold"
                                               LineBreakMode="TailTruncation" MaxLines="1"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding Description}" FontSize="12"
                                               LineBreakMode="TailTruncation" MaxLines="1"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BubbleTool}, Dark={StaticResource BubbleToolDark}}"
                                            StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding KindLabel}" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </Border>
                                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Agent picker section（仅 Stockapp：股票模式默认 Agent 选择；Qifu 不串股票功能） -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding IsStockTenant}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="股票模式 AI 助手" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Picker Title="选择 AI 助手"
                            ItemsSource="{Binding AvailableAgents}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndex="{Binding SelectedAgentIndex}" />

                    <Label Text="{Binding CurrentSelectionText}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{DynamicResource Primary}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>

            <!-- Yushu auth card（仅接入了毓数认证服务的租户显示——Stockapp 不注册毓数适配器，故隐藏；与 HasCloudDocs 同模式） -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding HasYushu}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="毓数平台" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Label Text="{Binding YushuStatusText}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <!-- Desktop: browser login -->
                    <Button Text="浏览器登录" Style="{StaticResource PrimaryButton}"
                            Command="{Binding YushuLoginCommand}"
                            IsVisible="{Binding IsDesktopPlatform}"
                            IsEnabled="{Binding IsYushuLoggingIn, Converter={StaticResource InverseBool}}" />

                    <!-- Mobile: sync from server -->
                    <Button Text="从服务器同步" Style="{StaticResource PrimaryButton}"
                            Command="{Binding YushuLoginCommand}"
                            IsVisible="{Binding IsDesktopPlatform, Converter={StaticResource InverseBool}}"
                            IsEnabled="{Binding IsYushuLoggingIn, Converter={StaticResource InverseBool}}" />

                    <ActivityIndicator IsRunning="{Binding IsYushuLoggingIn}" IsVisible="{Binding IsYushuLoggingIn}"
                                       Color="{DynamicResource Primary}" HorizontalOptions="Start" />

                    <!-- Sync to server (desktop only) -->
                    <Button Text="同步到服务器" Style="{StaticResource GhostButton}"
                            Command="{Binding YushuSyncToServerCommand}"
                            IsVisible="{Binding IsDesktopPlatform}"
                            IsEnabled="{Binding IsYushuSyncing, Converter={StaticResource InverseBool}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- CloudDocs auth card -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding HasCloudDocs}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="云文档" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Label Text="{Binding CloudDocsStatusText}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <!-- Desktop: browser login -->
                    <Button Text="浏览器登录" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloudDocsLoginCommand}"
                            IsVisible="{Binding IsDesktopPlatform}"
                            IsEnabled="{Binding IsCloudDocsLoggingIn, Converter={StaticResource InverseBool}}" />

                    <!-- Mobile: sync from server -->
                    <Button Text="从服务器同步" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloudDocsLoginCommand}"
                            IsVisible="{Binding IsDesktopPlatform, Converter={StaticResource InverseBool}}"
                            IsEnabled="{Binding IsCloudDocsLoggingIn, Converter={StaticResource InverseBool}}" />

                    <ActivityIndicator IsRunning="{Binding IsCloudDocsLoggingIn}" IsVisible="{Binding IsCloudDocsLoggingIn}"
                                       Color="{DynamicResource Primary}" HorizontalOptions="Start" />

                    <!-- Sync to server (desktop only) -->
                    <Button Text="同步到服务器" Style="{StaticResource GhostButton}"
                            Command="{Binding CloudDocsSyncToServerCommand}"
                            IsVisible="{Binding IsDesktopPlatform}"
                            IsEnabled="{Binding IsCloudDocsSyncing, Converter={StaticResource InverseBool}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- mcphub 网关 auth card（仅接入了 mcphub 认证服务的租户显示——Stockapp 不注册 mcphub 适配器，故隐藏；与 HasYushu/HasCloudDocs 同模式） -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding HasMcphub}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="mcphub 网关" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Label Text="{Binding McphubStatusText}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <!-- Desktop: browser login -->
                    <Button Text="浏览器登录" Style="{StaticResource PrimaryButton}"
                            Command="{Binding McphubLoginCommand}"
                            IsVisible="{Binding IsDesktopPlatform}"
                            IsEnabled="{Binding IsMcphubLoggingIn, Converter={StaticResource InverseBool}}" />

                    <!-- Mobile: sync from server -->
                    <Button Text="从服务器同步" Style="{StaticResource PrimaryButton}"
                            Command="{Binding McphubLoginCommand}"
                            IsVisible="{Binding IsDesktopPlatform, Converter={StaticResource InverseBool}}"
                            IsEnabled="{Binding IsMcphubLoggingIn, Converter={StaticResource InverseBool}}" />

                    <ActivityIndicator IsRunning="{Binding IsMcphubLoggingIn}" IsVisible="{Binding IsMcphubLoggingIn}"
                                       Color="{DynamicResource Primary}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
