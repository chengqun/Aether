<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- git 源代码管理（status/diff/stage/commit/discard）。跨平台 native-binding，含 win/linux/osx runtimes。 -->
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- chat shell VM 用到的业务 Application/Domain 契约（UI 无关）。自定义 Agent/Workflow 的目录+运行器契约住 Notes.Domain/Hosting-Core/Abstractions，无需引 ai/Agents 适配器。 -->
    <ProjectReference Include="..\..\..\business\AppAuth\Acme.AppAuth.Application\Acme.AppAuth.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Llm\Acme.Llm.Application\Acme.Llm.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Notes\Acme.Notes.Domain\Acme.Notes.Domain.csproj" />
    <ProjectReference Include="..\..\..\business\DeviceConnect\Acme.DeviceConnect.Domain\Acme.DeviceConnect.Domain.csproj" />
    <!-- 自动化任务管理（IAutomationService / IAutomationScheduler） -->
    <ProjectReference Include="..\..\..\business\Automation\Acme.Automation.Application\Acme.Automation.Application.csproj" />
    <!-- 平台：会话存储 + 标题服务 -->
    <ProjectReference Include="..\..\..\src\Aether.AI.Memory\Aether.AI.Memory.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Hosting\Aether.AI.Hosting.csproj" />
    <!-- 钱包页 VM（2026-10-08）：链上钱包 UI（查余额/转账/充值/提币）。引纯链库（apps→src 合法方向，零传递依赖）。 -->
    <ProjectReference Include="..\..\..\src\Aether.Ledger\Aether.Ledger.csproj" />
    <!-- MCP 稳定契约（McpServerConfig / IMcpManagementService / McpServerStatus 等，VM 直接用）——零 alpha 依赖。 -->
    <ProjectReference Include="..\..\..\src\Aether.AI.Abstractions\Aether.AI.Abstractions.csproj" />
  </ItemGroup>

</Project>
