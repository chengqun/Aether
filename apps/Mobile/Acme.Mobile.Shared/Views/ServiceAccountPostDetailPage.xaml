<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage Shell.TabBarIsVisible="False"
    x:Class="Acme.Mobile.Shared.Views.ServiceAccountPostDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Acme.Mobile.Mvvm.ViewModels;assembly=Acme.Mobile.Mvvm"
    xmlns:md="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
    xmlns:conv="clr-namespace:Acme.Mobile.Shared.Converters"
    x:DataType="vm:ServiceAccountPostDetailViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBool" />
        <conv:MarkdownTableFillConverter x:Key="MarkdownTableFill" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- status / loading -->
        <Label Grid.Row="0" Text="{Binding StatusMessage}"
               FontSize="13" Margin="16,8"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="20,16,20,32">

                <!-- title -->
                <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                <!-- author + meta -->
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding ServiceAccountName}" FontSize="12"
                           TextColor="{StaticResource Accent}" />
                    <Label Text="·" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="{Binding ContentType}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="·" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />

                <!-- markdown body -->
                <md:MarkdownView MarkdownText="{Binding Content, Converter={StaticResource MarkdownTableFill}}" Theme="{StaticResource AppMarkdownTheme}" UseAppTheme="True" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
