<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Acme.Mobile.Mvvm</RootNamespace>
    <!-- VM library: UI-agnostic. Referenced by the MAUI shared layer + tenant hosts. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <!-- Aether business bounded-context contracts (DDD; VMs depend on Domain/Application only) -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\business\AppAuth\Acme.AppAuth.Application\Acme.AppAuth.Application.csproj" />
    <ProjectReference Include="..\..\..\business\ChatSocial\Acme.ChatSocial.Application\Acme.ChatSocial.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Moments\Acme.Moments.Application\Acme.Moments.Application.csproj" />
    <ProjectReference Include="..\..\..\business\ServiceAccount\Acme.ServiceAccount.Application\Acme.ServiceAccount.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Video\Acme.Video.Application\Acme.Video.Application.csproj" />
    <ProjectReference Include="..\..\..\business\DeviceManagement\Acme.DeviceManagement.Application\Acme.DeviceManagement.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Securities\Acme.Securities.Application\Acme.Securities.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Llm\Acme.Llm.Application\Acme.Llm.Application.csproj" />
    <ProjectReference Include="..\..\..\business\Notes\Acme.Notes.Domain\Acme.Notes.Domain.csproj" />
    <ProjectReference Include="..\..\..\business\AppUpdate\Acme.AppUpdate.Domain\Acme.AppUpdate.Domain.csproj" />
    <!-- NOTE: Qifu (Yushu/CloudDocs) is intentionally NOT referenced here — Qifu projects are
         hidden from the slnx (not synced to GitHub). AiSettingsViewModel's qifu auth deps are
         satisfied by local mobile interfaces (see Services/MobileServiceContracts.cs); the
         Qifu.Mobile tenant host provides adapter implementations wiring Acme.Qifu.*. -->
  </ItemGroup>

  <!-- Aether platform + agent-runtime contracts -->
  <ItemGroup>
    <!-- VM 库消费 Core（ToolStreamEvent/agent DTO）+ Memory（IConversationStore/Conversation）+ Agents.AI
         （ICustomAgentCatalog/ICustomAgentRunner）+ Hosting（IConversationTitleService——AI 会话标题自动生成，
         与桌面 Acme.Desktop.Mvvm 同：shell VM 库为标题服务引 Hosting）。Harness（AgentFactory/HarnessRuntime）
         仍是宿主组合根职责，由 Mobile.Shared/租户持有——VM 库不引。 -->
    <ProjectReference Include="..\..\..\src\Aether.AI.Core\Aether.AI.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Memory\Aether.AI.Memory.csproj" />
    <ProjectReference Include="..\..\..\src\Aether.AI.Hosting\Aether.AI.Hosting.csproj" />
    <!-- 市场/Agent 目录/运行器契约住 Abstractions/Notes.Domain/Core（零 ai/Agents 适配器依赖；组合根调 AddCustomAgents 仍由 Mobile.Shared 持适配器）。 -->
    <ProjectReference Include="..\..\..\src\Aether.AI.Abstractions\Aether.AI.Abstractions.csproj" />
  </ItemGroup>

</Project>
