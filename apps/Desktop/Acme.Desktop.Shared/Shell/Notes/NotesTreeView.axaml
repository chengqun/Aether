<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.NotesTreeView"
             Background="{DynamicResource CardBgBrush}">

  <UserControl.Styles>
    <!-- 共享样式（ScrollViewer 横滚禁用 / TreeViewItem 选中白字 / IsExpanded 双绑）已上移 SharedTheme.axaml，
         匹配 TreeView.notes-tree class 选择器。此处仅留树特有的 chevron 箭头 IsVisible 绑定（Children.Count）。
         树样式写在 UserControl 级（非 TreeView.Styles）：Avalonia 控件自身 .Styles 里的 /template/
         选择器作用于自己模板部件不可靠，横向滚动禁用会失效——选中长标题子节点时 BringIntoView 把树横向
         推走、根节点跟着位移。 -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="{Binding Children.Count, Converter={x:Static shell:CountToBoolConverter.Instance}}"/>
    </Style>
  </UserControl.Styles>

  <!-- shell 级独立左栏（notes tab 时由 LeftTreePanelView 切显）：占满高度（宽度由外层 LayoutSplit 控制）。
       无树头菜单（原 NotesView 左树无树头，用 ContextMenu 操作节点）。 -->
  <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,1,0">
    <Grid>
      <TreeView x:Name="NotesTree" Classes="notes-tree" Margin="4,4"
                ItemsSource="{Binding Roots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="新建节点（同级）" Click="OnCreateSiblingClick" />
            <MenuItem Header="新建子节点" Click="OnCreateChildClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
            <Separator />
            <MenuItem Header="修改节点属性" Click="OnEditPropertiesClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
            <MenuItem Header="删除" Click="OnDeleteClick"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
            <Separator />
            <MenuItem Header="上移" Command="{Binding MoveNodeUpCommand}"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
            <MenuItem Header="下移" Command="{Binding MoveNodeDownCommand}"
                      IsEnabled="{Binding SelectedNode, Converter={x:Static shell:NotNullConverter.Instance}}" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <!-- 用 Auto,* 的 Grid（而非水平 StackPanel）让标题被约束在 * 列内：
                 StackPanel 给子控件无限横向空间，TextTrimming 不生效；Grid 的 * 列
                 把标题限定在可用宽度，长名以 … 截断，不再撑宽行、触发横向滚动。 -->
            <Grid ColumnDefinitions="20,*" Background="Transparent">
              <Border Grid.ColumnSpan="2" Background="{DynamicResource AccentBrush}" Opacity="0.22"
                      CornerRadius="4" IsVisible="{Binding IsDropTarget}" />
              <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                    Fill="{Binding IconColor}" IsVisible="{Binding IconIsFill}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{Binding IconColor}" IsVisible="{Binding !IconIsFill}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Title}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <!-- 空态：无笔记时提示（TreeView 空集合不渲染，此 TextBlock 占位） -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding !Roots.Count}" Spacing="6">
        <Path Data="{x:Static shell:Codicons.Edit}" Stretch="Uniform" Width="32" Height="32" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
        <TextBlock Text="暂无笔记" FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="右键根节点或点上方「+」新建" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
