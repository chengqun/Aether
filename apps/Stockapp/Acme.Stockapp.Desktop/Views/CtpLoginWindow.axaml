<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Desktop.Shared.Shell"
        x:Class="Acme.Stockapp.Desktop.Views.CtpLoginWindow"
        Title="CTP 期货连接" Width="420" Height="540"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBgBrush}">

  <Window.Styles>
    <!-- 连接标签 chip：镜像 term-tab/term-close 的兄弟双按钮结构（Grid Auto,Auto，非嵌套） -->
    <Style Selector="Button.profile-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- :pointerover Background 须落 /template/ ContentPresenter 层才能压过 Fluent 主题同款 setter（repo 惯例） -->
    <Style Selector="Button.profile-chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}" />
    </Style>
    <Style Selector="Button.profile-chip.is-current">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- chip 上的 ✕ 删除小按钮 -->
    <Style Selector="Button.chip-close">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.chip-close:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.chip-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- 标题 -->
    <Border Grid.Row="0" Padding="20,16" Background="{DynamicResource AccentBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Path Data="{x:Static shell:Codicons.GraphLine}" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="CTP 期货连接" Foreground="{DynamicResource OnAccentBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 表单 -->
    <ScrollViewer Grid.Row="1" Padding="20,16">
      <StackPanel Spacing="2">
        <!-- 连接标签（profile chips）：点 chip = 应用该 profile 并直接登录（VM 先登出再登录）；✕ 删除档案 -->
        <ItemsControl ItemsSource="{Binding Profiles}" IsVisible="{Binding HasProfiles}" Margin="0,0,0,10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,Auto">
                <Button Grid.Column="0" Classes="profile-chip is-current:{Binding IsCurrent}"
                        Click="OnProfileChipClick" Tag="{Binding}" Margin="0,0,0,4">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </Button>
                <Button Grid.Column="1" Classes="chip-close" Margin="0,0,6,4"
                        Command="{Binding $parent[Window].DataContext.DeleteProfileCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="删除此连接标签">
                  <Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="10" Height="10"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="交易前置" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding FrontAddress}" Margin="0,6" PlaceholderText="tcp://ip:port 或 sim" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="行情前置" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding MdFrontAddress}" Margin="0,6" PlaceholderText="tcp://ip:port（sim 登录时留空）" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="经纪商代码" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding BrokerId}" Margin="0,6" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="用户号" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding UserId}" Margin="0,6" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="密码" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto">
            <TextBox x:Name="PasswordBox" Grid.Column="0" Text="{Binding Password}" Margin="0,6" PasswordChar="•" />
            <ToggleButton x:Name="PasswordEye" Grid.Column="1" Classes="preview-toggle"
                          Click="OnPasswordEyeClick" ToolTip.Tip="显示/隐藏密码"
                          VerticalAlignment="Center" Margin="4,6,0,6">
              <Panel>
                <Path Data="{x:Static shell:Codicons.Eye}" Stretch="Uniform" Width="14" Height="14"
                      IsVisible="{Binding !IsChecked, ElementName=PasswordEye}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                <Path Data="{x:Static shell:Codicons.EyeClosed}" Stretch="Uniform" Width="14" Height="14"
                      IsVisible="{Binding IsChecked, ElementName=PasswordEye}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
              </Panel>
            </ToggleButton>
          </Grid>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="AppId" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding AppId}" Margin="0,6" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="授权码" FontSize="12" VerticalAlignment="Center" Margin="0,6" />
          <TextBox  Grid.Row="6" Grid.Column="1" Text="{Binding AuthCode}" Margin="0,6" />
        </Grid>
        <CheckBox Content="启动时自动连接" IsChecked="{Binding AutoLogin}" Margin="100,8,0,0" FontSize="12" />
        <TextBlock Text="提示：交易前置填 sim ⇒ 连本地仿真柜台（先启动 apps/CtpSim/Acme.Ctp.Sim.Host）；填真实前置 ⇒ 官方柜台。切换柜台 = 换地址重新登录。行情随柜台：sim 登录 ⇒ 行情为仿真合成行情（行情前置留空即可）；真实前置登录 ⇒ 真实行情。"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- 底部按钮 -->
    <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="取消" Click="OnCancelClick" Padding="16,6" FontSize="13" />
        <Button Content="断开" Command="{Binding DisconnectCommand}" Padding="16,6" FontSize="13"
                IsVisible="{Binding IsConnected}" />
        <Button Content="连接" Classes="primary" Click="OnConnectClick" Padding="16,6" FontSize="13"
                IsVisible="{Binding !IsConnected}" IsEnabled="{Binding !IsConnecting}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
