<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:ctl="using:Acme.Desktop.Shared.Shell.Controls"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.DocumentsView"
             Background="{DynamicResource ContentBgBrush}">

  <UserControl.Resources>
    <!-- 文件树节点模板（用户项目树 + 应用数据树共用）。
         Auto 列：文件夹图标不显时列宽自动收 0，文件有图标时撑开；Grid（非 StackPanel）保 * 列 TextTrimming 生效。 -->
    <TreeDataTemplate x:Key="FileNodeTemplate" ItemsSource="{Binding Children}">
      <Grid ColumnDefinitions="Auto,*" Background="Transparent">
        <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
              Margin="0,0,6,0" Fill="{Binding IconColor}" IsVisible="{Binding ShowFillIcon}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform" Width="14" Height="14"
              Margin="0,0,6,0" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
              Stroke="{Binding IconColor}" IsVisible="{Binding ShowStrokeIcon}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </TreeDataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 文件树：镜像 NotesView 的 TreeView 样式 -->
    <Style Selector="TreeView.docs-tree /template/ ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
    </Style>
    <!-- 选中行文字反白（镜像 NotesView TreeViewItem:selected 修） -->
    <Style Selector="TreeViewItem:selected">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <!-- 叶子文件节点隐藏展开箭头 -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="{Binding IsFolder}"/>
    </Style>

    <!-- 树头菜单栏：透明背景融入树头，去掉默认菜单边框 -->
    <Style Selector="Menu.docs-menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="MenuItem.docs-menu-item">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- 标签条 -->
    <Style Selector="ListBox.docs-tabs">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
    <Style Selector="ListBox.docs-tabs > ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2,4,2,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBox.docs-tabs > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
    <Style Selector="ListBox.docs-tabs > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
    <!-- 关闭小按钮 -->
    <Style Selector="Button.tab-close">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Button.tab-close:pointerover">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- 预览切换按钮（ToggleButton：IsChecked 双绑 IsPreviewVisible，开启高亮） -->
    <Style Selector="ToggleButton.preview-toggle">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="ToggleButton.preview-toggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.preview-toggle:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- 左文件树 | 分隔条 | 右编辑器（无顶部工具栏——文件操作收进左侧树头「文件」菜单，节约垂直空间） -->
  <Grid x:Name="TreeGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" MinWidth="120" MaxWidth="600"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左：文件树面板 -->
    <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <!-- 树头：「文件」下拉菜单 + 项目名 -->
        <Border Grid.Row="0" Padding="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*">
            <Menu Grid.Column="0" Classes="docs-menu">
              <MenuItem Header="文件" Classes="docs-menu-item">
                <MenuItem Header="打开项目目录" Click="OnOpenFolderClick">
                  <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Folder}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="关闭项目" Command="{Binding CloseProjectCommand}"
                          IsEnabled="{Binding HasProject}">
                  <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="打开文件" Click="OnOpenFileClick">
                  <MenuItem.Icon><Path Data="{x:Static shell:Codicons.File}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="保存 (Ctrl+S)" Command="{Binding SaveActiveCommand}">
                  <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Save}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="关闭标签" Click="OnCloseClick">
                  <MenuItem.Icon><Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></MenuItem.Icon>
                </MenuItem>
              </MenuItem>
            </Menu>
          </Grid>
        </Border>
        <TreeView Grid.Row="1" x:Name="FileTree" Classes="docs-tree" Margin="4,4"
                  ItemsSource="{Binding Roots}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  SelectionChanged="OnTreeSelectionChanged"
                  ItemTemplate="{StaticResource FileNodeTemplate}"/>
        <!-- 空态：未打开目录 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding !HasProject}" Spacing="8">
          <Path Data="{x:Static shell:Codicons.Folder}" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" Fill="{DynamicResource SecondaryTextBrush}" Opacity="0.5"/>
          <TextBlock Text="未打开项目目录" FontSize="13" HorizontalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Text="「文件 ▾ 打开项目目录」" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" Cursor="SizeWestEast"/>

    <!-- 右：编辑器面板（标签条 + 状态消息 + 编辑器 + 空态） -->
    <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}">
      <Grid RowDefinitions="Auto,*">
        <!-- 标签条 + 预览切换 + 状态消息（同行，不额外占行） -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <DockPanel>
            <!-- 预览切换按钮（仅 markdown 文件显示；眼睛切「仅看解析」vs「上下双栏」，镜像 NotesView） -->
            <ToggleButton DockPanel.Dock="Right" Classes="preview-toggle"
                    IsChecked="{Binding IsPreviewOnly}"
                    IsVisible="{Binding IsPreviewToggleVisible}"
                    ToolTip.Tip="切换仅看解析 / 上下双栏"
                    VerticalAlignment="Center" Margin="4,0,0,0">
              <Path Data="{x:Static shell:Codicons.Eye}" Stretch="Uniform" Width="16" Height="16"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            </ToggleButton>
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" Margin="8,0,6,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                       IsVisible="{Binding StatusMessage, Converter={x:Static shell:NotNullConverter.Instance}}"/>
            <ListBox Name="TabsList" Classes="docs-tabs"
                     ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}"
                     SelectionMode="Single">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Path Data="{x:Static shell:Codicons.Dot}" Stretch="Uniform" Width="8" Height="8"
                            Fill="{DynamicResource AccentBrush}"
                            IsVisible="{Binding IsDirty}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FileName}" FontSize="13" VerticalAlignment="Center"/>
                      <!-- 磁盘已变（外部写盘冲突）：⚠ 提示 + 重载按钮（丢弃本地改动用盘内容覆盖） -->
                      <Path Data="{x:Static shell:Codicons.Warning}" Stretch="Uniform" Width="12" Height="12"
                            Fill="{DynamicResource WarningBrush}"
                            IsVisible="{Binding IsStale}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="tab-close" Click="OnReloadStaleTabClick" ToolTip.Tip="重载（丢弃本地改动）"
                            IsVisible="{Binding IsStale}"
                            VerticalAlignment="Center" Margin="4,0,0,0">
                      <Path Data="{x:Static shell:Codicons.Refresh}" Stretch="Uniform" Width="12" Height="12"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Grid.Column="2" Classes="tab-close" Click="OnCloseTabClick"
                            VerticalAlignment="Center" Margin="4,0,0,0">
                      <Path Data="{x:Static shell:Codicons.Close}" Stretch="Uniform" Width="12" Height="12"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- 上下分栏（镜像 NotesView SplitGrid）：md 文件=上预览/下源码，眼睛切仅预览；非 md=编辑器跨满 -->
        <Grid Grid.Row="1" x:Name="EditorGrid">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 上：markdown 解析预览（md 文件时显示；仅预览模式跨满） -->
          <Border Grid.Row="0" Grid.RowSpan="{Binding PreviewRowSpan}"
                  Background="{DynamicResource ContentBgBrush}"
                  IsVisible="{Binding IsPreviewPaneVisible}">
            <ctl:SelectableMarkdownViewer Markdown="{Binding ActiveTab.Content}" Margin="4,2"/>
          </Border>

          <!-- 中：上下分隔条（md 双栏时显示） -->
          <GridSplitter Grid.Row="1" IsVisible="{Binding IsSplitterVisible}"
                        Height="4" HorizontalAlignment="Stretch"
                        Background="{DynamicResource BorderBrush}" Cursor="SizeNorthSouth"/>

          <!-- 下/满：源码编辑器 + 空态（非 md 跨满 row0-2；md 双栏在下栏 row2） -->
          <Grid Grid.Row="{Binding EditorRow}" Grid.RowSpan="{Binding EditorRowSpan}"
                IsVisible="{Binding IsEditorPaneVisible}">
            <edit:TextEditor Name="CodeEditor"
                             ShowLineNumbers="False" WordWrap="True"
                             FontFamily="Menlo,Monaco,Consolas,monospace"
                             FontSize="{Binding EditorFontSize}"
                             Background="Transparent" Margin="8,6"
                             IsReadOnly="False"/>
            <Border Name="EmptyState" Background="{DynamicResource CardBgBrush}"
                    IsVisible="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="10" Opacity="0.6">
                <Path Data="{x:Static shell:Codicons.File}" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" Fill="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="在左侧文件树点击文件打开" FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="支持 .cs .py .json .md .yaml .sql .js .xml 等语法高亮" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>

  </Grid>
</UserControl>
