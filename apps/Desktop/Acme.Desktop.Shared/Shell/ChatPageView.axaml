<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acme.Desktop.Mvvm"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             xmlns:conv="using:Acme.Desktop.Shared.Shell.Converters"
             x:Class="Acme.Desktop.Shared.Shell.ChatPageView"
             Background="{DynamicResource ContentBgBrush}">

  <Grid RowDefinitions="Auto,*">
    <!-- 精简头部：连接状态/设备配置（左）+ 历史会话/新聊天（右）。全屏页无 ✕（收起走侧栏 toggle）。 -->
    <Border Grid.Row="0" Padding="20,10" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{Binding IsConnected, Converter={x:Static conv:BoolToConnectionBrushConverter.Instance}}" />
          <TextBlock Text="{Binding ConnectionLabel}" FontSize="13" FontWeight="Medium"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Click="OnDeviceConfigClick"
                Background="Transparent" BorderThickness="0" Padding="0"
                Width="32" Height="32"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Margin="6,0,0,0" ToolTip.Tip="设备连接配置">
          <Path Data="{x:Static vm:NavIcons.Settings}" Stretch="Uniform" Width="15" Height="15"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <TextBlock Grid.Column="2" Text="{Binding TokenInfo}" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- 历史会话（Flyout 下拉） -->
          <Button x:Name="HistoryFlyoutButton" Classes="ghost" Padding="8,4" FontSize="12" ToolTip.Tip="历史会话">
            <Path Data="{x:Static shell:Codicons.Menu}" Stretch="Uniform" Width="14" Height="14"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Border Width="280" MaxHeight="400">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="历史会话" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Conversations}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Classes="settings-nav" HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding ResumeCommand}"
                                    CommandParameter="{Binding}"
                                    Click="OnConversationClicked">
                              <Button.ContextFlyout>
                                <MenuFlyout>
                                  <MenuItem Header="删除"
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{Binding}"/>
                                </MenuFlyout>
                              </Button.ContextFlyout>
                              <StackPanel Spacing="2" HorizontalAlignment="Left">
                                <DockPanel>
                                  <TextBlock Text="{Binding DisplayTime}" DockPanel.Dock="Right"
                                             FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center" Margin="6,0,0,0"/>
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Preview}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- 新聊天 -->
          <Button Command="{Binding NewChatCommand}" Classes="ghost" Padding="8,4" FontSize="12" ToolTip.Tip="新聊天">
            <Path Data="{x:Static shell:Codicons.Add}" Stretch="Uniform" Width="14" Height="14"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 正文：两态叠放（Panel 覆盖），按 HasConversations（有无任何对话记录）切显隐。 -->
    <Panel Grid.Row="1">
      <!-- 非空态：有历史记录 → 消息流 + 底部输入（现有布局，原样保留）。 -->
      <DockPanel IsVisible="{Binding HasConversations}">
        <!-- 居中 ChatGPT 式输入区：底部全宽条，内含居中 768 输入列（plan-accept / 活动计划 / chips / TextBox+发送 / 免责）。 -->
        <Border DockPanel.Dock="Bottom" Padding="16,10,16,8" Background="{DynamicResource ContentBgBrush}">
          <shell:ChatInputView/>
        </Border>
        <!-- 消息区委托给共享控件（与右栏紧凑视图共用模板/滚动/贴底/历史加载）。 -->
        <shell:ChatMessagesView/>
      </DockPanel>

      <!-- 空态：无任何对话记录 → 居中 hero（问候 + 输入），WorkBuddy 式。首次发送落库后 HasConversations 翻 true，自动落回非空态。 -->
      <StackPanel IsVisible="{Binding !HasConversations}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  MaxWidth="768" Width="768" Spacing="24">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="👋" FontSize="40" HorizontalAlignment="Center"/>
          <TextBlock Text="开始对话" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="选择专家或直接输入，AI 助手随时待命" FontSize="13" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <shell:ChatInputView/>
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
