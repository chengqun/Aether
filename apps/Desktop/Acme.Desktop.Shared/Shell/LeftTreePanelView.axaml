<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Acme.Desktop.Shared.Shell"
             x:Class="Acme.Desktop.Shared.Shell.LeftTreePanelView"
             Background="Transparent">

  <!-- shell 级左栏切换层：叠放文件树 + 笔记树 + SCM 面板，按当前 tab 切显隐（WorkspaceView.SetActiveTree 驱动）。
       DataContext = MainViewModelBase（经 ViewRegistry vmFactory）；子 view 各自绑 Documents/Notes/SourceControl 共享 VM 单例。
       SCM 面板提升至此（col0 独占全高）→ 终端只在 diff 区下方，与文档/笔记页「左栏独占全高」布局一致。 -->
  <Grid>
    <shell:FileTreeView x:Name="FileTreePanel" DataContext="{Binding Documents}" IsVisible="True"/>
    <shell:NotesTreeView x:Name="NotesTreePanel" DataContext="{Binding Notes}" IsVisible="False"/>
    <shell:SourceControlPanelView x:Name="ScmTreePanel" DataContext="{Binding SourceControl}" IsVisible="False"/>
    <shell:KoTreeView x:Name="KoTreePanel" DataContext="{Binding Knowledge}" IsVisible="False"/>
  </Grid>
</UserControl>
