<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Acme.Desktop.Shared.Shell"
        xmlns:nav="using:Acme.Shell"
        x:Class="Acme.Desktop.Shared.Shell.MainWindow"
        Title="Aether 桌面"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="420" MinWidth="300" MaxWidth="800"/>
    </Grid.ColumnDefinitions>

    <!-- ═══ 展开态侧边栏（200px） ═══ -->
    <Border Grid.Column="0" Width="200" IsVisible="{Binding IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Classes="account-chip" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="{Binding UserName}" IsEnabled="False"/>
              <MenuItem Header="设置" Command="{Binding ShowSettingsCommand}"/>
              <MenuItem Header="运行 Trace" Click="OnOpenTrace"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Orientation="Vertical" Spacing="2">
              <TextBlock Text="{Binding UserName}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Tenant}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Button>

        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding ToggleSidebarCommand}" Classes="settings-nav"
                    ToolTip.Tip="收起侧边栏" HorizontalAlignment="Right">
              <Path Data="{x:Static nav:NavIcons.Menu}" Stretch="Uniform" Width="18" Height="18"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="settings-nav" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="18" Height="18"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 最近会话已移至聊天区头部 -->
        <Border/>
      </DockPanel>
    </Border>

    <!-- ═══ 收起态侧边栏（48px） ═══ -->
    <Border Grid.Column="0" Width="48" IsVisible="{Binding !IsSidebarExpanded}"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
          <Button Command="{Binding ToggleSidebarCommand}" Classes="nav-rail" ToolTip.Tip="展开侧边栏">
            <Path Data="{x:Static nav:NavIcons.Menu}" Stretch="Uniform" Width="18" Height="18"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="nav-rail" Command="{Binding Command}" CommandParameter="{Binding Key}"
                        ToolTip.Tip="{Binding Title}">
                  <Path Data="{Binding Icon}" Stretch="Uniform" Width="18" Height="18"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Button Grid.Row="2" Classes="account-rail" ToolTip.Tip="{Binding UserName}">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="{Binding UserName}" IsEnabled="False"/>
              <MenuItem Header="设置" Command="{Binding ShowSettingsCommand}"/>
              <MenuItem Header="运行 Trace" Click="OnOpenTrace"/>
              <MenuItem Header="登录…" Command="{Binding LoginCommand}" IsVisible="{Binding !IsLoggedIn}"/>
              <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"/>
            </MenuFlyout>
          </Button.Flyout>
          <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ 中间内容区（功能页，不含聊天） ═══ -->
    <Grid Grid.Column="1" Background="{DynamicResource ContentBgBrush}">
      <shell:NotesView x:Name="NotesViewInstance" DataContext="{Binding Notes}"
          IsVisible="{Binding DataContext.IsNotesPage, RelativeSource={RelativeSource AncestorType=Window}}" />
      <shell:ExpertsView x:Name="ExpertsViewInstance" DataContext="{Binding Experts}"
          IsVisible="{Binding DataContext.IsExpertsPage, RelativeSource={RelativeSource AncestorType=Window}}" />
      <shell:AutomationView x:Name="AutomationViewInstance" DataContext="{Binding Automation}"
          IsVisible="{Binding DataContext.IsAutomationPage, RelativeSource={RelativeSource AncestorType=Window}}" />
      <ContentControl Content="{Binding Futures}"
          IsVisible="{Binding IsFuturesPage}" />
      <ContentControl Content="{Binding Trading}"
          IsVisible="{Binding IsTradingPage}" />
    </Grid>

    <!-- ═══ 分隔条（拖动调整聊天宽度） ═══ -->
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="4" Background="{DynamicResource BorderBrush}"
                  HorizontalAlignment="Right" Margin="0,0,-2,0"/>

    <!-- ═══ 聊天区（右侧外挂，可收起，可拖宽） ═══ -->
    <Grid Grid.Column="2" Background="{DynamicResource ContentBgBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource BorderBrush}"/>

      <!-- 聊天面板 -->
      <DockPanel Grid.Column="1">
        <!-- 聊天头部：历史 + 新聊天 + 收起 -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <!-- 历史会话（Flyout 下拉） -->
            <Button x:Name="HistoryFlyoutButton" Classes="ghost" Padding="8,4" FontSize="12" ToolTip.Tip="历史会话">
              <TextBlock Text="≡" FontSize="14"/>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <Border Width="280" MaxHeight="400">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" Text="历史会话" FontSize="12" FontWeight="SemiBold"
                                 Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="settings-nav" HorizontalAlignment="Stretch" Margin="0,2"
                                      Command="{Binding ResumeCommand}"
                                      CommandParameter="{Binding}"
                                      Click="OnConversationClicked">
                                <Button.ContextFlyout>
                                  <MenuFlyout>
                                    <MenuItem Header="删除"
                                              Command="{Binding DeleteCommand}"
                                              CommandParameter="{Binding}"/>
                                  </MenuFlyout>
                                </Button.ContextFlyout>
                                <StackPanel Spacing="2" HorizontalAlignment="Left">
                                  <DockPanel>
                                    <TextBlock Text="{Binding DisplayTime}" DockPanel.Dock="Right"
                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                  </DockPanel>
                                  <TextBlock Text="{Binding Preview}" FontSize="11"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- 新聊天 -->
            <Button Command="{Binding NewChatCommand}" Classes="ghost" Padding="8,4" FontSize="12" ToolTip.Tip="新聊天">
              <TextBlock Text="✚" FontSize="14"/>
            </Button>
          </StackPanel>
        </Border>
        <shell:ChatView DataContext="{Binding}"/>
      </DockPanel>
    </Grid>

  </Grid>
</Window>
